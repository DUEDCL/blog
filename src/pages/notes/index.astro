---
import ListLayout from '../../layouts/ListLayout.astro';
import { getPublished } from '../../utils/content';
import { SECTIONS } from '../../consts';

const items = await getPublished('notes');
---

<ListLayout
  title={SECTIONS.notes.title}
  description={SECTIONS.notes.description}
  note={SECTIONS.notes.note}
  empty={SECTIONS.notes.empty}
  base="/notes"
  items={items}
/>
