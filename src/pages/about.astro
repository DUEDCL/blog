---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE_TITLE, SOCIAL, CONTACT } from '../consts';

/* 邮箱在名片里已经有一张卡（可点可复制），这里滤掉，同一页不出现两次。
   页脚与首页那排小链接不受影响 —— 那两处没有名片。 */
const links = [
  { label: 'GitHub', href: SOCIAL.github },
  { label: 'X', href: SOCIAL.x },
  { label: '微博', href: SOCIAL.weibo },
  { label: '知乎', href: SOCIAL.zhihu },
  { label: 'RSS', href: SOCIAL.rss },
].filter((l) => l.href);

type Card = {
  key: string;
  label: string;
  /** 真能点的链接。只有 QQ、Telegram、邮箱有；微信、抖音、Discord 技术上没有 */
  action?: {
    href: string;
    text: string;
    /**
     * 这条 `href` 是**唤起本机 APP 的自定义协议**（`tencent://`、`mqqapi://`），不是网页。
     * 填了这一项会做两件事（R41④）：
     * 1. 不加 `target="_blank"` —— 自定义协议开新标签会留下一张永远空白的页；
     * 2. 手机上把 href 换成这里的值（桌面 QQ 与手机 QQ 的协议名不一样）。
     */
    app?: string;
  };
  /** 二维码图。有图就可点开放大（R26），灯箱里带一键复制 */
  qr?: string;
  /**
   * 这张码要不要纸底。**抖音那张要，而且是唯一一张** —— 沉麟真机实测：微信与 Telegram 的
   * 反相码（亮模块压暗玻璃）扫得出，抖音那张**必须加白底才扫得出**。它不是 QR 而是抖音
   * 自家的圆形码，解码器是私有的，没有 QR 那套「读不出就试一次反转」的惯例。
   * 所以这一项是**定死的**，不是可切换的默认值 —— 缩略图与放大后都加底，
   * 免得点开前后长得不一样。
   */
  paper?: boolean;
  /** 一键复制的值 + 按钮文案。按钮文案各卡不同：号码/用户名/抖音号不是一回事 */
  copy?: { value: string; text: string };
  note: string;
};

/**
 * 名片。每个平台能做到的事差得很远，所以每张卡的按钮都不一样 ——
 * 详见 consts.ts 里 CONTACT 的注释（六条能力核实结论都写在那儿）。
 * 填了才出现：CONTACT 全空时整节替换成一句实话。
 *
 * 排序按「访客最可能用哪个」：微信、QQ 在前（国内），Telegram、Discord 在后（境外），
 * 邮箱压轴 —— 它最慢，但不依赖任何 APP，是永远兜底的那条。
 */
const cards = [
  CONTACT.wechatQr && {
    key: 'wechat',
    label: '微信',
    qr: CONTACT.wechatQr,
    /* 给的是昵称不是微信号，所以按钮写「复制昵称」，文案里也说清搜昵称不一定搜得到 */
    copy: CONTACT.wechat ? { value: CONTACT.wechat, text: '复制昵称' } : undefined,
    note: '微信没有加好友链接，扫码是唯一稳的办法。点二维码放大，手机扫屏幕上这张就行。',
  },
  CONTACT.qq && {
    key: 'qq',
    label: 'QQ',
    /**
     * R41④：原来这里是 `wpa.qq.com/msgrd?v=3&uin=…`（网页版临时会话）。
     * **腾讯已经把它关了** —— 沉麟点开看到的是那条链接 302 到
     * `admin.qidian.qq.com/.../wpa-link` 之后的一句「抱歉，无法发起临时会话，
     * 您可以先添加对方为好友，再发送消息」。那不是链接拼错：网页发起临时会话现在要么
     * 目标方在 QQ 设置里开了「允许任何人临时会话」并加入 QQ 推广（shang.qq.com），
     * 要么走企点（付费的企业客服）。两样都不是他的情况，所以这条路整条不通。
     *
     * 换成**唤起本机 QQ 的加好友入口**，桌面与手机两条协议（都来自多个社区来源、互相一致，
     * 非腾讯官方文档 —— 这个能力从来没有官方文档）：
     * - 桌面：`tencent://AddContact/?fromId=45&fromSubId=1&subcmd=all&uin=…` → 加好友窗口；
     * - 手机：`mqqapi://card/show_pslcard?src_type=internal&version=1&uin=…` → 对方名片页，
     *   从那儿点「加好友」。
     *
     * **它们不保证有反应**：装了 QQ 才会被唤起，新版浏览器还会先弹一次「要打开 QQ 吗」，
     * 部分内核直接拦掉非 http 协议。所以按钮文案是「在 QQ 里打开」而不是「加好友」——
     * 不许下做不到的承诺；真正稳的那条是旁边的「复制号码」。
     */
    action: {
      href: `tencent://AddContact/?fromId=45&fromSubId=1&subcmd=all&uin=${CONTACT.qq}`,
      app: `mqqapi://card/show_pslcard?src_type=internal&version=1&uin=${CONTACT.qq}`,
      text: '在 QQ 里打开',
    },
    qr: CONTACT.qqQr || undefined,
    copy: { value: CONTACT.qq, text: '复制号码' },
    note: '腾讯已经不让网页发起临时会话了，只能加好友。复制号码去 QQ 里搜最稳；装了 QQ 的话上一颗键能直接跳过去。',
  },
  CONTACT.douyinQr && {
    key: 'douyin',
    label: '抖音',
    /* 主页链接他没给，所以不出「打开主页」按钮 —— 只有码和抖音号 */
    action: CONTACT.douyin ? { href: CONTACT.douyin, text: '打开主页' } : undefined,
    qr: CONTACT.douyinQr,
    paper: true, // 实测必须加白底才扫得出，圆形码不吃反相（见 Card.paper）
    copy: CONTACT.douyinId
      ? { value: CONTACT.douyinId, text: '复制抖音号' }
      : undefined,
    note: '抖音没有加好友链接：点开二维码用 APP 扫，或复制抖音号去搜。',
  },
  CONTACT.telegram && {
    key: 'telegram',
    label: 'Telegram',
    action: { href: `https://t.me/${CONTACT.telegram}`, text: '打开对话' },
    qr: CONTACT.telegramQr || undefined,
    copy: { value: `@${CONTACT.telegram}`, text: '复制用户名' },
    note: '点开就是对话框，不用先加好友。也可以扫码或复制用户名去搜。',
  },
  CONTACT.discord && {
    key: 'discord',
    label: 'Discord',
    /* discord.com/users/<id> 要纯数字 ID，用户名拼不出链接，所以这张卡只能复制 */
    copy: { value: CONTACT.discord, text: '复制用户名' },
    note: '只能在客户端里搜用户名添加，没有可点的链接。',
  },
  CONTACT.email && {
    key: 'email',
    label: '邮箱',
    action: { href: `mailto:${CONTACT.email}`, text: '写邮件' },
    copy: { value: CONTACT.email, text: '复制地址' },
    note: '最慢也最稳的一条，不依赖任何 APP，我都会看。',
  },
].filter(Boolean) as Card[];
---

<BaseLayout title="名片" description={`联系 ${SITE_TITLE}`} width="prose">
  {/* R29：这一页原先是「关于」—— 一张页头卡 + 一句「还没想好怎么介绍自己」+ 一段
      「这个站怎么搭的」。站主圈掉了那三样（原话「将图示圈起来的地方全部删掉，添加『名片』栏」），
      于是这一页只剩名片与「别处」，页面本身就是名片：名片那一节因此从 h2 升成 h1
      （一页只能有一个 h1，而页头卡已经没了），顶栏也多了一项「名片」指到这儿。 */}
  <div class="prose glass rise rise-1">
    <h1 class="title">名片</h1>
    {cards.length > 0 ? (
      <ul class="cards">
        {cards.map((c) => (
          <li class="card">
            <span class="card__label">{c.label}</span>

            {c.qr && (
              /* 缩略图是按钮不是图：点开才是原图（键盘也能进，Enter/Space 都算点击）。
                 灯箱要的四样东西全挂在 data-* 上，脚本不必知道有哪些平台 */
              <button
                class="card__qrbtn"
                type="button"
                data-lb-src={c.qr}
                data-lb-label={c.label}
                data-lb-copy={c.copy?.value ?? ''}
                data-lb-copy-text={c.copy?.text ?? ''}
                data-lb-paper={c.paper ? '1' : ''}
                aria-label={`放大${c.label}二维码`}
              >
                <span class={c.paper ? 'card__qrbox card__qrbox--paper' : 'card__qrbox'}>
                  <span
                    class="card__qr"
                    role="img"
                    aria-label={`${c.label}二维码`}
                    style={`--qr: url('${c.qr}')`}
                  />
                </span>
                <span class="card__zoom" aria-hidden="true">点开放大</span>
              </button>
            )}

            <span class="card__acts">
              {c.action && (
                /* 自定义协议（`app` 填了的那张，眼下只有 QQ）不开新标签：
                   浏览器会先开一张空白页再去唤起 APP，唤不起就留下那张空白页。
                   手机上的协议名不一样，由下面那段脚本按 UA 换掉。 */
                <a
                  class="card__btn"
                  href={c.action.href}
                  data-app-mobile={c.action.app}
                  target={c.action.app ? undefined : '_blank'}
                  rel="noopener"
                >
                  {c.action.text}
                </a>
              )}
              {c.copy && (
                <button class="card__btn" type="button" data-copy={c.copy.value}>
                  {c.copy.text}
                </button>
              )}
            </span>

            <span class="card__note">{c.note}</span>
          </li>
        ))}
      </ul>
    ) : (
      <p>联系方式还没整理好。</p>
    )}

    {links.length > 0 && (
      <>
        <h2>别处</h2>
        <ul>
          {links.map((l) => (
            <li>
              <a
                href={l.href}
                target={l.href.startsWith('http') ? '_blank' : undefined}
                rel={l.href.startsWith('http') ? 'me noopener' : undefined}
              >
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      </>
    )}
  </div>

  {/* 灯箱。一张卡一个弹层太浪费，全页共用这一个，内容点击时现填。
      用原生 <dialog>：Esc 关闭、焦点圈住、置顶层（top layer）三件事浏览器自己做，
      不必跟 Header(z-index 50)、播放器(60)、BaseLayout(100) 抢层级。 */}
  {cards.some((c) => c.qr) && (
    <dialog class="lb" id="qr-lightbox" aria-labelledby="qr-lightbox-label">
      <figure class="lb__figure">
        <span class="lb__stage"><span class="lb__code" role="img" aria-label=""></span></span>
        <figcaption class="lb__cap">
          <span class="lb__label" id="qr-lightbox-label"></span>
          <span class="lb__acts">
            {/* data-copy 空着也要留住这个属性：复制那段脚本按 [data-copy] 选元素，
                值是点击时才读的，灯箱打开时现填 */}
            <button class="card__btn lb__copy" type="button" data-copy=""></button>
            <button class="card__btn" type="button" data-lb-close>关闭</button>
          </span>
        </figcaption>
      </figure>
    </dialog>
  )}
</BaseLayout>

{/* 复制值 + 二维码灯箱。navigator.clipboard 在非 HTTPS 下不可用，失败就把值显示出来让用户自己选 */}
<script>
  /* 绑事件要挂在 `astro:page-load` 上：这段是 bundled module，
     **同一个 URL 的模块体一辈子只执行一次** —— 离开 /about 再回来，
     新文档里的按钮就没人绑了。而这个事件每次导航都触发（首屏那次也触发，
     所以不必额外自调一遍，自调就是绑两遍）。

     只往按钮上绑，不往 window/document 上绑，所以每导航一次不会累积。 */
  document.addEventListener('astro:page-load', () => {
    /* --- 手机上换成手机 QQ 的协议（R41④）---------------------------------
       桌面 QQ 认 `tencent://`，手机 QQ 认 `mqqapi://`，两者互不相认 ——
       填错平台的那一条就是「点了没反应」。HTML 里默认写桌面那条（静态页没有 UA），
       在这儿按 UA 换掉。判据只用「是不是移动端」，不去区分 iOS/Android：
       两家的手机 QQ 用的是同一个协议名。 */
    if (/Android|iPhone|iPad|iPod|HarmonyOS|Mobile/i.test(navigator.userAgent)) {
      document.querySelectorAll<HTMLAnchorElement>('[data-app-mobile]').forEach((a) => {
        const mobile = a.dataset.appMobile;
        if (mobile) a.href = mobile;
      });
    }

    /* 「已复制」的回退计时器。按元素存，连点两次不会把「已复制」当原文案存回去 */
    const timers = new WeakMap<HTMLElement, number>();

    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      /* 各卡按钮文案不同（复制号码／用户名／抖音号／昵称／地址），恢复时不能写死一个词，
         所以把原文案存进 data-label；灯箱那颗是动态填的，填的时候会一起更新这个值 */
      if (!btn.dataset.label) btn.dataset.label = btn.textContent?.trim() ?? '';

      btn.addEventListener('click', async () => {
        const value = btn.dataset.copy ?? '';
        if (!value) return;

        const show = (text: string) => {
          const pending = timers.get(btn);
          if (pending) clearTimeout(pending);
          btn.textContent = text;
          timers.set(
            btn,
            window.setTimeout(() => {
              btn.textContent = btn.dataset.label ?? '';
            }, 1600),
          );
        };

        try {
          await navigator.clipboard.writeText(value);
          show('已复制');
        } catch {
          show(value);
        }
      });
    });

    /* --- 灯箱：缩略图点开看原图，顺手把用户名一键复制掉 ------------------- */
    const lb = document.querySelector<HTMLDialogElement>('#qr-lightbox');
    const lbCode = lb?.querySelector<HTMLElement>('.lb__code');
    const lbStage = lb?.querySelector<HTMLElement>('.lb__stage');
    const lbLabel = lb?.querySelector<HTMLElement>('.lb__label');
    const lbCopy = lb?.querySelector<HTMLButtonElement>('.lb__copy');
    if (!lb || !lbCode || !lbStage || !lbLabel || !lbCopy) return;

    document.querySelectorAll<HTMLButtonElement>('[data-lb-src]').forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const d = thumb.dataset;
        /* 码是遮罩不是图：颜色由 CSS 的 --ink 给，这里只换遮罩路径。
           与缩略图同一个文件，已在缓存里，不会再下一次 */
        lbCode.style.setProperty('--qr', `url('${d.lbSrc ?? ''}')`);
        lbCode.setAttribute('aria-label', `${d.lbLabel ?? ''}二维码`);
        lbLabel.textContent = d.lbLabel ?? '';

        /* 纸底跟着卡走，不给切换：抖音那张 data-lb-paper=1（实测非白底扫不出），
           其余的透明底扫得出。缩略图那边已经是同一副样子，点开前后不变脸 */
        lbStage.classList.toggle('lb__stage--paper', d.lbPaper === '1');

        /* 这个平台没给可复制的用户名就把按钮藏掉，不留一颗按了没反应的键 */
        const value = d.lbCopy ?? '';
        lbCopy.hidden = !value;
        lbCopy.dataset.copy = value;
        lbCopy.dataset.label = d.lbCopyText || '复制';

        /* 上一张卡的「已复制」不能在这张卡上继续倒计时 */
        const pending = timers.get(lbCopy);
        if (pending) clearTimeout(pending);
        lbCopy.textContent = lbCopy.dataset.label;

        lb.showModal();
      });
    });

    lb.querySelectorAll<HTMLButtonElement>('[data-lb-close]').forEach((btn) => {
      btn.addEventListener('click', () => lb.close());
    });

    /* 点图外的空白处关闭。::backdrop 不是子元素，点它命中的 target 就是 dialog 自己 */
    lb.addEventListener('click', (e) => {
      if (e.target === lb) lb.close();
    });
  });
</script>

<style>
  .prose {
    padding: var(--sp-8);
    border-radius: var(--r-xl);
  }

  /* 页头卡删掉之后，这一页的标题就是名片那一行（h1）。字号仍按页头那一档给 ——
     它现在是整页唯一的标题，压成 h2 的大小会显得这一页没有头 */
  .title {
    margin-top: 0;
    font-size: var(--text-3xl);
    font-variation-settings: 'opsz' 40, 'SOFT' 0, 'WONK' 0;
    letter-spacing: -0.02em;
  }

  /* 玻璃面板里首个标题不需要额外顶部间距 */
  .prose :global(> *:first-child) {
    margin-top: 0;
  }

  /* --- 名片 --------------------------------------------------------------- */
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: var(--sp-4);
    margin: var(--sp-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-5);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--r-lg);
  }

  .card__label {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--ink);
  }

  /* 二维码缩略图是一颗按钮：点开才是原图。
     R26 第四版：**真透明底**。需求原话「并没有改成透明打底的二维码，依旧是白色打底，
     我想要的是透明打底的二维码，且不影响扫描」—— 第三版那块香槟玻璃仍然是「一块亮面」，
     不是他要的东西。

     现在码是一张「墨模块 + 透明底」的 webp，靠 `filter: invert(1)` 翻成亮模块（R32 从
     CSS mask 换成 filter，理由见下面那条规则）。于是模块之间是真透明（卡片玻璃与背后的
     光晕直接透出来），模块本身是纯白。
     **R31 之后浅色主题没了，所以这里恒定是「亮模块 / 暗底」的反相码** —— 下面那张实测表的
     浅色两行从此只是历史记录，真正生效的是「深色·反相」那两行，而「不试反转的扫码器
     一个尺寸都读不出」这条风险因此变成常态，灯箱里那颗「加白底」的退路更要留着。

     代价必须写清楚：深色主题下这是**反相码**（亮模块／暗底），解码器要自己试一次反转。
     实测（jsQR，把遮罩涂成 --ink 再合成到卡片玻璃的实测底色上，四个尺寸）：

       浅色·正相                  1024 ✓  288 ✓  254 ✓  200 ✓
       深色·反相                  1024 ✓  288 ✓  254 ✓  200 ✓
       深色·反相（禁止试反转）      1024 ✗  288 ✗  254 ✗  200 ✗

     最后一行就是风险本身：不试反转的扫码器一个尺寸都读不出。jsQR 默认试
     （`inversionAttempts: 'attemptBoth'`），iOS 相机与 Google Lens 实践中也读得出，
     **微信自家扫码器能不能试，本机核实不了**（社区来源互相矛盾：2015 年说不行、
     2020 年说行，都不是官方文档）。所以灯箱里留了「加白底」一颗键当退路。

     亮度反差不是问题：深色 --ink(#d7d6d5) 压卡片玻璃(≈#121212) 13:1，
     浅色 #131110 压 ≈#f0eeec 17:1，两头都远超扫码需要的量。 */
  .card__qrbtn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-2);
    width: 8.75rem;
    padding: 0;
    background: none;
    border: 0;
    cursor: zoom-in;
  }

  /* 码 = 遮罩 + 一个颜色。缩略图与灯箱共用这一份。
     纸底那张（抖音）不翻转，它要的就是「墨模块 + 白底」。 */
  /* 纸底：只有抖音那张有（实测非白底扫不出，见 Card.paper）。
     一处配方管两处，缩略图与放大后只差内衬和圆角。 */
  .card__qrbox {
