---
import ListLayout from '../../layouts/ListLayout.astro';
import { getPublished, getTagCounts } from '../../utils/content';
import { SECTIONS } from '../../consts';

const items = await getPublished('posts');
const tags = await getTagCounts('posts');
---

<ListLayout
  title={SECTIONS.posts.title}
  description={SECTIONS.posts.description}
  empty={SECTIONS.posts.empty}
  base="/posts"
  items={items}
  tags={tags}
  verticalLabel="技术文章"
/>
