---
/**
 * 唱片机 —— 一台能真的转起来的播放器。
 *
 * 三条硬约束，改的时候别破：
 * ① **不自动播放**。浏览器会拦，拦了以后播放按钮的状态还得靠事件回填，
 *    与其跟策略打架不如从设计上就要求先点一下。移动端流量也不该被偷走。
 * ② **没 JS 也能听**。整页交互层用 `:root[data-js]` 开关，脚本没跑起来
 *    就露出下面的 <audio controls> 原生播放器 + 纯文本随片文字。
 *    开关用 CSS 而不是 JS 删节点：不会闪一下再消失。
 * ③ **歌词与队列各是一个原生滚动容器，自动跟随只写 `scrollTop`**。
 *    R14 之前这里是「窗口 overflow:hidden + 给整张歌词表写 transform」，改掉是因为
 *    那套**没法用手滑** —— 用户的滚动手势没有能落到的滚动容器。换成原生滚动之后
 *    位置只有一个事实来源（容器的 scrollTop），手滑与自动跟随不会互相打架；
 *    scrollTop 和 transform 一样不触发重排，而且只在换行那一帧写一次。
 *    仍然不许碰的是 margin/height 那类会引起重排的属性 —— 每帧都改能把 8 行字卡出锯齿。
 *    手滑之后有 `HOLD_MS` 的静默期不抢位置，否则下一次换行就把人拽回去了；
 *    静默期一结束就主动弹回当前行，不等下一次换行 —— 慢歌一行能唱七八秒，
 *    干等换行会让人以为自动跟随坏了。点某一行歌词就从那儿播（事件委托在窗上）。
 *
 * ④ **状态不在这一页**。队列、当前曲、歌词、播放方式与那一个 `<audio>` 都在
 *    scripts/jukebox.ts 的单例（以及 MiniPlayer）里，这一页只是它的一个视图 ——
 *    R14 要「走到别的页面音乐不停」，状态留在页面里就做不到。
 *
 * 唱片纹路是纯 CSS：repeating-radial-gradient 画沟槽，conic-gradient 画反光。
 * 反光那层**不能跟着盘一起转** —— 真唱片转起来时高光是钉在光源方向不动的，
 * 一起转就变成风车了。所以沟槽在 .vinyl__disc（转），反光在 .vinyl__sheen（不转）。
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { TRACKS, parseLrc, formatTime } from '../data/music';
import { CHARTS, SEARCH_MAX_Q } from '../data/jukebox';

/**
 * 构建期只渲染「第一首 + 原始队列」的静态形态，意义只有一个：从首屏（以及 SPA 落地）
 * 到脚本接线之间的那几帧不是一片空白。真正显示什么由视图接线时按单例的状态整块回填
 * —— 那时队列可能已被点歌加长、当前曲可能是第 5 首。
 *
 * 曾经内联给客户端的那份曲目表 JSON 没了：单例自己 import data/music.ts，
 * 页面再送一份是重复的。词表也不再逐首渲染进 DOM —— 歌词属于「当前曲」，
 * 而当前曲要等接线才知道；那些行只留给下面的无 JS 降级用。
 */
const first = TRACKS[0];
---

<BaseLayout
  title="唱片机"
  description="在听什么 —— 一台自己写的播放器，随片文字跟着走。"
  footerNote="听一点音乐吧，让时间慢下来。"
>
  {/* 这一页没有页头卡 —— 唱盘台自己就是标题，再压一张「在听什么／唱片机」的卡
      只是把转盘往下推。那句「听一点音乐吧」搬去了页脚（footerNote）。
      但 h1 不能跟着没：一页无 h1 会让读屏器与大纲失去落点，所以留一个视觉隐藏的 */}
  <h1 class="visually-hidden">唱片机</h1>

  {/* ---------- 有 JS：整台唱片机 ---------- */}
  <div class="deck-only">
    <section class="jk-deck glass rise rise-1" data-deck aria-label="播放器">
      <div class="jk-vinyl" data-vinyl>
        <div class="jk-vinyl__disc">
          {/* 唱片中心那个圆标签。里面两层，同一时刻只露一层（R22①）：
              有封面就是专辑图铺满整个圆，没有（或图挂了）就退回原来这行烫金文字。
              `has-cover` 与 img 的 src/hidden 都由脚本的 paintCover() 写，
              但**构建期就按第一首预填**：不预填的话每次进这一页都会先闪一下文字标签，
              而且图要等脚本跑完才开始下载。 */}
          <div class:list={['jk-vinyl__label', { 'has-cover': !!first.cover }]}>
            <span class="jk-vinyl__label-t" data-label>{first.title}</span>
            <img
              class="jk-vinyl__cover"
              data-cover
              src={first.cover || undefined}
              alt=""
              hidden={!first.cover}
            />
          </div>
        </div>
        <div class="jk-vinyl__hole" aria-hidden="true"></div>
        <div class="jk-vinyl__sheen" aria-hidden="true"></div>
        <div class="jk-vinyl__arm" aria-hidden="true"></div>
      </div>

      <div class="jk-ctl">
        <p class="jk-ctl__now">
          <span class="jk-ctl__t" data-title>{first.title}</span>
          <span class="jk-ctl__s" data-sub>{first.subtitle}</span>
        </p>

        <div class="jk-ctl__keys">
          <button class="jk-key" type="button" data-prev aria-label="上一首">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M7 6h2.1v12H7zM19 6.6v10.8L10.6 12z"></path></svg
            >
          </button>

          <button
            class="jk-key jk-key--play"
            type="button"
            data-play
            aria-label="播放"
            aria-pressed="false"
          >
            <svg class="jk-key__i jk-key__i--play" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M8.4 5.4v13.2L19 12z"></path></svg
            >
            <svg class="jk-key__i jk-key__i--pause" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M8 5.6h3v12.8H8zM13 5.6h3v12.8h-3z"></path></svg
            >
          </button>

          <button class="jk-key" type="button" data-next aria-label="下一首">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M14.9 6h2.1v12h-2.1zM5 6.6v10.8L13.4 12z"></path></svg
            >
          </button>

          {/* 播放方式。四个图标叠在这一个键里，露哪个由脚本写的 data-m 决定 ——
              和上面播放/暂停那对是同一套做法。data-m 与 aria-label 都由 paintMode() 写，
              这里不预设：脚本要先从 localStorage 读回上次那档 */}
          <button class="jk-key jk-key--mode" type="button" data-mode>
            {/* 顺序：撞上一道墙就停 */}
            <svg class="jk-key__i jk-key__i--m0" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M3.5 11h9.6v2H3.5zM12.4 7.4L17.2 12l-4.8 4.6zM18.6 5.8h2v12.4h-2z"
              ></path></svg
            >
            {/* 列表循环：上下两条回路 */}
            <svg class="jk-key__i jk-key__i--m1" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M7.6 7.2H16V9l3.6-2.8L16 3.4v1.8H5.6v6.4h2z"></path><path
                d="M16.4 16.8H8V15l-3.6 2.8L8 20.6v-1.8h10.4v-6.4h-2z"
              ></path></svg
            >
            {/* 单曲循环：同上，中间加个 1 */}
            <svg class="jk-key__i jk-key__i--m2" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M7.6 7.2H16V9l3.6-2.8L16 3.4v1.8H5.6v6.4h2z"></path><path
                d="M16.4 16.8H8V15l-3.6 2.8L8 20.6v-1.8h10.4v-6.4h-2z"></path><path
                d="M11 10.6l2.2-1.2v5.2h-1.6v-3.2z"
              ></path></svg
            >
            {/* 随机：两条交叉的线各带一个箭头 */}
            <svg class="jk-key__i jk-key__i--m3" viewBox="0 0 24 24" aria-hidden="true"
              ><path d="M3.84 7.25L5.16 5.75l12.5 11-1.32 1.5z"></path><path
                d="M3.84 16.75l1.32 1.5 12.5-11-1.32-1.5z"></path><path
                d="M14.8 4.4h4.8v4.8z"></path><path d="M14.8 19.6h4.8v-4.8z"></path></svg
            >
          </button>
        </div>

        <div class="jk-ctl__seek">
          <span class="jk-ctl__time meta" data-cur>0:00</span>
          <input
            class="jk-rng"
            type="range"
            data-seek
            min="0"
            max={first.duration}
            step="0.05"
            value="0"
            aria-label="播放进度"
          />
          <span class="jk-ctl__time meta" data-dur>{formatTime(first.duration)}</span>
        </div>

        <div class="jk-ctl__vol">
          <span class="meta">音量</span>
          <input
            class="jk-rng jk-rng--vol"
            type="range"
            data-vol
            min="0"
            max="1"
            step="0.01"
            value="0.8"
            aria-label="音量"
          />
        </div>
      </div>

      {/* 这里曾经有一个 `<audio data-au>`。R14 阶段⑤ 把它挪进了 MiniPlayer ——
          全站唯一那一份，挂在被 transition:persist 保住的子树上。留在这一页里，
          换页时节点被丢弃，声音必断，而这一轮的需求正是「不能断」 */}
    </section>

    <div class="jk-cols">
      <section class="jk-lyr glass rise rise-2" aria-label="随片文字">
        {/* 一张空词表，行由视图按**当前曲**铺（歌词在单例的状态里，不在这儿）。
            以前是每首一张 <ol> 全渲染进 DOM、靠 hidden 切 —— 队列能被点歌加长到
            任意长度，那个做法从点歌台上线起就已经只能覆盖本地那几首了 */}
        <div class="jk-lyr__win" data-win>
          <ol class="jk-lines" data-lines></ol>
        </div>
      </section>

      <section class="jk-list glass rise rise-2" aria-label="曲目">
        <ol class="jk-list__ol">
          {TRACKS.map((t, i) => (
            <li>
              <button
                class:list={['jk-row', { 'is-on': i === 0 }]}
                type="button"
                data-i={i}
                aria-current={i === 0 ? 'true' : undefined}
              >
                <span class="jk-row__n meta">{String(i + 1).padStart(2, '0')}</span>
                <span class="jk-row__body">
                  <span class="jk-row__t">{t.title}</span>
                  <span class="jk-row__s">{t.subtitle}</span>
                </span>
                <span class="jk-row__d meta">{formatTime(t.duration)}</span>
              </button>
            </li>
          ))}
        </ol>
      </section>
    </div>

    {/* ---------- 点歌台。整块在 .deck-only 里，所以天生只在有 JS 时出现 ---------- */}
    <section class="jk-juke glass rise rise-2" aria-label="点歌">
      <h2 class="jk-juke__h">点歌</h2>
      <p class="jk-juke__note">
        挑个歌单，或者搜歌名、歌手。点一首就加到上面的曲目里，接着往下放；
        「全部播放」把整批都加进队列，从第一首开始。
      </p>

      {/* 不用 role="tablist"：那套要自己接方向键与 aria-selected，
          这里只是「按一下换一批结果」，aria-pressed 的按钮组更贴事实 */}
      <div class="jk-juke__charts">
        {CHARTS.map((c) => (
          <button
            class="jk-chip"
            type="button"
            data-chart={c.id}
            aria-pressed="false"
          >
            {c.name}
          </button>
        ))}
      </div>

      <form class="jk-juke__find" data-find>
        <input
          class="jk-juke__q"
          type="search"
          data-q
          name="q"
          placeholder="搜歌名或歌手"
          maxlength={SEARCH_MAX_Q}
          autocomplete="off"
          aria-label="搜索歌曲"
        />
        <button class="jk-juke__go" type="submit">搜</button>
      </form>

      {/* 状态只有一处，出错、结果条数、正在取都走这里；
          「全部播放」跟它同一行 —— 有结果时才可按，所以挨着条数最好懂 */}
      <div class="jk-juke__bar">
        <p class="jk-juke__msg meta" data-msg aria-live="polite">挑个歌单，或者搜一下。</p>
        <button
          class="jk-juke__all"
          type="button"
          data-all
          disabled
          aria-label="全部加入队列并播放"
        >
          全部播放
        </button>
      </div>

      <ol class="jk-juke__res" data-res></ol>
    </section>
  </div>

  {/* ---------- 没 JS：原生播放器 + 纯文本 ---------- */}
  <div class="bare-only">
    {TRACKS.map((t) => (
      <section class="bare glass">
        <h2 class="bare__t">{t.title}</h2>
        <p class="bare__s">{t.subtitle}</p>
        <audio controls preload="none" src={t.src}></audio>
        <ol class="bare__lines">
          {parseLrc(t.lrc).map((ln) => (
            <li>
              <span class="meta">{formatTime(ln.time)}</span>
              <span>{ln.text}</span>
            </li>
          ))}
        </ol>
      </section>
    ))}
  </div>

  {/* 曾经这里有一份内联的曲目表 JSON 给脚本 JSON.parse。单例自己 import
      data/music.ts，构建期就进 bundle，页面再送一份是纯重复的体积 */}
</BaseLayout>

<script>
  import { formatTime } from '../data/music';
  import { SEARCH_MAX_N } from '../data/jukebox';
  import {
    MODES,
    WordRun,
    add,
    addAll,
    ask,
    at,
    attach,
    coverOf,
    cycleMode,
    detach,
    dur,
    getMode,
    getVol,
    hits,
    lineAt,
    list,
    load,
    next,
    now,
    playing,
    prev,
    seekTo,
    setVol,
    time,
    toggle,
    type View,
  } from '../scripts/jukebox';

  /**
   * 这一页是 scripts/jukebox.ts 那个单例的**一个视图** —— 大屏歌词舞台。
   * 队列、当前曲、歌词、播放方式与那一个 `<audio>` 都在单例（以及 MiniPlayer）那边，
   * 所以走开一趟再回来，队列不会被刷新掉，声音一帧都不断。
   *
   * 接线为什么要在 `astro:page-load` 里重来一遍：这段是 bundled module，
   * **模块体一辈子只执行一次**，而唱盘台每次 SPA 导航都是**新节点** ——
   * 顶层绑一次的话，第二次进 /music 就是一台按什么都没反应的死唱片机。
   *
   * 顶层也照样调一次 `wire()`：`astro:page-load` 是挂在 window 的 `load` 上的，
   * 首屏那一次要等图片字体全部到位，那之前点播放键不该没反应。
   * `wire()` 按「接的是不是同一个节点」自锁，所以两处都调不会接两遍。
   */

  const HOLD_MS = 2600;

  /** 当前接着的那台唱盘台，以及挂进单例的那个视图 —— 换页时一起摘掉 */
  let host: HTMLElement | null = null;
  let live: View | null = null;
  /** 静默期结束后弹回当前行的定时器。换页要清掉，别让它去动已经被丢弃的节点 */
  let snap = 0;

  function wire() {
    const deck = document.querySelector<HTMLElement>('[data-deck]');
    if (!deck || deck === host) return;
    host = deck;

    /* 唱盘台、歌词、队列、点歌台是 .deck-only 下的四张兄弟卡片。
       非空断言在这里是安全的：这些节点就在上面那段模板里，与这段脚本同属一页 */
    const scope = deck.parentElement!;
    const pick = <T extends HTMLElement>(s: string) => scope.querySelector<T>(s)!;

    const elTitle = pick('[data-title]');
    const elSub = pick('[data-sub]');
    const elLabel = pick('[data-label]');
    /* 中心标签那张封面，以及它外面那个圆 —— `has-cover` 加在圆上，
       文字与图靠它二选一（两个都在 `.jk-vinyl__label` 里） */
    const elCover = pick<HTMLImageElement>('[data-cover]');
    const elRing = elLabel.parentElement!;
    const elCur = pick('[data-cur]');
    const elDur = pick('[data-dur]');
    const btnPlay = pick('[data-play]');
    const btnMode = pick('[data-mode]');
    const seek = pick<HTMLInputElement>('[data-seek]');
    const vol = pick<HTMLInputElement>('[data-vol]');
    const win = pick('[data-win]');
    const sheet = pick('[data-lines]');
    const listOl = pick('.jk-list__ol');

    // 点歌台那半边
    const elRes = pick('[data-res]');
    const elMsg = pick('[data-msg]');
    const elQ = pick<HTMLInputElement>('[data-q]');
    const form = pick<HTMLFormElement>('[data-find]');
    const btnAll = pick<HTMLButtonElement>('[data-all]');
    const chips = [...scope.querySelectorAll<HTMLButtonElement>('[data-chart]')];

    const run = new WordRun();
    /** 词表里的行元素，下标与 `now().lines` 对齐 */
    let lineEls: HTMLElement[] = [];
    /** 队列行。构建期那几行只是首屏占位，第一次 sync 就整块重铺 */
    let rows: HTMLButtonElement[] = [];
    /** 词表是按哪一首、哪一份歌词铺的 —— 两个都没变就不重铺 */
    let onI = -1;
    let onLines: unknown[] | null = null;
    /** 当前行在词表里的下标。center() 与静默期弹回都要它 */
    let curK = -1;
    /** 拖进度条时别让每帧的回填把滑块拽回去 */
    let drag = false;
    /**
     * 手滑歌词之后的静默期终点（performance.now 的时间轴）：这段时间内自动跟随
     * 不抢滚动位置。没有它，人刚往回翻两行，下一次换行就把位置夺走了 ——
     * 歌词根本读不成。
     */
    let hold = 0;

    /** 进度条／音量条的已填充比例，交给 CSS 画 */
    const fill = (el: HTMLElement, r: number) =>
      el.style.setProperty('--p', String(Math.min(1, Math.max(0, r))));

    /**
     * 歌词行。**只用 textContent** —— 上游的文本是数据，一个字都不进 innerHTML。
     * `plain` 是给「（正在取歌词…）」这类占位行用的：不写 `data-t`，
     * 于是点它不会跳播（否则点一下就回到 0 秒，看着像播放器抽了一下）。
     */
    function mkLine(t: number, text: string, plain = false) {
      const li = document.createElement('li');
      li.className = 'jk-line';
      if (!plain) li.dataset.t = String(t);
      li.textContent = text;
      return li;
    }

    /**
     * 把当前行推到歌词窗的垂直中线。
     * offsetTop 以 `.jk-lyr__win` 为原点（它是 relative），所以这个值可以直接当
     * scrollTop —— 越界由浏览器自己夹住，不用手算 max。
     */
    function center() {
      const cur = lineEls[curK];
      if (!cur) return;
      win.scrollTop = cur.offsetTop + cur.offsetHeight / 2 - win.clientHeight / 2;
    }

    /**
     * 把队列里的某一行拽进视野。队列限了高，末尾那几首的高亮不这么办就在视野外，
     * 看着像「点了没反应」。
     * 不用 `scrollIntoView`：它会顺着所有可滚动祖先一路对齐，可能把整页也带着跳。
     * 这里只动 listOl 自己的 scrollTop，且只在真的看不见时动。
     */
    function revealRow(i: number) {
      const li = rows[i]?.parentElement;
      if (!li) return;
      const top = li.offsetTop;
      const bottom = top + li.offsetHeight;
      if (top < listOl.scrollTop) listOl.scrollTop = top;
      else if (bottom > listOl.scrollTop + listOl.clientHeight) {
        listOl.scrollTop = bottom - listOl.clientHeight;
      }
    }

    function span(cls: string, text: string) {
      const el = document.createElement('span');
      el.className = cls;
      el.textContent = text;
      return el;
    }

    /** 队列里的一行。结构与构建期那几行一致，.jk-row 那套样式与 is-on 全部复用 */
    function mkRow(i: number) {
      const t = list()[i];
      const btn = document.createElement('button');
      btn.className = 'jk-row';
      btn.type = 'button';
      btn.dataset.i = String(i);

      const body = span('jk-row__body', '');
      body.append(span('jk-row__t', t.title), span('jk-row__s', t.subtitle));
      btn.append(
        span('jk-row__n meta', String(i + 1).padStart(2, '0')),
        body,
        // 点歌进来的时长要等 durationchange 才知道，先占个位
        span('jk-row__d meta', t.duration ? formatTime(t.duration) : '—'),
      );

      const li = document.createElement('li');
      li.append(btn);
      listOl.append(li);
      rows.push(btn);
    }

    /** 队列整块重铺。构建期只渲染了原始的那几首，而队列会被点歌加长 */
    function buildRows() {
      listOl.textContent = '';
      rows = [];
      list().forEach((_, i) => mkRow(i));
    }

    /**
     * 词表按**当前曲**重铺。歌词活在单例的状态里（不在这一页的 DOM 里），
     * 所以走一趟别的页面再回来，已经取到的歌词还在，不用再打一遍上游。
     */
    function buildSheet() {
      // 先把当前行的逐段 <span> 折回纯文本：run 的内部状态要跟着归零
      run.unmount();
      const t = now();
      sheet.textContent = '';
      lineEls = [];

      if (t.lines.length) {
        for (const ln of t.lines) {
          const li = mkLine(ln.time, ln.text);
          lineEls.push(li);
          sheet.append(li);
        }
      } else {
        // 点歌进来的歌词是异步取的：还没落地就说「正在取」，取过一次了才是「没有」
        const wait = !!t.ref && !t.lyricDone;
        sheet.append(mkLine(0, wait ? '（正在取歌词…）' : '（这首没有歌词）', true));
      }

      // 换歌回到词首，并把上一首留下的静默期一起清掉 —— 换首歌就该重新跟随了
      win.scrollTop = 0;
      hold = 0;
      curK = -1;
    }

    /** 结果列表。按钮上只放下标，对象留在单例里，不往 DOM 上塞 sign */
    function paintRes() {
      elRes.textContent = '';
      const frag = document.createDocumentFragment();

      hits().forEach((j, k) => {
        const b = document.createElement('button');
        b.className = 'jk-hit';
        b.type = 'button';
        b.dataset.k = String(k);
        b.append(
          span('jk-hit__t', j.title),
          span('jk-hit__a meta', [j.artist, j.album].filter(Boolean).join(' · ')),
        );
        const li = document.createElement('li');
        li.append(b);
        frag.append(li);
      });

      elRes.append(frag);
      /* 「全部播放」跟着结果走。attach() 进来先调一次 res()，
         所以换页回来时按钮的可按状态自动对上，不用另存一份 */
      btnAll.disabled = !hits().length;
    }

    // ---------- 挂进单例 ----------

    /**
     * 贴封面（R22①）。有图就让专辑图铺满中心标签、把那行烫金文字藏掉；
     * 没图就原样退回文字标签 —— 点歌进来的曲目在 `/api/music/pic` 回来之前、
     * 以及压根取不到封面的曲目，走的都是这条路。
     *
     * 加载失败时记住那个 URL 再重画一次：网络挂了不该在盘心留一个碎图标。
     * 这个 `badCover` 随节点走（wire() 的局部量），换页重接就重新给上游一次机会。
     */
    let badCover = '';
    const paintCover = () => {
      const url = coverOf();
      const on = !!url && url !== badCover;
      // 同一个 URL 不重设 src —— 重设会重新发一次请求，盘心还会闪一下
      if (on && elCover.getAttribute('src') !== url) elCover.setAttribute('src', url);
      elCover.hidden = !on;
      elRing.classList.toggle('has-cover', on);
    };
    elCover.addEventListener('error', () => {
      badCover = elCover.getAttribute('src') || '';
      paintCover();
    });

    const view: View = {
      /** 状态变了就整体对一遍。单例在换曲、播放态、模式、音量、时长回填时都会叫它 */
      sync() {
        const t = now();
        const i = at();
        const d = dur();

        /* 词表只在换曲或歌词刚取回来时重铺。parseLrc 每次都返回新数组，
           所以比引用就够 —— 播放／暂停那种 sync 不该把整张词表推倒重来 */
        if (i !== onI || t.lines !== onLines) {
          onI = i;
          onLines = t.lines;
          buildSheet();
        }
        // 点歌加进来的行由 added() 追加；这里兜住「换页回来时队列已经变长了」
        if (rows.length !== list().length) buildRows();

        elTitle.textContent = t.title;
        elSub.textContent = t.subtitle;
        elLabel.textContent = t.title;
        paintCover();
        elDur.textContent = d ? formatTime(d) : '—';
        seek.max = String(d || 0);

        rows.forEach((r, n) => {
          const on = n === i;
          r.classList.toggle('is-on', on);
          if (on) r.setAttribute('aria-current', 'true');
          else r.removeAttribute('aria-current');
        });
        /* 时长回填只会落在当前这首上（durationchange 只对正在放的那份音频说话），
           所以只改这一行的时长格 */
        const cell = rows[i]?.querySelector('.jk-row__d');
        if (cell) cell.textContent = d ? formatTime(d) : '—';
        revealRow(i);

        const on = playing();
        deck.classList.toggle('is-playing', on);
        btnPlay.setAttribute('aria-pressed', String(on));
        btnPlay.setAttribute('aria-label', on ? '暂停' : '播放');

        btnMode.dataset.m = String(getMode());
        const label = '播放方式：' + MODES[getMode()];
        btnMode.setAttribute('aria-label', label);
        btnMode.title = label;

        vol.value = String(getVol());
        fill(vol, getVol());
      },

      /** 每帧一次，只写数字。拖动中这三个数归手指管，别让回填把滑块拽回去 */
      tick() {
        if (drag) return;
        const t = time();
        const d = dur();
        elCur.textContent = formatTime(t);
        seek.value = String(t);
        fill(seek, d ? t / d : 0);
      },

      /**
       * 逐字淡化。换行才动 DOM 与滚动位置，其余每帧只在当前行内改 color 与
       * background-image —— 两个都不参与布局，所以不重排。拆段与跨段的活儿全在
       * 单例的 WordRun 里，这里只管「挂到哪一行」和「要不要抢滚动位置」。
       */
      lyric(k, p, changed) {
        if (changed) {
          curK = k;
          const el = k >= 0 ? lineEls[k] : undefined;
          if (el) {
            /* 必须在 center() **之前**拆完段：拆完才是这一行最终的盒子，
               offsetTop／offsetHeight 要在那之后才准 */
            run.mount(el, lineAt(k));
            // 刚手滑过就不抢位置，让人把那几行读完（静默期结束时 snap 会自己弹回来）
            if (performance.now() >= hold) center();
          } else {
            run.unmount();
            // 还在前奏（k < 0）：回到词首
            if (k < 0) win.scrollTop = 0;
          }
        }
        // 没挂在任何行上时 paint 是空操作，不必再判一次
        run.paint(p);
      },

      /** 点歌只往队尾追加，补一行就够，不必整块重铺 */
      added(i) {
        mkRow(i);
      },

      res() {
        paintRes();
      },

      say(m) {
        elMsg.textContent = m;
      },

      /** 这一首取不到：只在它自己那行留一句话。不弹窗、不清队列、不动播放态 */
      bad(i, why) {
        const r = rows[i];
        if (!r) return;
        r.classList.add('is-bad');
        const s = r.querySelector('.jk-row__s');
        if (s) s.textContent = why;
      },
    };

    /* 事件全绑在这一页自己的节点上。下次导航这些节点连同监听一起被丢弃，
       所以不存在累积 —— 也正因为如此，每次进来都必须重绑一遍 */
    btnPlay.addEventListener('click', toggle);
    btnMode.addEventListener('click', cycleMode);
    // 上一首在随机档也保持线性：按播放历史退一格得维护一个历史栈，超出这轮的需求
    pick('[data-prev]').addEventListener('click', prev);
    pick('[data-next]').addEventListener('click', next);

    // 一个委托监听顶掉几十个 —— 队列会被点歌加长，结果列表整块重画
    listOl.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-i]');
      if (b) load(Number(b.dataset.i), true);
    });

    elRes.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-k]');
      if (!b) return;
      const j = hits()[Number(b.dataset.k)];
      // add() 已经在队列里就返回原来那一行的下标，不会加重复行
      if (j) load(add(j), true);
    });

    btnAll.addEventListener('click', () => {
      // 整批追加到队尾（已在队列里的不重复），再从这批的第一首放起
      const i = addAll();
      if (i >= 0) load(i, true);
    });

    chips.forEach((c) => {
      c.addEventListener('click', () => {
        chips.forEach((o) => o.setAttribute('aria-pressed', String(o === c)));
        elQ.value = '';
        void ask(c.textContent?.trim() || '歌单', 'list', { id: c.dataset.chart ?? '' });
      });
    });

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const kw = elQ.value.trim();
      if (!kw) {
        // 这句只关这一个表单，不进单例的状态：换页回来不该还挂着「要搜什么」
        elMsg.textContent = '要搜什么';
        return;
      }
      chips.forEach((o) => o.setAttribute('aria-pressed', 'false'));
      void ask('「' + kw + '」', 'search', { q: kw, n: String(SEARCH_MAX_N) });
    });

    seek.addEventListener('pointerdown', () => {
      drag = true;
    });
    seek.addEventListener('input', () => {
      const v = Number(seek.value);
      const d = dur();
      fill(seek, d ? v / d : 0);
      elCur.textContent = formatTime(v);
      // 键盘方向键改值时没有 pointerdown，那种情况要当场跳过去
      if (!drag) seekTo(v);
    });
    seek.addEventListener('change', () => {
      drag = false;
      seekTo(Number(seek.value));
    });

    // 音量条不用自己画：setVol 会广播一次 sync，vol.value 与填充比例都在那儿回填
    vol.addEventListener('input', () => setVol(Number(vol.value)));

    /* 手滑歌词之后的静默期。只认 wheel／touchmove（真的在滑），不认 pointerdown：
       点一下不算滑。静默期结束**主动弹回**当前行，不等下一次换行 —— 慢歌一行能唱
       七八秒，手放开之后干等换行，看着就像自动跟随坏了。
       挂在 win 上而不是 window 上，所以不存在监听累积的问题。 */
    const holdOn = () => {
      hold = performance.now() + HOLD_MS;
      // 连续滑动时反复推后，以「最后一次滑」为起点计时
      clearTimeout(snap);
      snap = window.setTimeout(() => {
        hold = 0;
        center();
      }, HOLD_MS);
    };
    win.addEventListener('wheel', holdOn, { passive: true });
    win.addEventListener('touchmove', holdOn, { passive: true });

    /**
     * 点某一行歌词就从那儿播。事件委托在窗上，所以取回来的歌词行不用各自绑。
     * 占位行没有 `data-t`（见 mkLine），点了不动。
     *
     * 键盘可达性靠进度条 —— 每行都塞进 Tab 序列会让几十行歌词淹掉页面的焦点顺序，
     * 而这里提供的是与进度条等价的便捷入口，不是唯一入口。
     */
    win.addEventListener('click', (e) => {
      const li = (e.target as HTMLElement | null)?.closest<HTMLElement>('.jk-line');
      const t = Number(li?.dataset.t);
      if (!li || !Number.isFinite(t)) return;
      // 点了就等于「翻歌词这件事结束了」：立刻交回自动跟随，
      // 否则跳过去之后还要干等一个静默期才回中线
      clearTimeout(snap);
      hold = 0;
      // 暂停时也要立刻看到跳过去了：seekTo 内部会补画一次时间与歌词
      seekTo(t);
    });

    /* 挂进单例。attach 会当场回灌一次现状（结果列表、那句提示语、当前曲、歌词、
       音量与播放方式），所以走开一趟再回来，看到的就是走之前那一台。
       页面打开时不预取任何榜单：每个访客都白打一次上游不值得，也不是需求要的。 */
    live = view;
    attach(view);
  }

  /* 换页前把舞台摘掉。不摘的话单例的视图集合里会每导航一次多攒一个指着已丢弃 DOM
     的僵尸视图，rAF 每帧都白喂它们一遍。
     这个监听留在模块顶层，全站只加一次 —— 写进 `astro:page-load` 会每导航累积一层。 */
  document.addEventListener('astro:before-swap', () => {
    if (!live) return;
    detach(live);
    live = null;
    host = null;
    // 定时器也要清掉：它捕获的 center() 指着这一页即将被丢弃的节点
    clearTimeout(snap);
  });

  wire();
  document.addEventListener('astro:page-load', wire);
</script>

<style>
  /* --- 有 JS / 没 JS 的开关。CSS 控制，避免降级版先闪一下 --- */
  .deck-only {
    display: none;
  }

  :global(:root[data-js]) .deck-only {
    display: block;
  }

  :global(:root[data-js]) .bare-only {
    display: none;
  }

  /* --- 降级版 ----------------------------------------------------------- */
  .bare {
    margin-top: var(--sp-6);
    padding: var(--sp-6);
    border-radius: var(--r-xl);
  }

  .bare__t {
    font-family: var(--font-display);
    font-size: var(--text-xl);
  }

  .bare__s {
    margin-top: var(--sp-1);
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  .bare audio {
    width: 100%;
    margin-top: var(--sp-4);
  }

  .bare__lines {
    list-style: none;
    margin: var(--sp-6) 0 0;
    padding: 0;
    color: var(--ink-soft);
  }

  .bare__lines li {
    display: flex;
    gap: var(--sp-4);
    padding: var(--sp-1) 0;
  }

  /* --- 窄屏 ------------------------------------------------------------- */
  /* 唱盘台、点歌台、歌词窗的窄屏调整全在 styles/player.css 里 —— 那些类已经
     全局化了，媒体查询也得跟着走，留在这儿会因为 scoped 属性选择器而落空。
     这一页剩下的（降级版那几条）在窄屏下不用改，所以这里没有媒体查询 */
</style>
