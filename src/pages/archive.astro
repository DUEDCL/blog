---
// 归档：把四个栏目的内容合成一条按年分组的时间线。
// 全自动 —— 新增任何内容都会自己出现在这里，不需要维护。
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getEntriesByYear } from '../utils/content';

const years = await getEntriesByYear();
const total = years.reduce((sum, y) => sum + y.entries.length, 0);
---

<BaseLayout
  title="归档"
  description="沉麟站内全部内容的时间线，按年份分组。"
>
  <header class="head rise rise-1">
    <p class="meta">ARCHIVE</p>
    <h1 class="head__title">归档</h1>
    <p class="head__desc">
      文章、随笔与作品合成一条时间线，共 {total} 篇。
    </p>

    {total > 0 && (
      /* 搜索只过滤下面已经渲染出来的 DOM，不内联 JSON、不建索引 —— 全站条目
         本来就都在这一页上，再造一份索引是白搭的体积 */
      <div class="find">
        <input
          type="search"
          id="find"
          class="find__input"
          placeholder="搜标题"
          autocomplete="off"
          aria-describedby="find-count"
        />
        <p class="meta find__count" id="find-count" role="status" aria-live="polite"></p>
      </div>
    )}
  </header>

  {years.length > 0 ? (
    <div class="years">
      {years.map((group, i) => (
        <section class={`year rise rise-${Math.min(i + 2, 4)}`}>
          <h2 class="year__num">{group.year}</h2>

          <ol class="line glass">
            {group.entries.map((entry) => (
              <li class="item">
                <a href={entry.href} class="item__link">
                  <span class="meta item__date">
                    <FormattedDate date={entry.pubDate} />
                  </span>
                  <span class="item__title">{entry.title}</span>
                  <span class="meta item__section">{entry.sectionLabel}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  ) : (
    <p class="empty glass">还没有内容。</p>
  )}
</BaseLayout>

<script>
  /* 标题搜索：大小写无关的子串匹配，隐藏不匹配的 li；某一年全空了就连年份一起隐藏。
     条目数在几十到几百这个量级，每次输入全量遍历完全够快，不做防抖也不做索引。 */
  const input = document.getElementById('find') as HTMLInputElement | null;
  const count = document.getElementById('find-count');

  if (input && count) {
    const years = [...document.querySelectorAll<HTMLElement>('.year')].map((year) => ({
      el: year,
      items: [...year.querySelectorAll<HTMLElement>('.item')].map((item) => ({
        el: item,
        text: (item.querySelector('.item__title')?.textContent ?? '').toLowerCase(),
      })),
    }));

    const total = years.reduce((sum, y) => sum + y.items.length, 0);

    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let hits = 0;

      for (const year of years) {
        let visible = 0;

        for (const item of year.items) {
          const match = q === '' || item.text.includes(q);
          item.el.hidden = !match;
          if (match) visible += 1;
        }

        year.el.hidden = visible === 0;
        hits += visible;
      }

      count.textContent =
        q === '' ? '' : hits === 0 ? `没有匹配「${input.value.trim()}」的标题` : `命中 ${hits} / ${total}`;
    };

    input.addEventListener('input', apply);
    /* 浏览器可能恢复上次的输入值（后退、刷新），先按当前值对齐一次 */
    apply();
  }
</script>

<style>
  .head {
    padding-top: var(--sp-8);
    margin-bottom: var(--sp-16);
  }

  .head__title {
    font-size: var(--text-3xl);
    margin-top: var(--sp-3);
  }

  .head__desc {
    margin-top: var(--sp-4);
    color: var(--ink-soft);
    font-size: var(--text-lg);
  }

  /* --- 标题搜索 ----------------------------------------------------------- */
  .find {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
    margin-top: var(--sp-8);
  }

  .find__input {
    flex: 0 1 18rem;
    padding: var(--sp-3) var(--sp-5);
    font-family: inherit;
    font-size: var(--text-base);
    color: var(--ink);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--r-full);
    transition: border-color 0.18s ease, background-color 0.24s ease;
  }

  .find__input::placeholder {
    color: var(--ink-faint);
  }

  .find__input:focus-visible {
    outline: none;
    background: var(--glass-bg-strong);
    border-color: var(--seal);
  }

  .find__count {
    margin: 0;
  }

  .years {
    display: flex;
    flex-direction: column;
    gap: var(--sp-16);
  }

  .year {
    display: grid;
    /* 年份数字单独一栏挂在左侧，窄屏时折到上方 */
    grid-template-columns: 6rem 1fr;
    gap: var(--sp-6);
    align-items: start;
  }

  .year__num {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    color: var(--ink-faint);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    position: sticky;
    /* 让开 sticky 顶栏，否则年份数字会被压在玻璃条底下 */
    top: var(--header-offset);
  }

  .line {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow: hidden;
  }

  /* :not([hidden]) 是给搜索用的 —— 否则被隐藏的条目照样算作相邻兄弟，
     第一条可见行头上会多出一道悬空的分隔线 */
  .item:not([hidden]) + .item:not([hidden]) {
    border-top: 1px solid var(--rule);
  }

  .item__link {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    align-items: baseline;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-6);
    text-decoration: none;
    transition: background-color 0.2s ease, padding-left 0.24s ease;
  }

  .item__link:hover {
    background: var(--seal-wash);
    padding-left: var(--sp-8);
  }

  .item__date {
    white-space: nowrap;
  }

  .item__title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--ink);
    transition: color 0.18s ease;
  }

  .item__link:hover .item__title {
    color: var(--seal);
  }

  .item__section {
    white-space: nowrap;
    color: var(--ink-faint);
  }

  .empty {
    padding: var(--sp-8);
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  @media (max-width: 52rem) {
    .year {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }

    .year__num {
      position: static;
    }

    /* 窄屏放不下三栏，日期与栏目标签折到标题下方 */
    .item__link {
      grid-template-columns: 1fr auto;
      gap: var(--sp-2) var(--sp-4);
    }

    .item__title {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .item__date {
      grid-row: 2;
    }

    .item__section {
      grid-row: 2;
      text-align: right;
    }
  }
</style>
