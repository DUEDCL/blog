---
// 标签页：一页装下全站标签与它们各自的内容。
// 刻意不做 /tags/[标签] 动态路由 —— 当前每个标签只有一两篇，拆开是一堆薄页面；
// 而且 dist/ 里会出现 tags/算法/ 这类非 ASCII 目录名，多一层部署风险。
// 内容量涨上来再拆。
import BaseLayout from '../layouts/BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getAllTagCounts, getEntriesByTag, tagAnchor, tagHref } from '../utils/content';

const tags = await getAllTagCounts();

const groups = await Promise.all(
  tags.map(async ({ tag, count }) => ({
    tag,
    count,
    // id 与 href 都由 utils 里那一对函数生成，保证两边永远对得上。
    // 同页跳转：路径相同、仅片段不同，浏览器不会重新加载
    anchor: tagAnchor(tag),
    href: tagHref(tag),
    entries: await getEntriesByTag(tag),
  }))
);
---

<BaseLayout
  title="标签"
  description="沉麟站内全部标签，以及每个标签下的内容。"
  width="broad"
>
  <header class="head rise rise-1">
    <div class="head__row">
      <span class="vlabel">标签</span>
      <h1 class="head__title">标签</h1>
      <p class="meta head__count">共 {tags.length} 个</p>
    </div>

    <div class="pressrule"></div>

    <p class="head__desc">文章、随笔与作品共用这一套标签。</p>
  </header>

  {groups.length > 0 ? (
    <>
      {/* 标签胶囊：点一下跳到下面对应的一段。字号统一，不按频次加权 */}
      <ul class="cloud rise rise-2">
        {groups.map(({ tag, count, href }) => (
          <li>
            <a class="chip" href={href}>
              <span class="chip__name">{tag}</span>
              <span class="chip__count">{count}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="groups">
        {groups.map(({ tag, count, anchor, entries }) => (
          <section class="group rise rise-3" id={anchor}>
            <h2 class="group__name">
              <span class="group__hash" aria-hidden="true">#</span>{tag}
              <span class="group__count meta">{count} 篇</span>
            </h2>

            <ol class="line">
              {entries.map((entry) => (
                <li class="item">
                  <a href={entry.href} class="item__link">
                    <span class="meta item__date">
                      <FormattedDate date={entry.pubDate} />
                    </span>
                    <span class="item__title">{entry.title}</span>
                    <span class="meta item__section">{entry.sectionLabel}</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </div>
    </>
  ) : (
    <p class="empty">还没有标签。给文章的 frontmatter 加 tags 就会出现在这里。</p>
  )}
</BaseLayout>

<style>
  .head {
    padding-top: var(--sp-8);
    margin-bottom: var(--sp-8);
  }

  .head__row {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .head__title {
    font-size: var(--text-3xl);
    font-variation-settings: 'opsz' 40, 'SOFT' 0, 'WONK' 0;
    letter-spacing: 0.04em;
    line-height: 1;
    margin-right: auto;
  }

  .head__count {
    flex-shrink: 0;
  }

  .pressrule {
    margin-top: var(--sp-5);
  }

  .head__desc {
    margin-top: var(--sp-4);
    color: var(--ink-soft);
    font-size: var(--text-base);
  }

  /* --- 标签索引 -----------------------------------------------------------
     R44 从「玻璃胶囊 + hover 上浮 2px」改成方框（宪法第 4 条：hover 上浮不携带
     信息）。方框而不是药丸，与全站一致：只有浮层保留圆角。
     字号统一，不按频次加权 —— 加权的标签云是把频次编码进字号，读者要靠比大小
     才能读出数字，而数字就写在旁边。 */
  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    margin: var(--sp-8) 0 var(--sp-16);
    padding: 0;
    list-style: none;
  }

  .chip {
    display: inline-flex;
    align-items: baseline;
    gap: var(--sp-2);
    padding: 0.3em 0.7em;
    border: var(--rule-w) solid var(--rule-strong);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--ink-soft);
    text-decoration: none;
    transition: color 0.18s ease, border-color 0.18s ease,
      background-color 0.24s ease;
  }

  .chip:hover {
    color: var(--ink);
    background: var(--seal-wash);
    border-color: var(--seal);
  }

  .chip__name::before {
    content: '#';
    color: var(--seal);
    margin-right: 0.15em;
  }

  .chip__count {
    font-size: var(--text-xs);
    color: var(--ink-faint);
    font-variant-numeric: tabular-nums;
  }

  /* --- 每个标签一段 ------------------------------------------------------ */
  .groups {
    display: flex;
    flex-direction: column;
    gap: var(--sp-12);
  }

  .group {
    /* 锚点偏移由 global.css 的 html { scroll-padding-top } 统一管，这里不重复定义 */
    transition: background-color 0.5s ease;
  }

  /* 跳过来的那一段给一层底色，明确「落在哪」 */
  .group:target {
    background: var(--seal-wash);
    box-shadow: 0 0 0 var(--sp-4) var(--seal-wash);
  }

  .group__name {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
    font-size: var(--text-xl);
    margin-bottom: var(--sp-4);
  }

  .group__hash {
    color: var(--seal);
  }

  .group__count {
    font-weight: 400;
  }

  /* --- 条目列表（与归档页同一套版式） ----------------------------------- */
  .line {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--rule-w) solid var(--rule-strong);
    border-bottom: var(--rule-w) solid var(--rule-strong);
  }

  .item + .item {
    border-top: var(--rule-w) solid var(--rule);
  }

  .item__link {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    align-items: baseline;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-3);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  .item__link:hover {
    background: var(--seal-wash);
  }

  .item__date {
    white-space: nowrap;
  }

  .item__title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--ink);
    transition: color 0.18s ease;
  }

  .item__link:hover .item__title {
    color: var(--seal);
  }

  .item__section {
    white-space: nowrap;
    color: var(--ink-faint);
  }

  .empty {
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  @media (max-width: 52rem) {
    /* 窄屏放不下三栏，日期与栏目标签折到标题下方 */
    .item__link {
      grid-template-columns: 1fr auto;
      gap: var(--sp-2) var(--sp-4);
    }

    .item__title {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .item__date {
      grid-row: 2;
    }

    .item__section {
      grid-row: 2;
      text-align: right;
    }
  }
</style>
