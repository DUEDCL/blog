---
/**
 * 首页 —— 对开大版的头版（R44 重做）。
 *
 * 上一版是「玻璃 hero 卡 + 三块等重的玻璃列表 + 四张入口卡」，1280 宽渲染实测
 * 从上到下六个圆角矩形、边框圆角底色全部相同，站主的判断是「简陋」。诊断在
 * DESIGN_DECISIONS 的 DD-014，一句话版：**版面没有层级**——
 * 内容区最大的字号是 19px（条目标题），最小是 12px，中间什么都没有，
 * 而每个区块的视觉重量一模一样，所以第一眼不知道该看哪里。
 *
 * 这一版按报纸头版排：一处刊头、一条头条、一根朱红报头线、两栏加一道分栏线。
 * 层级由**字号跨度**（刊名 120px → 头条 48px → 条目 19px → 刊眉 12px，跨 10 倍）
 * 和**栏宽差异**（左栏 2.1fr、右栏 1fr）承担，不由卡片边框承担。
 */
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getAllEntries, getListItems } from '../../utils/content';
import { SITE_TITLE, SOCIAL, PORTALS, EDITIONS } from '../../consts';
import { LOCALE_PARAMS, localePath, t, toLocale } from '../../i18n';
import avatar from '../../assets/avatar.jpg';

export function getStaticPaths() {
  return LOCALE_PARAMS.map((params) => ({ params }));
}

const locale = toLocale(Astro.params.locale);
const strings = t(locale);

const posts = await getListItems('posts', locale);
const notes = await getListItems('notes', locale);
const projects = (await getListItems('projects', locale)).filter(
  (p) => p.data.featured
);
const all = await getAllEntries(locale);

/* 头条 = 最新那篇文章，其余排成小条目。posts 为空时 lead 是 undefined，整块不渲染 */
const [lead, ...more] = posts;
const rest = more.slice(0, 3);
const asides = notes.slice(0, 3);
const works = projects.slice(0, 3);

/**
 * 期号用**全站条目总数**：报纸期号单调递增，而「发一篇 +1」正好也是单调递增的
 * 真实数字，数得出来（宪法第 2 条：能数出来的真实数字比任何「智能感」装饰都强）。
 * 刻意不用建站天数 —— 那个每天都变，而这是静态站，不重新构建就会撒谎。
 */
const issue = all.length;
const latest = all[0]?.pubDate;

const socialLinks = [
  { label: 'GitHub', href: SOCIAL.github },
  { label: strings.common.email, href: SOCIAL.email ? `mailto:${SOCIAL.email}` : '' },
  { label: 'RSS', href: SOCIAL.rss ? localePath(locale, SOCIAL.rss) : '' },
].filter((l) => l.href);
---

<BaseLayout description={strings.siteDescription} width="broad">
  {/* ---------- 刊头 ---------- */}
  <header class="mast glass-card rise rise-1">
    <div class="mast__row">
      <h1 class="mast__name">{SITE_TITLE}</h1>

      <div class="mast__verse">
        <Image
          src={avatar}
          alt={strings.common.avatarAlt(SITE_TITLE)}
          width={120}
          height={120}
          loading="eager"
          class="mast__face"
        />
        <div>
          {strings.bio.map((line, i) => (
            <p class={i === 0 ? 'mast__lead' : 'mast__sub'}>{line}</p>
          ))}
        </div>
      </div>
    </div>

    <div class="pressrule"></div>

    {/* 刊眉：期号与日期是真实数字（见上面 issue 的注释）；版次名靠纯 CSS 选，
        没有一行 JS —— 静态产物里四个名字都在，由 html[data-theme] 决定露哪一个 */}
    <div class="mast__line">
      <p class="meta mast__meta">
        <span>{strings.home.issue(issue)}</span>
        {latest && (
          <>
            <span class="dot" aria-hidden="true">·</span>
            <FormattedDate date={latest} format="long" />
          </>
        )}
        <span class="dot" aria-hidden="true">·</span>
        <span class="edname">
          {EDITIONS.map((e) => <span data-for={e.id}>{strings.editions[e.id].name}</span>)}
        </span>
      </p>

      {socialLinks.length > 0 && (
        <ul class="mast__links">
          {socialLinks.map((l) => (
            <li>
              <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined}>
                {l.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </header>

  {/* ---------- 头版：左栏文章（含头条），右栏随笔 ---------- */}
  <div class="front rise rise-2">
    <section class="front__main glass-card">
      <div class="colhead">
        <span class="vlabel">{strings.sections.posts.label}</span>
        <h2 class="colhead__title">{strings.sections.posts.title}</h2>
        <a href={localePath(locale, '/posts')} class="colhead__more">
          {strings.home.allCount(posts.length)}
        </a>
      </div>

      {lead ? (
        <>
          {/* 头条：整个版面唯一一处出现摘要的地方 —— 其余条目只有标题与日期。
              「哪一条是头条」因此不需要标签，字号自己说了 */}
          <article class="lead">
            <a href={lead.href} class="lead__link">
              <h3 class="lead__title">{lead.title}</h3>
              <p class="lead__dek">{lead.description}</p>
            </a>
            <p class="meta lead__date">
              <FormattedDate date={lead.pubDate} />
            </p>
          </article>

          {rest.length > 0 && (
            <ul class="briefs">
              {rest.map((p) => (
                <li class="brief">
                  <a href={p.href}>
                    <span class="brief__title">{p.title}</span>
                    <span class="meta brief__date">
                      <FormattedDate date={p.pubDate} />
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          )}
        </>
      ) : (
        <p class="empty">{strings.sections.posts.empty}</p>
      )}
    </section>

    <section class="front__side glass-card">
      <div class="colhead">
        <span class="vlabel">{strings.sections.notes.label}</span>
        <h2 class="colhead__title">{strings.sections.notes.title}</h2>
        <a href={localePath(locale, '/notes')} class="colhead__more">
          {strings.home.all}
        </a>
      </div>

      {asides.length > 0 ? (
        <ul class="briefs briefs--stack">
          {asides.map((n) => (
            <li class="brief">
              <a href={n.href}>
                <span class="brief__title">{n.title}</span>
                <span class="meta brief__date">
                  <FormattedDate date={n.pubDate} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="empty">{strings.sections.notes.empty}</p>
      )}
    </section>
  </div>

  {/* ---------- 作品：三栏并列，栏与栏之间是分栏线 ---------- */}
  {works.length > 0 && (
    <section class="works rise rise-3">
      <div class="hairline"></div>

      <div class="colhead">
        <span class="vlabel">{strings.sections.projects.label}</span>
        <h2 class="colhead__title">{strings.sections.projects.title}</h2>
        <a href={localePath(locale, '/projects')} class="colhead__more">
          {strings.home.all}
        </a>
      </div>

      <ul class="works__grid">
        {works.map((pr) => (
          <li class="work glass-card glass-card--tight glass-card--interactive">
            <a href={pr.href}>
              <h3 class="work__title">{pr.title}</h3>
              <p class="work__desc">{pr.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  {/* ---------- 别处：本期目录 ----------
      上一版这里是四张玻璃卡（`.portal`，hover 时整卡上浮 —— 宪法第 4 条把
      「hover 时整卡上浮」列为反例）。改成报纸的目录条：一行文字链，竖线分隔。
      四个入口本来就只是四个地址，不需要四个盒子。 */}
  <nav class="toc rise rise-4" aria-label={strings.home.elsewhere}>
    <div class="hairline"></div>
    <ul class="toc__list">
      {PORTALS.map((p) => (
        <li class="toc__item glass-card glass-card--tight glass-card--interactive">
          <a href={localePath(locale, p.href)}>
            <span class="toc__label">{strings.portals[p.key].label}</span>
            <span class="toc__desc">{strings.portals[p.key].description}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
</BaseLayout>

<style>
  /* 头版：一张大玻璃刊头 + 两张栏卡 + 作品/目录小卡。 */
  .mast {
    padding: var(--sp-8);
  }

  .mast__row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-6) var(--sp-10);
  }

  .mast__name {
    font-size: var(--text-masthead);
    letter-spacing: -0.02em;
    line-height: 0.98;
  }

  .mast__verse {
    display: flex;
    align-items: flex-end;
    gap: var(--sp-4);
    padding-bottom: 0.3rem;
    max-width: 32rem;
  }

  .mast__face {
    width: 4.5rem;
    height: 4.5rem;
    flex-shrink: 0;
    object-fit: cover;
    border-radius: var(--r-md);
    border: 1px solid var(--glass-border-lit);
    box-shadow: 0 14px 36px -20px rgba(0, 0, 0, 0.9);
  }

  .mast__lead {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: 1.55;
    color: var(--ink);
  }

  .mast__sub {
    margin-top: var(--sp-2);
    font-size: var(--text-sm);
    line-height: 1.6;
    color: var(--ink-faint);
  }

  .pressrule {
    margin-top: var(--sp-6);
  }

  .mast__line {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-2) var(--sp-6);
    margin-top: var(--sp-4);
  }

  .mast__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2);
  }

  .dot {
    opacity: 0.4;
  }

  .mast__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-5);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mast__links a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .mast__links a:hover {
    color: var(--seal);
  }

  /* 两栏：左栏主文，右栏随笔。两张玻璃卡浮在同一层。 */
  .front {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: var(--sp-5);
    margin-top: var(--sp-5);
    align-items: stretch;
  }

  .front__main,
  .front__side {
    padding: var(--sp-6);
    border-radius: var(--r-lg);
  }

  .lead__link {
    display: block;
    text-decoration: none;
  }

  .lead__title {
    font-size: var(--text-2xl);
    letter-spacing: -0.03em;
    line-height: 1.18;
    transition: color 0.18s ease;
  }

  .lead__link:hover .lead__title {
    color: var(--seal);
  }

  .lead__dek {
    margin-top: var(--sp-3);
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--ink-soft);
    max-width: 36rem;
  }

  .lead__date {
    margin-top: var(--sp-4);
  }

  .briefs {
    margin-top: var(--sp-5);
  }

  .front .brief {
    background: var(--glass-bg);
    box-shadow: none;
  }

  .briefs--stack .brief > a {
    display: block;
  }

  .briefs--stack .brief__date {
    display: block;
    margin-top: var(--sp-2);
  }

  .empty {
    margin-top: var(--sp-6);
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  .works,
  .toc {
    margin-top: var(--sp-12);
  }

  .works .colhead,
  .toc .colhead {
    margin-top: var(--sp-2);
  }

  .works__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: var(--sp-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .work {
    padding: var(--sp-5);
  }

  .work a {
    display: block;
    height: 100%;
    text-decoration: none;
  }

  .work__title {
    font-size: var(--text-lg);
    transition: color 0.18s ease;
  }

  .work a:hover .work__title {
    color: var(--seal);
  }

  .work__desc {
    margin-top: var(--sp-2);
    font-size: var(--text-sm);
    line-height: 1.65;
    color: var(--ink-soft);
  }

  .toc__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sp-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc__item {
    padding: var(--sp-4);
  }

  .toc__item a {
    display: block;
    height: 100%;
    text-decoration: none;
  }

  .toc__label {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
    transition: color 0.18s ease;
  }

  .toc__item a:hover .toc__label {
    color: var(--seal);
  }

  .toc__desc {
    display: block;
    margin-top: var(--sp-1);
    font-size: var(--text-xs);
    line-height: 1.5;
    color: var(--ink-faint);
  }

  @media (max-width: 52rem) {
    .front {
      grid-template-columns: 1fr;
    }

    .works__grid,
    .toc__list {
      grid-template-columns: 1fr;
    }

    .mast__verse {
      align-items: flex-start;
      max-width: none;
    }
  }

  @media (max-width: 40rem) {
    .mast {
      padding: var(--sp-5);
    }

    .mast__face {
      width: 3.5rem;
      height: 3.5rem;
    }

    .front__main,
    .front__side {
      padding: var(--sp-5);
    }
  }
</style>