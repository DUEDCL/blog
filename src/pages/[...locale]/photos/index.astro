---
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { getListItems } from '../../../utils/content';
import { LOCALE_PARAMS, t, toLocale } from '../../../i18n';

export function getStaticPaths() {
  return LOCALE_PARAMS.map((params) => ({ params }));
}

const locale = toLocale(Astro.params.locale);
const strings = t(locale);
const s = strings.sections.photos;

const albums = await getListItems('photos', locale);
---

<BaseLayout
  title={s.title}
  description={s.description}
  footerNote={s.note}
  width="wide"
>
  <header class="head glass-card rise rise-1">
    <div class="head__row">
      <span class="vlabel">{s.label}</span>
      <h1 class="head__title">{s.title}</h1>
      <p class="meta head__count">{strings.photos.count(albums.length)}</p>
    </div>
    <div class="pressrule"></div>
  </header>

  {albums.length > 0 ? (
    <ul class="grid rise rise-2">
      {albums.map((album, i) => (
        <li class:list={['cell', { 'cell--tall': i % 5 === 0 }]}>
          <a href={album.href} class="cell__link">
            <Image
              src={album.data.cover}
              alt={album.data.coverAlt}
              widths={[400, 800, 1200]}
              loading={i < 3 ? 'eager' : 'lazy'}
            />

            <div class="cell__overlay">
              <span class="cell__title">{album.title}</span>
              <span class="cell__meta meta">
                {album.data.location && <span>{album.data.location}</span>}
                <FormattedDate date={album.pubDate} />
                {album.data.images.length > 0 && (
                  <span>{strings.photos.shots(album.data.images.length + 1)}</span>
                )}
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">{s.empty}</p>
  )}
</BaseLayout>

<style>
  .head {
    padding: var(--sp-8);
  }

  .head__row {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .head__title {
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-right: auto;
  }

  .head__count {
    flex-shrink: 0;
  }

  .pressrule {
    margin-top: var(--sp-5);
  }

  /* 密排网格：每第 5 张跨两行，打破整齐的方格感。
     用 auto-fit 而不是 auto-fill —— 相册只有两三组时 auto-fill 会留下空轨道，
     右半屏一片空白；auto-fit 会把空轨道折叠掉，让现有相册铺满整行。 */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    grid-auto-rows: 14rem;
    gap: var(--sp-3);
    list-style: none;
    margin: var(--sp-8) 0 0;
    padding: 0;
  }

  .cell--tall {
    grid-row: span 2;
  }

  .cell__link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: 1px solid var(--glass-border);
    border-radius: var(--r-lg);
    background: var(--paper-sunken);
    box-shadow: var(--shadow-glass);
    text-decoration: none;
    transition: border-color 0.24s ease, box-shadow 0.24s ease;
  }

  .cell__link:hover {
    border-color: var(--glass-border-lit);
    box-shadow: var(--shadow-glass), var(--glow-accent);
  }

  .cell__link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition: filter 0.4s ease;
  }

  /* R44 删掉了 hover 时的 `transform: scale(1.04)` 与那道 40px 落影：
     图片放大是「可点」的常见套路，但它不报告任何东西（宪法第 4 条）。
     留下的饱和度变化很轻，作用是「这一张被选中了」—— 换句话说它替代的是
     hover 高亮，不是动画。 */
  .cell__link:hover :global(img) {
    filter: saturate(1.05);
  }

  /* 说明文字压在图片上，默认半隐，hover 浮现。底部一层玻璃保证文字可读 */
  .cell__overlay {
    position: absolute;
    inset: auto var(--sp-2) var(--sp-2);
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-4);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--r-md);
    background: rgba(5, 5, 5, 0.55);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    backdrop-filter: blur(16px) saturate(140%);
    color: var(--sand-50);
    opacity: 0.92;
    transition: opacity 0.3s ease, border-color 0.3s ease;
  }

  .cell__link:hover .cell__overlay,
  .cell__link:focus-visible .cell__overlay {
    opacity: 1;
    border-color: rgba(255, 255, 255, 0.22);
  }

  .cell__title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .cell__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    /* 覆盖 .meta 的颜色：图片上必须用亮色 */
    color: rgba(215, 214, 213, 0.78);
  }

  .empty {
    margin-top: var(--sp-8);
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  @media (max-width: 52rem) {
    .head__title {
      font-size: var(--text-2xl);
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      grid-auto-rows: 11rem;
    }
  }
</style>
