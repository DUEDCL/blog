---
// 归档：把四个栏目的内容合成一条按年分组的时间线。
// 全自动 —— 新增任何内容都会自己出现在这里，不需要维护。
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getEntriesByYear } from '../../utils/content';
import { LOCALE_PARAMS, t, toLocale } from '../../i18n';

export function getStaticPaths() {
  return LOCALE_PARAMS.map((params) => ({ params }));
}

const locale = toLocale(Astro.params.locale);
const s = t(locale).archive;

const years = await getEntriesByYear(locale);
const total = years.reduce((sum, y) => sum + y.entries.length, 0);
---

<BaseLayout title={s.title} description={s.description} width="broad">
  <header class="head rise rise-1">
    {/* 与栏目列表页同一套页头（竖排标识 + 标题 + 计数 + 朱红报头线）——
        R44 之前这里是「ARCHIVE + 标题 + 一段描述」，三个索引页三种页头 */}
    <div class="head__row">
      <span class="vlabel">{s.title}</span>
      <h1 class="head__title">{s.title}</h1>
      <p class="meta head__count">{s.count(total)}</p>
    </div>

    <div class="pressrule"></div>

    <p class="head__desc">{s.lead}</p>

    {total > 0 && (
      /* 搜索只过滤下面已经渲染出来的 DOM，不内联 JSON、不建索引 —— 全站条目
         本来就都在这一页上，再造一份索引是白搭的体积 */
      <div class="find">
        <input
          type="search"
          id="find"
          class="find__input"
          placeholder={s.searchPlaceholder}
          autocomplete="off"
          aria-describedby="find-count"
        />
        {/* 两条状态文案**以模板串的形式挂在这儿**（R46）：下面那段脚本是 bundled
            module，import 不到当前页面的语言。占位符由脚本 replace 掉 ——
            词条因此仍然只有 `i18n/*.ts` 一个来源。 */}
        <p
          class="meta find__count"
          id="find-count"
          role="status"
          aria-live="polite"
          data-t-hit={s.hit('{n}', '{total}')}
          data-t-miss={s.miss('{q}')}
        ></p>
      </div>
    )}
  </header>

  {years.length > 0 ? (
    <div class="years">
      {years.map((group, i) => (
        <section class={`year rise rise-${Math.min(i + 2, 4)}`}>
          <h2 class="year__num">{group.year}</h2>

          <ol class="line">
            {group.entries.map((entry) => (
              <li class="item">
                <a href={entry.href} class="item__link">
                  <span class="meta item__date">
                    <FormattedDate date={entry.pubDate} />
                  </span>
                  <span class="item__title">{entry.title}</span>
                  <span class="meta item__section">{entry.sectionLabel}</span>
                </a>
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  ) : (
    <p class="empty">{s.empty}</p>
  )}
</BaseLayout>

<script>
  /* 标题搜索：大小写无关的子串匹配，隐藏不匹配的 li；某一年全空了就连年份一起隐藏。
     条目数在几十到几百这个量级，每次输入全量遍历完全够快，不做防抖也不做索引。

     整段挂在 `astro:page-load` 上：这是 bundled module，模块体一辈子只执行一次，
     而 SPA 导航每次都换来一套新的 DOM —— 顶层绑一次的话，离开归档再回来搜索框就死了。
     每次重新收集 years 也是必须的：上一份引用指着已经被丢弃的节点。 */
  document.addEventListener('astro:page-load', () => {
    const input = document.getElementById('find') as HTMLInputElement | null;
    const count = document.getElementById('find-count');
    if (!input || !count) return;

    /* 两条文案由服务端渲染成模板串挂在 `#find-count` 上（见上面那段注释）。
       这个模块 import 不到当前页面的语言，DOM 是唯一能拿到它的地方。 */
    const tHit = count.dataset.tHit ?? '';
    const tMiss = count.dataset.tMiss ?? '';

    const years = [...document.querySelectorAll<HTMLElement>('.year')].map((year) => ({
      el: year,
      items: [...year.querySelectorAll<HTMLElement>('.item')].map((item) => ({
        el: item,
        text: (item.querySelector('.item__title')?.textContent ?? '').toLowerCase(),
      })),
    }));

    const total = years.reduce((sum, y) => sum + y.items.length, 0);

    const apply = () => {
      const q = input.value.trim().toLowerCase();
      let hits = 0;

      for (const year of years) {
        let visible = 0;

        for (const item of year.items) {
          const match = q === '' || item.text.includes(q);
          item.el.hidden = !match;
          if (match) visible += 1;
        }

        year.el.hidden = visible === 0;
        hits += visible;
      }

      count.textContent =
        q === ''
          ? ''
          : hits === 0
            ? tMiss.replace('{q}', input.value.trim())
            : tHit.replace('{n}', String(hits)).replace('{total}', String(total));
    };

    input.addEventListener('input', apply);
    /* 浏览器可能恢复上次的输入值（后退、刷新），先按当前值对齐一次 */
    apply();
  });
</script>

<style>
  .head {
    padding-top: var(--sp-8);
    margin-bottom: var(--sp-16);
  }

  .head__row {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .head__title {
    font-size: var(--text-3xl);
    font-variation-settings: 'opsz' 40, 'SOFT' 0, 'WONK' 0;
    letter-spacing: 0.04em;
    line-height: 1;
    margin-right: auto;
  }

  .head__count {
    flex-shrink: 0;
  }

  .pressrule {
    margin-top: var(--sp-5);
  }

  .head__desc {
    margin-top: var(--sp-4);
    color: var(--ink-soft);
    font-size: var(--text-base);
  }

  /* --- 标题搜索 ----------------------------------------------------------- */
  .find {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
    margin-top: var(--sp-8);
  }

  /* 方框，不是药丸（R44）。表单控件的圆角是「app 的长相」；印刷品上的填写框
     是方的，而这一版全站只有浮层保留圆角 */
  .find__input {
    flex: 0 1 18rem;
    padding: var(--sp-3) var(--sp-4);
    font-family: inherit;
    font-size: var(--text-base);
    color: var(--ink);
    background: transparent;
    border: var(--rule-w) solid var(--rule-strong);
    border-radius: 0;
    transition: border-color 0.18s ease, background-color 0.24s ease;
  }

  .find__input::placeholder {
    color: var(--ink-faint);
  }

  .find__input:focus-visible {
    outline: none;
    background: var(--seal-wash);
    border-color: var(--seal);
  }

  .find__count {
    margin: 0;
  }

  .years {
    display: flex;
    flex-direction: column;
    gap: var(--sp-16);
  }

  .year {
    display: grid;
    /* 年份数字单独一栏挂在左侧，窄屏时折到上方 */
    grid-template-columns: 6rem 1fr;
    gap: var(--sp-6);
    align-items: start;
  }

  .year__num {
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    color: var(--ink-faint);
    letter-spacing: 0.04em;
    font-variant-numeric: tabular-nums;
    position: sticky;
    /* 让开 sticky 顶栏，否则年份数字会被压在玻璃条底下 */
    top: var(--header-offset);
  }

  .line {
    list-style: none;
    margin: 0;
    padding: 0;
    /* 上下封口：报纸的索引块两端都有线，不然最后一条读起来像被裁掉了 */
    border-top: var(--rule-w) solid var(--rule-strong);
    border-bottom: var(--rule-w) solid var(--rule-strong);
  }

  /* :not([hidden]) 是给搜索用的 —— 否则被隐藏的条目照样算作相邻兄弟，
     第一条可见行头上会多出一道悬空的分隔线 */
  .item:not([hidden]) + .item:not([hidden]) {
    border-top: var(--rule-w) solid var(--rule);
  }

  .item__link {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    align-items: baseline;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-3);
    text-decoration: none;
    transition: background-color 0.2s ease;
  }

  /* hover 只换底色。上一版还同时把 padding-left 从 sp-6 推到 sp-8（0.24s），
     那段位移不携带任何信息 —— 宪法第 4 条：报告不了状态、数据或进度的动效删掉 */
  .item__link:hover {
    background: var(--seal-wash);
  }

  .item__date {
    white-space: nowrap;
  }

  .item__title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    color: var(--ink);
    transition: color 0.18s ease;
  }

  .item__link:hover .item__title {
    color: var(--seal);
  }

  .item__section {
    white-space: nowrap;
    color: var(--ink-faint);
  }

  .empty {
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  @media (max-width: 52rem) {
    .year {
      grid-template-columns: 1fr;
      gap: var(--sp-4);
    }

    .year__num {
      position: static;
    }

    /* 窄屏放不下三栏，日期与栏目标签折到标题下方 */
    .item__link {
      grid-template-columns: 1fr auto;
      gap: var(--sp-2) var(--sp-4);
    }

    .item__title {
      grid-column: 1 / -1;
      grid-row: 1;
    }

    .item__date {
      grid-row: 2;
    }

    .item__section {
      grid-row: 2;
      text-align: right;
    }
  }
</style>
