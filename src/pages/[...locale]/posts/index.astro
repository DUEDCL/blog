---
import ListLayout from '../../../layouts/ListLayout.astro';
import { getListItems } from '../../../utils/content';
import { LOCALE_PARAMS, t, toLocale } from '../../../i18n';

/* 三种语言各一张：`/posts`（中文，无前缀）、`/en/posts`、`/ja/posts` */
export function getStaticPaths() {
  return LOCALE_PARAMS.map((params) => ({ params }));
}

const locale = toLocale(Astro.params.locale);
const s = t(locale).sections.posts;
const items = await getListItems('posts', locale);
---

<ListLayout
  title={s.title}
  label={s.label}
  description={s.description}
  note={s.note}
  empty={s.empty}
  items={items}
/>
