---
/**
 * 刷步数 —— 往 Zepp Life 写步数，微信运动从那儿同步。
 *
 * 版式按对开大版的「服务台」排：
 * 页头（竖排标识 + 报头线）→ 说明栏（纸面 sheet）→ 状态台（登录后）→ 流水（细线表）。
 * 主页只显示**备注**，不显示账号 —— 账号是隐私，备注才是给他自己认的。
 *
 * 密码永不进这一页的 HTML（它是边缘缓存的公开页）。
 * 账号列表也只在登录后由 fetch 填，构建期只出骨架。
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALE_PARAMS, t, toLocale } from '../../../i18n';

export function getStaticPaths() {
  return LOCALE_PARAMS.map((params) => ({ params }));
}

const locale = toLocale(Astro.params.locale);
const strings = t(locale);
const s = strings.stepsTool;
---

<BaseLayout title={s.title} description={s.description} footerNote={s.note}>
  <header class="head glass-card rise rise-1">
    <div class="head__row">
      <span class="vlabel">{s.heading}</span>
      <h1 class="head__title">{s.title}</h1>
    </div>
    <div class="pressrule"></div>
    <p class="head__desc">{s.lead}</p>
  </header>

  <div class="cols rise rise-2">
    <section class="sheet brief">
      <h2 class="brief__h">{s.howTitle}</h2>
      <p>{s.how}</p>
    </section>
    <section class="sheet brief brief--dim">
      <h2 class="brief__h">{s.warnTitle}</h2>
      <p>{s.warn}</p>
    </section>
  </div>

  {/* 未登录：只说清边界，给后台入口。登录后的面板整块由脚本揭开 */}
  <section class="gate rise rise-2" data-gate>
    <p class="dim">{s.needAdmin}</p>
    <a class="keylike" href="/admin">{s.goAdmin} →</a>
  </section>

  <section class="panel rise rise-3" data-panel hidden>
    <div class="panel__head">
      <h2 class="sub">{s.panel}</h2>
      <div class="panel__acts">
        <button class="keylike keylike--quiet" type="button" data-run-auto>执行自动规则</button>
        <button class="keylike keylike--quiet" type="button" data-refresh>{s.refresh}</button>
      </div>
    </div>
    <p class="dim heartbeat" data-heartbeat></p>

    <ul class="accounts" data-accounts></ul>
    <p class="dim empty" data-empty hidden>{s.noAccounts} {s.addHint}</p>

    <div class="loghead">
      <h2 class="sub">{s.log}</h2>
      <div class="hairline"></div>
    </div>
    <ol class="log" data-log></ol>
    <p class="dim empty" data-log-empty hidden>{s.logEmpty}</p>
  </section>
</BaseLayout>

<style>
  .head {
    padding: var(--sp-8);
    margin-bottom: var(--sp-6);
  }

  .head__row {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .head__title {
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-right: auto;
  }

  .pressrule {
    margin-top: var(--sp-5);
  }

  .head__desc {
    margin-top: var(--sp-4);
    color: var(--ink-soft);
    font-size: var(--text-base);
    max-width: var(--measure-prose);
    line-height: var(--leading-normal);
  }

  /* 两栏说明：像报纸中缝分开的两块服务栏 */
  .cols {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--gutter);
    margin-bottom: var(--sp-8);
    align-items: start;
  }

  .brief {
    padding: var(--sp-5) var(--sp-6);
    background: transparent;
    border: 1px solid var(--glass-border);
  }

  .brief--dim {
    background: transparent;
    border-color: var(--glass-border);
  }

  .panel {
    padding: var(--sp-6);
    background-color: var(--glass-under);
    background-image: linear-gradient(var(--glass-bg), var(--glass-bg));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    border: 1px solid var(--glass-border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-glass);
  }

  .gate {
    padding: var(--sp-5);
    border: 1px solid var(--glass-border);
    border-radius: var(--r-lg);
    background: var(--glass-bg);
  }

  .brief__h {
    margin: 0 0 var(--sp-3);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--ink-faint);
    text-transform: none;
  }

  .brief p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-soft);
  }

  .dim {
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  .gate {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
    margin-bottom: var(--sp-8);
  }

  .gate p {
    margin: 0;
  }

  .keylike {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 0.5em 1.05em;
    border: 1px solid var(--glass-border);
    border-radius: var(--r-md);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-decoration: none;
    cursor: pointer;
    background: var(--glass-bg);
    transition: border-color 0.18s ease, background-color 0.18s ease, color 0.18s ease;
  }

  .keylike:hover {
    border-color: var(--seal);
    color: var(--ink);
    background: var(--seal-wash);
  }

  .keylike--quiet {
    color: var(--ink-soft);
    border-color: var(--rule);
  }

  .panel__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-2);
  }

  .panel__acts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .sub {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.02em;
  }

  .heartbeat {
    margin: 0 0 var(--sp-5);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  /* 账号条：像报纸分类广告的整行 —— 左侧名号，右侧动作，条件句占满一行 */
  .accounts {
    list-style: none;
    margin: 0 0 var(--sp-10);
    padding: 0;
    display: grid;
    gap: var(--sp-3);
  }

  .account {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--sp-3) var(--sp-5);
    padding: var(--sp-5);
    border: 1px solid var(--glass-border);
    border-radius: var(--r-md);
    background: var(--glass-bg);
  }

  .account__user {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--ink);
    line-height: 1.2;
  }

  .account__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    justify-content: flex-end;
    align-items: start;
  }

  .badge {
    display: inline-flex;
    padding: 0.22em 0.6em;
    border: 1px solid var(--glass-border);
    border-radius: var(--r-full);
    background: var(--glass-bg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    white-space: nowrap;
    text-transform: uppercase;
  }

  .badge--on {
    border-color: var(--seal);
    color: var(--ink);
    background: var(--seal-wash);
  }

  /* 条件句 —— 签名。数字用等宽，下压一道朱红细线 */
  .rule {
    grid-column: 1 / -1;
    margin: 0;
    padding: var(--sp-2) 0 0;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--ink-soft);
  }

  .rule b {
    font-family: var(--font-mono);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--ink);
    border-bottom: 1px solid var(--press);
    padding-bottom: 1px;
  }

  .account__meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-5);
    margin-top: var(--sp-2);
    padding-top: var(--sp-4);
    border-top: var(--rule-w) solid var(--rule);
  }

  .steps-now {
    font-family: var(--font-mono);
    font-size: var(--text-3xl);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    line-height: 1;
    color: var(--ink);
    min-width: 4.5ch;
  }

  .steps-now::after {
    content: ' 步';
    font-size: var(--text-sm);
    color: var(--ink-faint);
    letter-spacing: 0.12em;
    margin-left: 0.15em;
  }

  .last {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    flex: 1 1 12rem;
    min-width: 0;
    line-height: 1.5;
  }

  /* 指定步数：等宽、方框 */
  .steps-in {
    width: 7.5rem;
    padding: 0.55em 0.65em;
    border: var(--rule-w) solid var(--rule-strong);
    background: var(--paper-sunken);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .steps-in::placeholder {
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }

  .steps-in:focus {
    outline: none;
    border-color: var(--seal);
  }

  .loghead {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    margin: var(--sp-4) 0 var(--sp-3);
  }

  .loghead .hairline {
    flex: 1;
  }

  .log {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .log li {
    display: grid;
    grid-template-columns: 5.5rem 7rem 3.5rem 1fr auto;
    gap: var(--sp-3) var(--sp-4);
    padding: var(--sp-3) 0;
    border-bottom: var(--rule-w) solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
    letter-spacing: 0.04em;
    align-items: baseline;
  }

  .log .ok {
    color: var(--ink);
  }

  .log .bad {
    color: var(--seal);
    font-weight: 500;
  }

  .log .msg {
    color: var(--ink-faint);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .empty {
    margin: var(--sp-4) 0;
  }

  @media (max-width: 46rem) {
    .cols {
      grid-template-columns: 1fr;
    }

    .account {
      grid-template-columns: 1fr;
    }

    .account__badges {
      justify-content: flex-start;
    }

    .steps-now {
      font-size: var(--text-2xl);
    }

    .log li {
      grid-template-columns: 4.5rem 1fr;
      gap: var(--sp-1) var(--sp-3);
    }

    .log .msg {
      grid-column: 1 / -1;
      white-space: normal;
    }
  }
</style>

<script>
  /**
   * 状态面板：先问后台有没有登录，登录了才拉账号与记录。
   * 主页只显示备注（label），不显示账号。
   */
  type Account = {
    id: string;
    label: string;
    note: string;
    userMask: string;
    enabled: boolean;
    auto: boolean;
    beforeHour: number;
    beforeMinute: number;
    threshold: number;
    toMin: number;
    toMax: number;
    lastSteps: number;
    lastRunAt: number;
    lastRunMsg: string;
    lastRunOk: boolean;
  };

  type LogRow = {
    id: number;
    userMask: string;
    steps: number;
    ok: boolean;
    msg: string;
    ts: number;
    via: string;
  };

  const gate = document.querySelector<HTMLElement>('[data-gate]');
  const panel = document.querySelector<HTMLElement>('[data-panel]');
  const accountsEl = document.querySelector<HTMLElement>('[data-accounts]');
  const emptyEl = document.querySelector<HTMLElement>('[data-empty]');
  const logEl = document.querySelector<HTMLElement>('[data-log]');
  const logEmpty = document.querySelector<HTMLElement>('[data-log-empty]');

  function ruleSentence(a: Account): string {
    const hh = String(a.beforeHour).padStart(2, '0');
    const mm = String(a.beforeMinute).padStart(2, '0');
    return `每天 ${hh}:${mm} 前，若不足 ${a.threshold} 步，刷到 ${a.toMin}–${a.toMax}；过点未刷则补刷`;
  }

  function when(ms: number): string {
    if (!ms) return '';
    return new Date(ms).toLocaleString('zh-CN', { hour12: false }).replace(/\//g, '-');
  }

  async function api(path: string, body?: unknown) {
    const res = await fetch('/api/admin/' + path, {
      method: body === undefined ? 'GET' : 'POST',
      headers: body === undefined ? undefined : { 'content-type': 'application/json' },
      body: body === undefined ? undefined : JSON.stringify(body),
      cache: 'no-store',
    });
    let data: Record<string, unknown> = {};
    try {
      data = (await res.json()) as Record<string, unknown>;
    } catch {
      /* 非 JSON 当失败 */
    }
    return { ok: res.ok, data };
  }

  function paintAccounts(items: Account[]) {
    if (!accountsEl) return;
    accountsEl.textContent = '';
    if (emptyEl) emptyEl.hidden = items.length > 0;
    for (const a of items) {
      const li = document.createElement('li');
      li.className = 'account';

      // 主页只亮备注；没备注才退回脱敏名
      const user = document.createElement('div');
      user.className = 'account__user';
      user.textContent = a.label || a.userMask;

      const badges = document.createElement('div');
      badges.className = 'account__badges';
      for (const [txt, on] of [
        [a.enabled ? '启用' : '停用', a.enabled],
        [a.auto ? '自动' : '仅手动', a.auto],
      ] as const) {
        const b = document.createElement('span');
        b.className = 'badge' + (on ? ' badge--on' : '');
        b.textContent = txt;
        badges.appendChild(b);
      }

      const rule = document.createElement('p');
      rule.className = 'rule';
      rule.innerHTML = ruleSentence(a).replace(/(\d{2}:\d{2}|\d+)/g, '<b>$1</b>');

      const meta = document.createElement('div');
      meta.className = 'account__meta';

      const steps = document.createElement('span');
      steps.className = 'steps-now';
      steps.textContent = String(a.lastSteps || 0);

      const last = document.createElement('span');
      last.className = 'last';
      last.textContent = a.lastRunAt ? `上次 ${when(a.lastRunAt)} · ${a.lastRunMsg}` : '还没跑过';

      const num = document.createElement('input');
      num.type = 'number';
      num.min = '0';
      num.max = '98000';
      num.placeholder = '指定步数';
      num.className = 'steps-in';
      num.setAttribute('aria-label', '指定步数');

      const run = document.createElement('button');
      run.type = 'button';
      run.className = 'keylike';
      run.textContent = '刷步';
      run.addEventListener('click', async () => {
        const custom = num.value.trim();
        const payload: Record<string, unknown> = { id: a.id };
        if (custom !== '') {
          const n = Number(custom);
          if (!Number.isFinite(n) || n < 0) {
            run.textContent = '步数不对';
            setTimeout(() => {
              run.textContent = '刷步';
            }, 1200);
            return;
          }
          payload.steps = Math.trunc(n);
        }
        run.textContent = '正在刷…';
        run.setAttribute('disabled', '');
        const r = await api('steps-run', payload);
        run.removeAttribute('disabled');
        if (r.ok && r.data.ok) {
          run.textContent = `已刷到 ${String(r.data.steps ?? '')} 步`;
        } else {
          run.textContent = `没刷成：${String(r.data.error ?? '')}`;
        }
        setTimeout(() => {
          run.textContent = '刷步';
          void load();
        }, 1600);
      });

      meta.append(steps, last, num, run);
      li.append(user, badges, rule, meta);
      accountsEl.appendChild(li);
    }
  }

  function paintLog(rows: LogRow[]) {
    if (!logEl) return;
    logEl.textContent = '';
    if (logEmpty) logEmpty.hidden = rows.length > 0;
    for (const r of rows.slice(0, 20)) {
      const li = document.createElement('li');
      const ok = document.createElement('span');
      ok.className = r.ok ? 'ok' : 'bad';
      ok.textContent = r.ok ? `✓ ${r.steps}` : '✗';
      const who = document.createElement('span');
      who.textContent = r.userMask;
      const via = document.createElement('span');
      via.textContent = r.via === 'auto' ? '自动' : '手动';
      const msg = document.createElement('span');
      msg.className = 'msg';
      msg.textContent = r.msg;
      const ts = document.createElement('span');
      ts.textContent = when(r.ts);
      li.append(ok, who, via, msg, ts);
      logEl.appendChild(li);
    }
  }

  async function load() {
    const st = await api('state');
    if (!st.ok || !st.data.logged) {
      if (gate) gate.hidden = false;
      if (panel) panel.hidden = true;
      return;
    }
    if (gate) gate.hidden = true;
    if (panel) panel.hidden = false;

    const acc = await api('steps-list');
    paintAccounts(((acc.data.items as Account[]) ?? []) as Account[]);

    const hb = document.querySelector<HTMLElement>('[data-heartbeat]');
    if (hb) {
      const at = Number(acc.data.lastAutoAt || 0);
      hb.textContent = at
        ? `上次自动扫描 ${when(at)}`
        : '自动扫描尚未运行 · 点「执行自动规则」立刻跑一遍 · cron 每小时一次，过点会补刷';
    }

    const lg = await api('steps-log');
    paintLog(((lg.data.items as LogRow[]) ?? []) as LogRow[]);
  }

  document.querySelector('[data-refresh]')?.addEventListener('click', () => void load());
  document.querySelector('[data-run-auto]')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    btn.textContent = '执行中…';
    btn.setAttribute('disabled', '');
    const r = await api('steps-run-auto', {});
    btn.removeAttribute('disabled');
    if (r.ok) {
      const ran = Number(r.data.ran || 0);
      btn.textContent = ran ? `已刷 ${ran} 个` : '已评估，见记录';
      void load();
      setTimeout(() => {
        btn.textContent = '执行自动规则';
      }, 2000);
    } else {
      btn.textContent = `失败：${String(r.data.error ?? '')}`;
      setTimeout(() => {
        btn.textContent = '执行自动规则';
      }, 2400);
    }
  });
  document.addEventListener('astro:page-load', () => void load());
  void load();
</script>
