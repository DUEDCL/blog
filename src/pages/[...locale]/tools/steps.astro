---
/**
 * 刷步数 —— 往 Zepp Life 写步数，微信运动从那儿同步。
 *
 * 版式按对开大版的「服务台」排：
 * 页头（竖排标识 + 报头线）→ 说明栏（纸面 sheet）→ 状态台（登录后）→ 流水（细线表）。
 * 主页只显示**备注**，不显示账号 —— 账号是隐私，备注才是给他自己认的。
 *
 * 密码永不进这一页的 HTML（它是边缘缓存的公开页）。
 * 账号列表也只在登录后由 fetch 填，构建期只出骨架。
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALE_PARAMS, t, toLocale } from '../../../i18n';

export function getStaticPaths() {
  return LOCALE_PARAMS.map((params) => ({ params }));
}

const locale = toLocale(Astro.params.locale);
const strings = t(locale);
const s = strings.stepsTool;
---

<BaseLayout title={s.title} description={s.description} footerNote={s.note}>
  <header class="head glass-card rise rise-1">
    <div class="head__row">
      <span class="vlabel">{s.heading}</span>
      <h1 class="head__title">{s.title}</h1>
    </div>
    <div class="pressrule"></div>
    <p class="head__desc">{s.lead}</p>
  </header>

  <div class="cols rise rise-2">
    <section class="sheet brief">
      <h2 class="brief__h">{s.howTitle}</h2>
      <p>{s.how}</p>
    </section>
    <section class="sheet brief brief--dim">
      <h2 class="brief__h">{s.warnTitle}</h2>
      <p>{s.warn}</p>
    </section>
  </div>

  {/* 未登录：说清边界并给登录入口（登录后回跳到这一页） */}
  <section class="gate rise rise-2" data-gate>
    <p class="dim">{s.needLogin}</p>
    <a class="keylike" href={'/login?next=' + encodeURIComponent('/tools/steps')}>{s.goLogin} →</a>
  </section>

  {/* 登录后：一人一个账号、手动刷、自己的记录。自动刷步不在这页（只在后台）。 */}
  <section class="panel rise rise-3" data-panel hidden>
    <div class="panel__head">
      <h2 class="sub">{s.myAccount}</h2>
      <span class="dim" data-acc-sum></span>
    </div>

    <form class="mine" data-form autocomplete="off">
      <label class="mine__f">
        <span class="mine__lab">{s.fieldUser}</span>
        <input class="mine__in" data-f-user placeholder="手机号或邮箱" autocomplete="username" />
      </label>
      <label class="mine__f">
        <span class="mine__lab">{s.fieldPwd}</span>
        <input class="mine__in" data-f-pwd type="password" placeholder={s.pwdHint} autocomplete="current-password" />
      </label>
      <div class="mine__acts">
        <button class="keylike" type="submit" data-save>{s.save}</button>
        <button class="keylike keylike--quiet" type="button" data-del>{s.unbind}</button>
      </div>
    </form>
    <p class="dim msg" data-form-msg hidden></p>

    <div class="runbar">
      <input class="mine__in mine__in--num" data-run-steps type="number" min="0" max="98000" placeholder={s.stepsHint} aria-label={s.stepsHint} />
      <button class="keylike" type="button" data-run>{s.runNow}</button>
      <button class="keylike keylike--quiet" type="button" data-quick>{s.quick}</button>
    </div>
    <p class="dim msg" data-run-msg hidden></p>

    <div class="loghead">
      <h2 class="sub">{s.log}</h2>
      <div class="hairline"></div>
    </div>
    <ol class="log" data-log></ol>
    <p class="dim empty" data-log-empty hidden>{s.logEmpty}</p>
    <p class="dim">{s.autoNote}</p>
  </section>
</BaseLayout>

<style>
  .head {
    padding: var(--sp-8);
    margin-bottom: var(--sp-6);
  }

  .head__row {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .head__title {
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-right: auto;
  }

  .pressrule {
    margin-top: var(--sp-5);
  }

  .head__desc {
    margin-top: var(--sp-4);
    color: var(--ink-soft);
    font-size: var(--text-base);
    max-width: var(--measure-prose);
    line-height: var(--leading-normal);
  }

  /* 两栏说明：像报纸中缝分开的两块服务栏 */
  .cols {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: var(--gutter);
    margin-bottom: var(--sp-8);
    align-items: start;
  }

  .brief {
    padding: var(--sp-5) var(--sp-6);
    background: transparent;
    border: 1px solid var(--glass-border);
  }

  .brief--dim {
    background: transparent;
    border-color: var(--glass-border);
  }

  .panel {
    padding: var(--sp-6);
    background-color: var(--glass-under);
    background-image: linear-gradient(var(--glass-bg), var(--glass-bg));
    -webkit-backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    backdrop-filter: blur(var(--glass-blur)) saturate(var(--glass-saturate));
    border: 1px solid var(--glass-border);
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-glass);
  }

  .gate {
    padding: var(--sp-5);
    border: 1px solid var(--glass-border);
    border-radius: var(--r-lg);
    background: var(--glass-bg);
  }

  .brief__h {
    margin: 0 0 var(--sp-3);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--ink-faint);
    text-transform: none;
  }

  .brief p {
    margin: 0;
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-soft);
  }

  .dim {
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  .gate {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-4);
    margin-bottom: var(--sp-8);
  }

  .gate p {
    margin: 0;
  }

  .keylike {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    padding: 0.5em 1.05em;
    border: 1px solid var(--glass-border);
    border-radius: var(--r-md);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-decoration: none;
    cursor: pointer;
    background: var(--glass-bg);
    transition: border-color 0.18s ease, background-color 0.18s ease, color 0.18s ease;
  }

  .keylike:hover {
    border-color: var(--seal);
    color: var(--ink);
    background: var(--seal-wash);
  }

  .keylike--quiet {
    color: var(--ink-soft);
    border-color: var(--rule);
  }

  .panel__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-2);
  }

  .panel__acts {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .sub {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    margin: 0;
    letter-spacing: 0.02em;
  }

  .heartbeat {
    margin: 0 0 var(--sp-5);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--ink-faint);
  }

  /* 账号条：像报纸分类广告的整行 —— 左侧名号，右侧动作，条件句占满一行 */
  .accounts {
    list-style: none;
    margin: 0 0 var(--sp-10);
    padding: 0;
    display: grid;
    gap: var(--sp-3);
  }

  .account {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--sp-3) var(--sp-5);
    padding: var(--sp-5);
    border: 1px solid var(--glass-border);
    border-radius: var(--r-md);
    background: var(--glass-bg);
  }

  .account__user {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--ink);
    line-height: 1.2;
  }

  .account__badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
    justify-content: flex-end;
    align-items: start;
  }

  .badge {
    display: inline-flex;
    padding: 0.22em 0.6em;
    border: 1px solid var(--glass-border);
    border-radius: var(--r-full);
    background: var(--glass-bg);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: var(--ink-soft);
    white-space: nowrap;
    text-transform: uppercase;
  }

  .badge--on {
    border-color: var(--seal);
    color: var(--ink);
    background: var(--seal-wash);
  }

  /* 条件句 —— 签名。数字用等宽，下压一道朱红细线 */
  .rule {
    grid-column: 1 / -1;
    margin: 0;
    padding: var(--sp-2) 0 0;
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--ink-soft);
  }

  .rule b {
    font-family: var(--font-mono);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    color: var(--ink);
    border-bottom: 1px solid var(--press);
    padding-bottom: 1px;
  }

  .account__meta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3) var(--sp-5);
    margin-top: var(--sp-2);
    padding-top: var(--sp-4);
    border-top: var(--rule-w) solid var(--rule);
  }

  .steps-now {
    font-family: var(--font-mono);
    font-size: var(--text-3xl);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.01em;
    line-height: 1;
    color: var(--ink);
    min-width: 4.5ch;
  }

  .steps-now::after {
    content: ' 步';
    font-size: var(--text-sm);
    color: var(--ink-faint);
    letter-spacing: 0.12em;
    margin-left: 0.15em;
  }

  .last {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-faint);
    letter-spacing: 0.06em;
    flex: 1 1 12rem;
    min-width: 0;
    line-height: 1.5;
  }

  /* 指定步数：等宽、方框 */
  .steps-in {
    width: 7.5rem;
    padding: 0.55em 0.65em;
    border: var(--rule-w) solid var(--rule-strong);
    background: var(--paper-sunken);
    color: var(--ink);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }

  .steps-in::placeholder {
    color: var(--ink-faint);
    letter-spacing: 0.02em;
  }

  .steps-in:focus {
    outline: none;
    border-color: var(--seal);
  }

  .loghead {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    margin: var(--sp-4) 0 var(--sp-3);
  }

  .loghead .hairline {
    flex: 1;
  }

  .log {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .log li {
    display: grid;
    grid-template-columns: 5.5rem 7rem 3.5rem 1fr auto;
    gap: var(--sp-3) var(--sp-4);
    padding: var(--sp-3) 0;
    border-bottom: var(--rule-w) solid var(--rule);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    color: var(--ink-soft);
    letter-spacing: 0.04em;
    align-items: baseline;
  }

  .log .ok {
    color: var(--ink);
  }

  .log .bad {
    color: var(--seal);
    font-weight: 500;
  }

  .log .msg {
    color: var(--ink-faint);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .empty {
    margin: var(--sp-4) 0;
  }

  @media (max-width: 46rem) {
    .cols {
      grid-template-columns: 1fr;
    }

    .account {
      grid-template-columns: 1fr;
    }

    .account__badges {
      justify-content: flex-start;
    }

    .steps-now {
      font-size: var(--text-2xl);
    }

    .log li {
      grid-template-columns: 4.5rem 1fr;
      gap: var(--sp-1) var(--sp-3);
    }

    .log .msg {
      grid-column: 1 / -1;
      white-space: normal;
    }
  }

  /* ── 「帮您走走」的账号表单（R52）────────────────────────────────────── */
  .mine {
    display: grid;
    gap: var(--sp-3, 0.75rem);
    margin-top: var(--sp-4, 1rem);
  }

  .mine__f {
    display: grid;
    gap: 0.3rem;
  }

  .mine__lab {
    font-family: var(--font-mono);
    font-size: var(--text-xs, 0.75rem);
    letter-spacing: 0.1em;
    color: var(--ink-faint);
  }

  .mine__in {
    width: 100%;
    height: 2.6rem;
    padding: 0 0.8rem;
    border: 1px solid var(--glass-border);
    border-radius: var(--r-md);
    background: var(--glass-bg);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: var(--text-base, 1rem);
    outline: none;
  }

  .mine__in:focus {
    border-color: var(--seal);
    box-shadow: 0 0 0 3px var(--seal-wash);
  }

  .mine__in--num {
    max-width: 18rem;
    font-family: var(--font-mono);
  }

  .mine__acts,
  .runbar {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2, 0.5rem);
    align-items: center;
    margin-top: var(--sp-2, 0.5rem);
  }

  .msg {
    margin: var(--sp-2, 0.5rem) 0 0;
  }
</style>

<script>
  /**
   * 「帮您走走」的客户端（R52）。
   *
   * 与后台那套的区别写死在这里：**这页只管当前登录用户自己的一个 Zepp 账号，
   * 只有手动刷，没有自动规则**。自动刷步的情况只在 /admin 的「刷步」面板里看。
   *
   * 账号与密码只进不出：保存之后服务端只回脱敏名，页面上永远没有明文。
   */
  type LogRow = { id: number; steps: number; ok: number; msg: string; ts: number };
  type Account = {
    userMask: string;
    enabled: boolean;
    lastSteps: number;
    lastRunAt: number;
    lastOk: boolean;
    lastMsg: string;
  };

  const gate = document.querySelector<HTMLElement>('[data-gate]');
  const panel = document.querySelector<HTMLElement>('[data-panel]');
  const form = document.querySelector<HTMLFormElement>('[data-form]');
  const userIn = document.querySelector<HTMLInputElement>('[data-f-user]');
  const pwdIn = document.querySelector<HTMLInputElement>('[data-f-pwd]');
  const stepsIn = document.querySelector<HTMLInputElement>('[data-run-steps]');
  const accSum = document.querySelector<HTMLElement>('[data-acc-sum]');
  const formMsg = document.querySelector<HTMLElement>('[data-form-msg]');
  const runMsg = document.querySelector<HTMLElement>('[data-run-msg]');
  const logEl = document.querySelector<HTMLElement>('[data-log]');
  const logEmpty = document.querySelector<HTMLElement>('[data-log-empty]');

  const say = (el: HTMLElement | null, text: string) => {
    if (!el) return;
    el.textContent = text;
    el.hidden = !text;
  };

  function when(ms: number): string {
    if (!ms) return '';
    return new Date(ms).toLocaleString('zh-CN', { hour12: false }).replace(/\//g, '-');
  }

  async function api(path: string, body?: unknown) {
    const res = await fetch('/api/site/' + path, {
      method: body === undefined ? 'GET' : 'POST',
      headers: body === undefined ? undefined : { 'content-type': 'application/json' },
      body: body === undefined ? undefined : JSON.stringify(body),
      cache: 'no-store',
    });
    let data: Record<string, unknown> = {};
    try {
      data = (await res.json()) as Record<string, unknown>;
    } catch {
      /* 非 JSON 当失败 */
    }
    return { ok: res.ok, status: res.status, data };
  }

  function paintAccount(a: Account | null) {
    if (!accSum) return;
    if (!a) {
      accSum.textContent = '还没绑定 Zepp 账号';
      return;
    }
    accSum.textContent =
      a.userMask +
      (a.lastRunAt
        ? ' · 上次 ' + when(a.lastRunAt) + ' · ' + (a.lastOk ? '✓ ' + a.lastSteps + ' 步' : '✗ ' + a.lastMsg)
        : ' · 还没刷过');
  }

  function paintLog(rows: LogRow[]) {
    if (!logEl) return;
    logEl.textContent = '';
    if (logEmpty) logEmpty.hidden = rows.length > 0;
    for (const r of rows) {
      const li = document.createElement('li');
      const ok = document.createElement('span');
      ok.className = r.ok ? 'ok' : 'bad';
      ok.textContent = r.ok ? '✓ ' + r.steps : '✗';
      const msg = document.createElement('span');
      msg.className = 'msg';
      msg.textContent = r.msg;
      const ts = document.createElement('span');
      ts.textContent = when(r.ts);
      li.append(ok, msg, ts);
      logEl.appendChild(li);
    }
  }

  async function load() {
    const r = await api('steps');
    const logged = !!(r.data && r.data.logged);
    if (gate) gate.hidden = logged;
    if (panel) panel.hidden = !logged;
    if (!logged) return;

    paintAccount((r.data.account as Account | null) ?? null);
    paintLog(((r.data.log as LogRow[]) ?? []) as LogRow[]);
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const user = (userIn?.value || '').trim();
    const pwd = pwdIn?.value || '';
    if (!user) return say(formMsg, '填一下 Zepp 账号');
    say(formMsg, '正在保存…');
    const r = await api('steps-save', { user, pwd });
    if (!r.ok || !r.data.ok) return say(formMsg, '没存上：' + String(r.data.error ?? ''));
    if (pwdIn) pwdIn.value = '';
    say(formMsg, '已保存。密码只存在服务端，页面上不会再显示。');
    void load();
  });

  document.querySelector('[data-del]')?.addEventListener('click', async () => {
    if (!confirm('解除绑定？保存的 Zepp 账号会被删掉。')) return;
    const r = await api('steps-del', {});
    say(formMsg, r.ok ? '已解除绑定' : '没删成：' + String(r.data.error ?? ''));
    void load();
  });

  const runOne = async (path: string, body: Record<string, unknown>) => {
    say(runMsg, '正在刷…（要登录 Zepp，慢一点）');
    const r = await api(path, body);
    if (r.ok && r.data.ok) say(runMsg, '已刷到 ' + String(r.data.steps) + ' 步');
    else say(runMsg, '没刷成：' + String(r.data.error ?? ''));
    void load();
  };

  document.querySelector('[data-run]')?.addEventListener('click', () => {
    const raw = (stepsIn?.value || '').trim();
    const body: Record<string, unknown> = {};
    if (raw) body.steps = Number(raw);
    void runOne('steps-run', body);
  });

  document.querySelector('[data-quick]')?.addEventListener('click', () => {
    const user = (userIn?.value || '').trim();
    const pwd = pwdIn?.value || '';
    if (!user || !pwd) return say(runMsg, '临时刷要在这两个框里填账号和密码');
    const raw = (stepsIn?.value || '').trim();
    const body: Record<string, unknown> = { user, pwd };
    if (raw) body.steps = Number(raw);
    void runOne('steps-quick', body);
  });

  document.addEventListener('astro:page-load', () => void load());
  void load();
</script>
