---
/**
 * 工具 —— 站上常驻功能的目录。
 *
 * 与音乐同类：不是内容栏目，是入口。版面走报纸分类的「服务台」：
 * 页头 + 报头线 + 一条条索引（以后还会加）。
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { LOCALE_PARAMS, localePath, t, toLocale } from '../../../i18n';

export function getStaticPaths() {
  return LOCALE_PARAMS.map((params) => ({ params }));
}

const locale = toLocale(Astro.params.locale);
const strings = t(locale);
const s = strings.tools;
const stepsHref = localePath(locale, '/tools/steps');
---

<BaseLayout title={s.title} description={s.description} footerNote={s.note}>
  <header class="head glass-card rise rise-1">
    <div class="head__row">
      <span class="vlabel">{s.heading}</span>
      <h1 class="head__title">{s.title}</h1>
    </div>
    <div class="pressrule"></div>
    <p class="head__desc">{s.lead}</p>
  </header>

  <ul class="briefs rise rise-2">
    <li class="brief">
      <a href={stepsHref}>
        <span class="brief__main">
          <span class="brief__title">{s.cardSteps.title}</span>
          <span class="brief__blurb">{s.cardSteps.blurb}</span>
        </span>
        <span class="brief__side">
          <span class="chip">{s.statusReady}</span>
          <span class="meta go">{s.cardSteps.go} →</span>
        </span>
      </a>
    </li>
    {/* 步数管家（R48）的入口 R52 撤掉了 —— 站主说「隐藏工具『步数管家』」。
        页面与接口都还在（/bushu 照旧能开、卡密照旧能兑），只是工具目录里不再挂它。
        要恢复就在这个位置把那张 <li> 加回来。 */}
    {/* 影视聚合（/tv）。同一条理由：只有中文形态，所以不挂 en/ja 入口。 */}
    {locale === 'zh' && (
      <li class="brief">
        <a href="/tv">
          <span class="brief__main">
            <span class="brief__title">沉麟看剧</span>
            <span class="brief__blurb">
              多个公开采集站并发搜索，自动挑最清晰能播的线路；追剧、断点续播，记录按账号分开。
            </span>
          </span>
          <span class="brief__side">
            <span class="chip">在线</span>
            <span class="meta go">进入 →</span>
          </span>
        </a>
      </li>
    )}
  </ul>
</BaseLayout>

<style>
  .head {
    padding: var(--sp-8);
    margin-bottom: var(--sp-10);
  }

  .head__row {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .head__title {
    font-size: var(--text-3xl);
    letter-spacing: -0.02em;
    line-height: 1.05;
    margin-right: auto;
  }

  .pressrule {
    margin-top: var(--sp-5);
  }

  .head__desc {
    margin-top: var(--sp-4);
    color: var(--ink-soft);
    font-size: var(--text-base);
    max-width: var(--measure-prose);
    line-height: var(--leading-normal);
  }

  /* 目录条目：标题左、一句话跟在下面、状态与入口靠右。
     顶上不再另画朱红 —— 页头的 pressrule 已经是那一笔，再来一道会变成双线。 */
  .briefs {
    border-top: var(--rule-w) solid var(--rule-strong);
  }

  .brief > a {
    align-items: flex-start;
    padding: var(--sp-6) 0;
  }

  .brief__main {
    display: grid;
    gap: var(--sp-2);
    min-width: 0;
  }

  .brief__title {
    font-size: var(--text-xl);
  }

  .brief__blurb {
    color: var(--ink-soft);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    max-width: 36rem;
  }

  .brief__side {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-4);
    flex-shrink: 0;
    padding-top: 0.35em;
  }

  .chip {
    display: inline-flex;
    padding: 0.3em 0.72em;
    border: 1px solid var(--seal);
    border-radius: var(--r-full);
    background: var(--seal-wash);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.1em;
    color: var(--ink);
    text-transform: uppercase;
  }

  .go {
    letter-spacing: 0.14em;
    color: var(--ink-faint);
    transition: color 0.18s ease;
  }

  .brief > a:hover .go {
    color: var(--ink);
  }

  .brief > a:hover .brief__title {
    color: var(--seal);
  }

  @media (max-width: 46rem) {
    .brief > a {
      flex-direction: column;
      gap: var(--sp-3);
    }

    .brief__side {
      width: 100%;
      justify-content: space-between;
    }
  }
</style>
