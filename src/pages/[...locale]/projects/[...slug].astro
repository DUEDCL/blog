---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import FormattedDate from '../../../components/FormattedDate.astro';
import { localized, tagHref, tagName, translationOf } from '../../../utils/content';
import { DEFAULT_LOCALE, LOCALE_PARAMS, localePath, t, toLocale } from '../../../i18n';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) =>
    import.meta.env.DEV ? true : data.draft !== true
  );

  return LOCALE_PARAMS.flatMap(({ locale }) =>
    projects.map((project) => ({
      params: { locale, slug: project.id },
      props: { project },
    }))
  );
}

const { project } = Astro.props;
const locale = toLocale(Astro.params.locale);
const strings = t(locale);

/* 作品详情页不走 ArticleLayout（它自己有状态角标与两条外链），所以译文与
   「只有中文原文」那条提示在这一页里各自接一遍 —— 与 posts/notes 同一套规则。 */
const translation = await translationOf('projects', project.id, locale);
const meta = localized(project.data, locale, translation);
const { Content } = await render(translation ?? project);
const onlyOriginal = locale !== DEFAULT_LOCALE && !translation;

const backHref = localePath(locale, '/projects');
---

<BaseLayout
  title={meta.title}
  description={meta.description ?? ''}
  type="article"
  publishedAt={project.data.pubDate}
  image={project.data.cover?.src}
  width="prose"
>
  <article>
    <header class="head rise rise-1">
      <p class="meta crumbs">
        <a href={backHref}>{strings.sections.projects.title}</a>
      </p>

      <div class="titleline">
        <h1 class="title">{meta.title}</h1>
        <span class:list={['badge', `badge--${project.data.status}`]}>
          {strings.projects.status[project.data.status]}
        </span>
      </div>

      <p class="dek">{meta.description}</p>

      <div class="stamps meta">
        <FormattedDate date={project.data.pubDate} />
      </div>

      {(project.data.link || project.data.repo) && (
        <p class="links">
          {project.data.link && (
            <a href={project.data.link} target="_blank" rel="noopener">
              {strings.projects.live}
            </a>
          )}
          {project.data.repo && (
            <a href={project.data.repo} target="_blank" rel="noopener">
              {strings.projects.repo}
            </a>
          )}
        </p>
      )}

      {project.data.tags.length > 0 && (
        <ul class="tags">
          {project.data.tags.map((tag) => (
            <li>
              <a class="tag" href={tagHref(tag, locale)}>{tagName(tag, locale)}</a>
            </li>
          ))}
        </ul>
      )}

      <div class="hairline"></div>

      {onlyOriginal && <p class="original meta">{strings.article.onlyInChinese}</p>}
    </header>

    {project.data.cover && (
      <figure class="cover rise rise-2">
        <Image
          src={project.data.cover}
          alt={project.data.coverAlt ?? ''}
          widths={[480, 800, 1200]}
          loading="eager"
        />
      </figure>
    )}

    <div class="prose rise rise-3">
      <Content />
    </div>
  </article>

  <nav class="back">
    <a href={backHref}>{strings.article.backTo(strings.sections.projects.title)}</a>
  </nav>
</BaseLayout>

<style>
  /* R44：与文章页（ArticleLayout）同一套页头语汇 —— 去掉玻璃卡，靠字号与一道线分层。
     同一个站里「作品详情」和「文章详情」应该长得像同一份刊物的两页。 */
  .head {
    padding-top: var(--sp-8);
  }

  .crumbs a {
    text-decoration: none;
    color: var(--ink-faint);
  }

  .crumbs a:hover {
    color: var(--seal);
  }

  .titleline {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
    margin-top: var(--sp-4);
    flex-wrap: wrap;
  }

  .title {
    font-size: var(--text-headline);
    font-variation-settings: 'opsz' 48, 'SOFT' 0, 'WONK' 0;
    letter-spacing: -0.015em;
    line-height: 1.16;
  }

  /* 状态戳：方框（与作品列表页那枚一致） */
  .badge {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    padding: 0.2em 0.55em;
    border: var(--rule-w) solid currentColor;
  }

  .badge--active {
    color: var(--seal);
  }

  .badge--wip {
    color: var(--press);
  }

  .badge--archived {
    color: var(--ink-faint);
  }

  .dek {
    margin-top: var(--sp-5);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--ink-soft);
  }

  .stamps {
    margin-top: var(--sp-6);
  }

  /* 外链是这一页唯一「去别处」的动作，所以给它方框（比纯文字链重一档），
     但不上浮、不换边框 —— 那三样加起来是按钮的语汇，这里只需要「可点」 */
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin: var(--sp-6) 0 0;
  }

  .links a {
    display: inline-block;
    padding: var(--sp-2) var(--sp-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--seal);
    border: var(--rule-w) solid var(--rule-strong);
    transition: color 0.18s ease, background-color 0.24s ease,
      border-color 0.18s ease;
  }

  .links a:hover {
    color: var(--seal-hover);
    background: var(--seal-wash);
    border-color: var(--seal);
  }

  /* 关键词退成等宽小字（与文章页一致） */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin: var(--sp-6) 0 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .tag::before {
    content: '#';
    opacity: 0.55;
    margin-right: 0.15em;
  }

  .tag:hover {
    color: var(--seal);
  }

  .hairline {
    margin-top: var(--sp-6);
  }

  .cover {
    margin: var(--sp-8) 0 0;
  }

  .cover :global(img) {
    border: var(--rule-w) solid var(--rule);
  }

  .prose {
    margin-top: var(--sp-8);
  }

  .back {
    margin-top: var(--sp-16);
    padding-top: var(--sp-6);
    border-top: var(--rule-w) solid var(--rule-strong);
  }

  .back a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--ink-faint);
    transition: color 0.18s ease;
  }

  .back a:hover {
    color: var(--seal);
  }

  @media (max-width: 40rem) {
    .title {
      font-size: var(--text-2xl);
    }
  }
</style>
