---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getPublished } from '../../utils/content';
import { SECTIONS } from '../../consts';

const projects = await getPublished('projects');

const STATUS_LABEL = {
  active: '在用',
  wip: '进行中',
  archived: '已归档',
} as const;
---

<BaseLayout
  title={SECTIONS.projects.title}
  description={SECTIONS.projects.description}
  footerNote={SECTIONS.projects.note}
  width="broad"
>
  {/* R44 从「玻璃卡片网格」改成一栏索引。判据是内容本身：五个作品**一个都没有封面图**
      （`grep cover: src/content/projects/*.md` 返回 0），所以那套卡片渲染出来就是
      五个纯文字方块排成格子 —— 图片位一直是空的，格子只剩边框在起作用。
      改成一栏之后每条能放下更长的描述，也不会在作品数是奇数时留一个空格子。
      封面支持没有删：填了 cover 的作品会在左侧多一张方图。 */}
  <header class="head rise rise-1">
    <div class="head__row">
      <span class="vlabel">{SECTIONS.projects.label}</span>
      <h1 class="head__title">{SECTIONS.projects.title}</h1>
      <p class="meta head__count">共 {projects.length} 个</p>
    </div>
    <div class="pressrule"></div>
  </header>

  {projects.length > 0 ? (
    <ul class="works rise rise-2">
      {projects.map((p) => (
        <li class="work">
          <a href={`/projects/${p.id}`} class="work__main">
            {p.data.cover && (
              <div class="work__shot">
                <Image
                  src={p.data.cover}
                  alt={p.data.coverAlt ?? ''}
                  widths={[200, 400]}
                  loading="lazy"
                />
              </div>
            )}

            <div class="work__body">
              <div class="work__top">
                <h2 class="work__title">{p.data.title}</h2>
                <span class:list={['badge', `badge--${p.data.status}`]}>
                  {STATUS_LABEL[p.data.status]}
                </span>
              </div>

              <p class="work__desc">{p.data.description}</p>
            </div>
          </a>

          <div class="work__foot">
            <p class="meta work__date">
              <FormattedDate date={p.data.pubDate} />
            </p>

            {p.data.tags.length > 0 && (
              <p class="meta work__tags">
                {p.data.tags.slice(0, 4).map((t) => (
                  <span class="work__tag">{t}</span>
                ))}
              </p>
            )}

            {/* 外链在主链接外层，避免嵌套 <a> */}
            {(p.data.link || p.data.repo) && (
              <p class="work__links">
                {p.data.link && (
                  <a href={p.data.link} target="_blank" rel="noopener">线上 ↗</a>
                )}
                {p.data.repo && (
                  <a href={p.data.repo} target="_blank" rel="noopener">源码 ↗</a>
                )}
              </p>
            )}
          </div>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">{SECTIONS.projects.empty}</p>
  )}
</BaseLayout>

<style>
  .head {
    padding-top: var(--sp-8);
  }

  .head__row {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .head__title {
    font-size: var(--text-3xl);
    font-variation-settings: 'opsz' 40, 'SOFT' 0, 'WONK' 0;
    letter-spacing: 0.04em;
    line-height: 1;
    margin-right: auto;
  }

  .head__count {
    flex-shrink: 0;
  }

  .pressrule {
    margin-top: var(--sp-5);
  }

  .works {
    list-style: none;
    margin: var(--sp-8) 0 0;
    padding: 0;
    border-bottom: var(--rule-w) solid var(--rule-strong);
  }

  .work {
    border-top: var(--rule-w) solid var(--rule-strong);
    padding-block: var(--sp-6);
    transition: background-color 0.2s ease;
  }

  /* hover 只换底色，不上浮、不换边框、不加阴影（上一版三样都做，加 0.24s 的
     translateY(-3px)）—— 宪法第 4 条：不携带信息的动效删掉 */
  .work:hover {
    background: var(--seal-wash);
  }

  .work__main {
    display: flex;
    gap: var(--sp-6);
    text-decoration: none;
  }

  /* 方图。这一版全站只有浮层是圆角，图一律切方 */
  .work__shot {
    width: 7rem;
    flex-shrink: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: var(--rule-w) solid var(--rule);
    background: var(--paper-sunken);
  }

  .work__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .work__body {
    min-width: 0;
  }

  .work__top {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
  }

  .work__title {
    font-size: var(--text-xl);
    font-variation-settings: 'opsz' 24, 'SOFT' 0, 'WONK' 0;
    transition: color 0.18s ease;
  }

  .work__main:hover .work__title {
    color: var(--seal);
  }

  /* 状态标记：方框（上一版是 --r-full 药丸）。它是印在条目上的一枚戳，不是按钮 */
  .badge {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    padding: 0.2em 0.55em;
    border: var(--rule-w) solid currentColor;
  }

  .badge--active {
    color: var(--seal);
  }

  .badge--wip {
    color: var(--press);
  }

  .badge--archived {
    color: var(--ink-faint);
  }

  .work__desc {
    margin-top: var(--sp-3);
    font-size: var(--text-base);
    line-height: var(--leading-normal);
    color: var(--ink-soft);
    max-width: 46rem;
  }

  /* 元信息一行：日期 · 关键词 · 外链。上一版把外链放在卡片底部一条带底色的栏里
     （`background: rgba(0,0,0,.12)`—— 那个写死的黑在浅色版次上是一道脏灰） */
  .work__foot {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-6);
    margin-top: var(--sp-4);
  }

  .work__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  .work__tag::before {
    content: '#';
    color: var(--seal);
    opacity: 0.7;
  }

  .work__links {
    display: flex;
    gap: var(--sp-5);
    margin: 0;
    margin-left: auto;
  }

  .work__links a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--ink-faint);
    transition: color 0.18s ease;
  }

  .work__links a:hover {
    color: var(--seal);
  }

  .empty {
    margin-top: var(--sp-8);
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  @media (max-width: 46rem) {
    .head__title {
      font-size: var(--text-2xl);
    }

    .work__main {
      gap: var(--sp-4);
    }

    .work__shot {
      width: 5rem;
    }

    .work__links {
      margin-left: 0;
    }
  }
</style>
