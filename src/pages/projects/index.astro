---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getPublished } from '../../utils/content';
import { SECTIONS } from '../../consts';

const projects = await getPublished('projects');

const STATUS_LABEL = {
  active: '在用',
  wip: '进行中',
  archived: '已归档',
} as const;
---

<BaseLayout title={SECTIONS.projects.title} description={SECTIONS.projects.description}>
  <header class="head rise rise-1">
    <h1 class="head__title">{SECTIONS.projects.title}</h1>
    <p class="head__desc">{SECTIONS.projects.description}</p>
    <p class="head__count meta">共 {projects.length} 个</p>
  </header>

  {projects.length > 0 ? (
    <ul class="cards rise rise-2">
      {projects.map((p) => (
        <li class="card">
          <a href={`/projects/${p.id}`} class="card__main">
            {p.data.cover && (
              <div class="card__shot">
                <Image
                  src={p.data.cover}
                  alt={p.data.coverAlt ?? ''}
                  widths={[400, 800]}
                  loading="lazy"
                />
              </div>
            )}

            <div class="card__text">
              <div class="card__top">
                <h2 class="card__title">{p.data.title}</h2>
                <span class:list={['badge', `badge--${p.data.status}`]}>
                  {STATUS_LABEL[p.data.status]}
                </span>
              </div>

              <p class="card__desc">{p.data.description}</p>

              {p.data.tags.length > 0 && (
                <p class="card__tags meta">
                  {p.data.tags.slice(0, 4).map((t) => (
                    <span class="card__tag">{t}</span>
                  ))}
                </p>
              )}

              <p class="card__date meta">
                <FormattedDate date={p.data.pubDate} />
              </p>
            </div>
          </a>

          {/* 外链单独放在卡片外层，避免嵌套 <a> */}
          {(p.data.link || p.data.repo) && (
            <p class="card__links">
              {p.data.link && (
                <a href={p.data.link} target="_blank" rel="noopener">
                  线上 ↗
                </a>
              )}
              {p.data.repo && (
                <a href={p.data.repo} target="_blank" rel="noopener">
                  源码 ↗
                </a>
              )}
            </p>
          )}
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">{SECTIONS.projects.empty}</p>
  )}
</BaseLayout>

<style>
  .head {
    padding-bottom: var(--sp-8);
    border-bottom: 1px solid var(--rule);
  }

  .head__title {
    font-size: var(--text-3xl);
    font-variation-settings: 'opsz' 40;
    letter-spacing: -0.02em;
  }

  .head__desc {
    margin-top: var(--sp-4);
    max-width: 34rem;
    color: var(--ink-soft);
    font-size: var(--text-lg);
  }

  .head__count {
    margin-top: var(--sp-6);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(20rem, 1fr));
    gap: var(--sp-6);
    list-style: none;
    margin: var(--sp-12) 0 0;
    padding: 0;
  }

  .card {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--paper-raised);
    overflow: hidden;
    transition: border-color 0.24s ease, transform 0.24s cubic-bezier(0.2, 0.7, 0.3, 1),
      box-shadow 0.24s ease;
  }

  .card:hover {
    border-color: var(--rule-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-lift);
  }

  .card__main {
    display: block;
    text-decoration: none;
    flex: 1;
  }

  .card__shot {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    background: var(--paper-sunken);
  }

  .card__shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .card__text {
    padding: var(--sp-6);
  }

  .card__top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-3);
  }

  .card__title {
    font-size: var(--text-lg);
    font-variation-settings: 'opsz' 18;
    transition: color 0.18s ease;
  }

  .card__main:hover .card__title {
    color: var(--seal);
  }

  .badge {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    padding: 0.15em 0.5em;
    border-radius: 2px;
    border: 1px solid currentColor;
  }

  .badge--active {
    color: var(--seal);
    background: var(--seal-wash);
  }

  .badge--wip {
    color: var(--ink-soft);
  }

  .badge--archived {
    color: var(--ink-faint);
  }

  .card__desc {
    margin-top: var(--sp-3);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-soft);
  }

  .card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-4);
  }

  .card__tag::before {
    content: '#';
    color: var(--rule-strong);
  }

  .card__date {
    margin-top: var(--sp-4);
  }

  .card__links {
    display: flex;
    gap: var(--sp-6);
    margin: 0;
    padding: var(--sp-3) var(--sp-6);
    border-top: 1px solid var(--rule);
    background: var(--paper-sunken);
  }

  .card__links a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    text-decoration: none;
    color: var(--ink-soft);
  }

  .card__links a:hover {
    color: var(--seal);
  }

  .empty {
    margin-top: var(--sp-12);
    padding: var(--sp-8) 0;
    border-top: 1px solid var(--rule);
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  @media (max-width: 40rem) {
    .head__title {
      font-size: var(--text-2xl);
    }
  }
</style>
