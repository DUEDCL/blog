---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getPublished } from '../../utils/content';
import { SECTIONS } from '../../consts';

const albums = await getPublished('photos');
---

<BaseLayout
  title={SECTIONS.photos.title}
  description={SECTIONS.photos.description}
  width="wide"
>
  <header class="head glass rise rise-1">
    <h1 class="head__title">{SECTIONS.photos.title}</h1>
    <p class="head__desc">{SECTIONS.photos.description}</p>
    <p class="head__count meta">
      共 {albums.length} 组
    </p>
  </header>

  {albums.length > 0 ? (
    <ul class="grid rise rise-2">
      {albums.map((album, i) => (
        <li class:list={['cell', { 'cell--tall': i % 5 === 0 }]}>
          <a href={`/photos/${album.id}`} class="cell__link">
            <Image
              src={album.data.cover}
              alt={album.data.coverAlt}
              widths={[400, 800, 1200]}
              loading={i < 3 ? 'eager' : 'lazy'}
            />

            <div class="cell__overlay">
              <span class="cell__title">{album.data.title}</span>
              <span class="cell__meta meta">
                {album.data.location && <span>{album.data.location}</span>}
                <FormattedDate date={album.data.pubDate} />
                {album.data.images.length > 0 && (
                  <span>{album.data.images.length + 1} 张</span>
                )}
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty glass">{SECTIONS.photos.empty}</p>
  )}
</BaseLayout>

<style>
  .head {
    padding: var(--sp-12);
    border-radius: var(--r-xl);
  }

  .head__title {
    font-size: var(--text-3xl);
    font-variation-settings: 'opsz' 40, 'SOFT' 0, 'WONK' 0;
    letter-spacing: -0.02em;
  }

  .head__desc {
    margin-top: var(--sp-4);
    color: var(--ink-soft);
    font-size: var(--text-lg);
  }

  .head__count {
    margin-top: var(--sp-6);
  }

  /* 密排网格：每第 5 张跨两行，打破整齐的方格感 */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
    grid-auto-rows: 14rem;
    gap: var(--sp-3);
    list-style: none;
    margin: var(--sp-8) 0 0;
    padding: 0;
  }

  .cell--tall {
    grid-row: span 2;
  }

  .cell__link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: var(--r-lg);
    border: 1px solid var(--glass-border);
    background: var(--glass-bg);
    text-decoration: none;
    transition: box-shadow 0.4s ease, border-color 0.24s ease;
  }

  .cell__link:hover {
    border-color: var(--glass-border-lit);
    box-shadow: 0 18px 40px -14px rgba(0, 0, 0, 0.6);
  }

  .cell__link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition: transform 0.6s cubic-bezier(0.2, 0.7, 0.3, 1), filter 0.4s ease;
  }

  .cell__link:hover :global(img) {
    transform: scale(1.04);
    filter: saturate(1.05);
  }

  /* 说明文字压在图片上，默认半隐，hover 浮现。底部一层玻璃保证文字可读 */
  .cell__overlay {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-6) var(--sp-4) var(--sp-4);
    background: linear-gradient(to top, rgba(6, 6, 10, 0.72), transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    -webkit-mask-image: linear-gradient(to top, #000 55%, transparent);
    mask-image: linear-gradient(to top, #000 55%, transparent);
    color: #f2f4f8;
    transform: translateY(0.5rem);
    opacity: 0.85;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1), opacity 0.3s ease;
  }

  .cell__link:hover .cell__overlay,
  .cell__link:focus-visible .cell__overlay {
    transform: none;
    opacity: 1;
  }

  .cell__title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .cell__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    /* 覆盖 .meta 的颜色：图片上必须用亮色 */
    color: rgba(242, 244, 248, 0.78);
  }

  .empty {
    margin-top: var(--sp-8);
    padding: var(--sp-8);
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  @media (max-width: 52rem) {
    .head {
      padding: var(--sp-8);
    }

    .head__title {
      font-size: var(--text-2xl);
    }

    .grid {
      grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
      grid-auto-rows: 11rem;
    }
  }
</style>
