---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getPublished } from '../../utils/content';
import { SECTIONS } from '../../consts';

const albums = await getPublished('photos');
---

<BaseLayout
  title={SECTIONS.photos.title}
  description={SECTIONS.photos.description}
  footerNote={SECTIONS.photos.note}
  width="wide"
>
  <header class="head rise rise-1">
    <div class="head__row">
      <span class="vlabel">{SECTIONS.photos.label}</span>
      <h1 class="head__title">{SECTIONS.photos.title}</h1>
      <p class="meta head__count">共 {albums.length} 组</p>
    </div>
    <div class="pressrule"></div>
  </header>

  {albums.length > 0 ? (
    <ul class="grid rise rise-2">
      {albums.map((album, i) => (
        <li class:list={['cell', { 'cell--tall': i % 5 === 0 }]}>
          <a href={`/photos/${album.id}`} class="cell__link">
            <Image
              src={album.data.cover}
              alt={album.data.coverAlt}
              widths={[400, 800, 1200]}
              loading={i < 3 ? 'eager' : 'lazy'}
            />

            <div class="cell__overlay">
              <span class="cell__title">{album.data.title}</span>
              <span class="cell__meta meta">
                {album.data.location && <span>{album.data.location}</span>}
                <FormattedDate date={album.data.pubDate} />
                {album.data.images.length > 0 && (
                  <span>{album.data.images.length + 1} 张</span>
                )}
              </span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="empty">{SECTIONS.photos.empty}</p>
  )}
</BaseLayout>

<style>
  .head {
    padding-top: var(--sp-8);
  }

  .head__row {
    display: flex;
    align-items: baseline;
    gap: var(--sp-4);
  }

  .head__title {
    font-size: var(--text-3xl);
    font-variation-settings: 'opsz' 40, 'SOFT' 0, 'WONK' 0;
    letter-spacing: 0.04em;
    line-height: 1;
    margin-right: auto;
  }

  .head__count {
    flex-shrink: 0;
  }

  .pressrule {
    margin-top: var(--sp-5);
  }

  /* 密排网格：每第 5 张跨两行，打破整齐的方格感。
     用 auto-fit 而不是 auto-fill —— 相册只有两三组时 auto-fill 会留下空轨道，
     右半屏一片空白；auto-fit 会把空轨道折叠掉，让现有相册铺满整行。 */
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    grid-auto-rows: 14rem;
    gap: var(--sp-3);
    list-style: none;
    margin: var(--sp-8) 0 0;
    padding: 0;
  }

  .cell--tall {
    grid-row: span 2;
  }

  /* 直角（R44）：印刷品上的图是切方的。描边用规则线，与全站分栏线同一档 */
  .cell__link {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border: var(--rule-w) solid var(--rule-strong);
    background: var(--paper-sunken);
    text-decoration: none;
    transition: border-color 0.24s ease;
  }

  .cell__link:hover {
    border-color: var(--seal);
  }

  .cell__link :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9);
    transition: filter 0.4s ease;
  }

  /* R44 删掉了 hover 时的 `transform: scale(1.04)` 与那道 40px 落影：
     图片放大是「可点」的常见套路，但它不报告任何东西（宪法第 4 条）。
     留下的饱和度变化很轻，作用是「这一张被选中了」—— 换句话说它替代的是
     hover 高亮，不是动画。 */
  .cell__link:hover :global(img) {
    filter: saturate(1.05);
  }

  /* 说明文字压在图片上，默认半隐，hover 浮现。底部一层玻璃保证文字可读 */
  .cell__overlay {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-6) var(--sp-4) var(--sp-4);
    background: linear-gradient(to top, rgba(5, 4, 3, 0.74), transparent);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    -webkit-mask-image: linear-gradient(to top, #000 55%, transparent);
    mask-image: linear-gradient(to top, #000 55%, transparent);
    color: var(--sand-50);
    transform: translateY(0.5rem);
    opacity: 0.85;
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1), opacity 0.3s ease;
  }

  .cell__link:hover .cell__overlay,
  .cell__link:focus-visible .cell__overlay {
    transform: none;
    opacity: 1;
  }

  .cell__title {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 600;
  }

  .cell__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    /* 覆盖 .meta 的颜色：图片上必须用亮色 */
    color: rgba(215, 214, 213, 0.78);
  }

  .empty {
    margin-top: var(--sp-8);
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  @media (max-width: 52rem) {
    .head__title {
      font-size: var(--text-2xl);
    }

    .grid {
      grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
      grid-auto-rows: 11rem;
    }
  }
</style>
