---
import { getCollection, render } from 'astro:content';
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SECTIONS } from '../../consts';

export async function getStaticPaths() {
  const albums = await getCollection('photos', ({ data }) =>
    import.meta.env.DEV ? true : data.draft !== true
  );

  return albums.map((album) => ({
    params: { slug: album.id },
    props: { album },
  }));
}

const { album } = Astro.props;
const { Content } = await render(album);

// 封面也进图组，作为第一张
const shots = [
  { src: album.data.cover, alt: album.data.coverAlt, caption: undefined as string | undefined },
  ...album.data.images,
];

/**
 * 灯箱用的大图。构建期就转好，运行期不做任何图片处理。
 * width 取 min(2200, 原图宽) —— 不写这个 min，sharp 会把小图放大，
 * 白白多出一份比原图还大、还更模糊的文件。
 */
const bigs = await Promise.all(
  shots.map((s) =>
    getImage({ src: s.src, width: Math.min(2200, s.src.width), format: 'webp' })
  )
);

const lbJson = JSON.stringify(
  shots.map((s, i) => ({
    src: bigs[i].src,
    w: bigs[i].attributes.width ?? s.src.width,
    h: bigs[i].attributes.height ?? s.src.height,
    alt: s.alt,
    caption: s.caption ?? '',
  }))
).replace(/</g, '\\u003c');
---

<BaseLayout
  title={album.data.title}
  description={album.data.description ?? album.data.title}
  type="article"
  publishedAt={album.data.pubDate}
  image={album.data.cover.src}
  width="wide"
>
  <header class="head glass rise rise-1">
    <p class="meta crumbs">
      <a href="/photos">{SECTIONS.photos.title}</a>
    </p>

    <h1 class="title">{album.data.title}</h1>

    <div class="stamps meta">
      {album.data.location && (
        <>
          <span>{album.data.location}</span>
          <span class="sep" aria-hidden="true">/</span>
        </>
      )}
      <FormattedDate date={album.data.pubDate} />
      <span class="sep" aria-hidden="true">/</span>
      <span>{shots.length} 张</span>
    </div>

    {album.data.description && <p class="dek">{album.data.description}</p>}
  </header>

  {/* 有正文时先显示文字 */}
  <div class="note prose">
    <Content />
  </div>

  <ul class="plates rise rise-2">
    {shots.map((shot, i) => (
      <li class="plate">
        <figure>
          {/* 包一层真链接：没 JS 时点开就是原图，有 JS 时脚本拦下来开灯箱。
              用 <button> 会同时丢掉「新标签页打开」和「无 JS 可用」两件事 */}
          <a class="plate__open" href={bigs[i].src} data-shot={i}>
            <Image
              src={shot.src}
              alt={shot.alt}
              widths={[640, 1024, 1600]}
              loading={i === 0 ? 'eager' : 'lazy'}
            />
            <span class="plate__hint meta" aria-hidden="true">放大</span>
          </a>
          {shot.caption && <figcaption class="meta">{shot.caption}</figcaption>}
        </figure>
      </li>
    ))}
  </ul>

  <nav class="back">
    <a href="/photos">← 回到{SECTIONS.photos.title}</a>
  </nav>

  {/* 灯箱。<dialog> 是原生的：Esc 关闭、焦点困住、top layer 都不用自己写 */}
  <dialog class="lb" data-lb aria-label={`${album.data.title} 大图`}>
    <button class="lb__key lb__key--x" type="button" data-lb-close aria-label="关闭">
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path
          d="M6.4 5 5 6.4 10.6 12 5 17.6 6.4 19 12 13.4 17.6 19 19 17.6 13.4 12 19 6.4 17.6 5 12 10.6z"
        ></path></svg
      >
    </button>

    <button
      class="lb__key lb__key--prev"
      type="button"
      data-lb-prev
      aria-label="上一张"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M15.3 4.6 7.9 12l7.4 7.4 1.4-1.4L10.7 12l6-6z"></path></svg
      >
    </button>

    <figure class="lb__fig">
      <img data-lb-img alt="" />
      <figcaption class="lb__cap">
        <span class="lb__cap-t" data-lb-cap></span>
        <span class="meta" data-lb-n></span>
      </figcaption>
    </figure>

    <button
      class="lb__key lb__key--next"
      type="button"
      data-lb-next
      aria-label="下一张"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"
        ><path d="M8.7 4.6 7.3 6l6 6-6 6 1.4 1.4L16.1 12z"></path></svg
      >
    </button>
  </dialog>

  <script type="application/json" data-lb-data set:html={lbJson} is:inline></script>
</BaseLayout>

<script>
  interface Shot {
    src: string;
    w: number | string;
    h: number | string;
    alt: string;
    caption: string;
  }

  const dlg = document.querySelector<HTMLDialogElement>('[data-lb]');
  const raw = document.querySelector('[data-lb-data]')?.textContent;
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-shot]')];

  // showModal 不在就什么都不接：点图变成正常跳转到原图，仍然可用
  if (dlg && raw && links.length && typeof dlg.showModal === 'function') {
    const shots: Shot[] = JSON.parse(raw);
    const img = dlg.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const cap = dlg.querySelector<HTMLElement>('[data-lb-cap]')!;
    const num = dlg.querySelector<HTMLElement>('[data-lb-n]')!;
    let i = 0;

    // 给 :root 打标志，让「放大」角标露出来。名字不能也叫 data-lb ——
    // 那样 querySelector('[data-lb]') 会先撞上 <html>（文档序在前），
    // 后面任何一处再按这个选择器取灯箱都会静默拿错元素
    document.documentElement.dataset.lbOn = '1';

    function show(n: number) {
      i = (n + shots.length) % shots.length;
      const s = shots[i];
      img.src = s.src;
      img.alt = s.alt;
      img.width = Number(s.w);
      img.height = Number(s.h);
      cap.textContent = s.caption;
      num.textContent = `${i + 1} / ${shots.length}`;

      // 预取左右邻居，翻页时不会先白一下
      for (const k of [i + 1, i - 1]) {
        const nb = shots[(k + shots.length) % shots.length];
        if (nb !== s) new Image().src = nb.src;
      }
    }

    links.forEach((a, n) =>
      a.addEventListener('click', (e) => {
        // 让 Ctrl/⌘+点击、中键、右键保持原生行为 —— 那是「在新标签页看原图」
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        show(n);
        dlg.showModal();
      })
    );

    dlg.querySelector('[data-lb-close]')!.addEventListener('click', () => dlg.close());
    dlg.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(i - 1));
    dlg.querySelector('[data-lb-next]')!.addEventListener('click', () => show(i + 1));

    // 点空白处关闭。事件目标是 dialog 本身才算「点在图外面」
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close();
    });

    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') {
        e.preventDefault();
        show(i - 1);
      } else if (e.key === 'ArrowRight') {
        e.preventDefault();
        show(i + 1);
      }
    });

    // 关闭后把焦点还给刚才那张图，键盘用户不会被丢到页首
    dlg.addEventListener('close', () => links[i]?.focus());
  }
</script>

<style>
  .head {
    max-width: var(--measure-prose);
    padding: var(--sp-8);
    border-radius: var(--r-xl);
  }

  .crumbs a {
    text-decoration: none;
    color: var(--ink-faint);
  }

  .crumbs a:hover {
    color: var(--seal);
  }

  .title {
    margin-top: var(--sp-4);
    font-size: var(--text-3xl);
    font-variation-settings: 'opsz' 40;
    letter-spacing: -0.02em;
  }

  .stamps {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-3);
    margin-top: var(--sp-6);
  }

  .sep {
    color: var(--rule-strong);
  }

  .dek {
    margin-top: var(--sp-6);
    color: var(--ink-soft);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
  }

  .note {
    max-width: var(--measure-prose);
    margin-top: var(--sp-8);
  }

  /* 单列大图：摄影按「一张一版」呈现，不缩成缩略图 */
  .plates {
    list-style: none;
    margin: var(--sp-16) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-16);
  }

  .plate figure {
    margin: 0;
  }

  .plate__open {
    position: relative;
    display: block;
    border-radius: var(--r-lg);
    /* 图片自己有圆角，链接层要跟着裁，否则 hover 的高光会露出方角 */
    overflow: hidden;
  }

  .plate :global(img) {
    width: 100%;
    height: auto;
    border-radius: var(--r-lg);
    box-shadow: var(--shadow-lift);
  }

  /* 「放大」角标：只在装上了灯箱脚本时才出现 —— 脚本没跑起来时点图是
     跳转到原图，写「放大」就是在骗人 */
  .plate__hint {
    position: absolute;
    right: var(--sp-4);
    bottom: var(--sp-4);
    display: none;
    padding: var(--sp-1) var(--sp-3);
    border-radius: var(--r-full);
    background: rgba(5, 5, 5, 0.6);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: var(--sand-50);
    opacity: 0;
    transform: translateY(4px);
    transition: opacity 0.24s ease, transform 0.24s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  :global(:root[data-lb-on]) .plate__hint {
    display: block;
  }

  .plate__open:hover .plate__hint,
  .plate__open:focus-visible .plate__hint {
    opacity: 1;
    transform: none;
  }

  .plate figcaption {
    margin-top: var(--sp-3);
    text-align: center;
  }

  /* --- 灯箱 --------------------------------------------------------------- */
  .lb {
    width: 100vw;
    max-width: 100vw;
    height: 100dvh;
    max-height: 100dvh;
    margin: 0;
    padding: var(--sp-6);
    border: 0;
    background: transparent;
    /* 图在中间，两侧翻页键，关闭键绝对定位在右上 */
    display: none;
    place-items: center;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: var(--sp-4);
    overflow: hidden;
  }

  .lb[open] {
    display: grid;
  }

  .lb::backdrop {
    background: rgba(5, 5, 5, 0.86);
    -webkit-backdrop-filter: blur(14px) saturate(120%);
    backdrop-filter: blur(14px) saturate(120%);
  }

  .lb__fig {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--sp-4);
    margin: 0;
    min-width: 0;
    max-height: 100%;
  }

  .lb__fig img {
    /* 两个方向都夹住：竖图不能顶出视口，横图不能超宽。
       减掉的是 padding + 图注那一行的高度 */
    max-width: 100%;
    max-height: calc(100dvh - 8rem);
    width: auto;
    height: auto;
    object-fit: contain;
    border-radius: var(--r-md);
    box-shadow: 0 30px 70px -20px rgba(0, 0, 0, 0.9);
  }

  .lb__cap {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sp-4);
    text-align: center;
    color: var(--sand-100);
    font-size: var(--text-sm);
  }

  .lb__key {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border-radius: var(--r-full);
    border: 1px solid rgba(251, 251, 251, 0.16);
    background: rgba(251, 251, 251, 0.07);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    color: var(--sand-100);
    cursor: pointer;
    transition: color 0.18s ease, background-color 0.24s ease,
      border-color 0.18s ease;
  }

  .lb__key:hover {
    color: var(--sand-0);
    background: rgba(251, 251, 251, 0.15);
    border-color: rgba(251, 251, 251, 0.34);
  }

  .lb__key svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }

  .lb__key--x {
    position: absolute;
    right: var(--sp-6);
    top: var(--sp-6);
    z-index: 1;
  }

  .back {
    margin-top: var(--sp-24);
  }

  .back a {
    display: inline-block;
    padding: var(--sp-2) var(--sp-4);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--ink-soft);
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--r-full);
    transition: color 0.18s ease, background-color 0.24s ease,
      border-color 0.18s ease, transform 0.24s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .back a:hover {
    color: var(--ink);
    background: var(--glass-bg-strong);
    border-color: var(--glass-border-lit);
    transform: translateY(-2px);
  }

  @media (max-width: 40rem) {
    .head {
      padding: var(--sp-6);
    }

    .title {
      font-size: var(--text-2xl);
    }

    .plates {
      gap: var(--sp-8);
    }

    /* 窄屏上两侧翻页键会把图挤成一条。改成压在底部左右角，图占满宽度 */
    .lb {
      grid-template-columns: minmax(0, 1fr);
      padding: var(--sp-4);
    }

    .lb__key--prev,
    .lb__key--next {
      position: absolute;
      bottom: var(--sp-6);
    }

    .lb__key--prev {
      left: var(--sp-6);
    }

    .lb__key--next {
      right: var(--sp-6);
    }

    .lb__key--x {
      right: var(--sp-4);
      top: var(--sp-4);
    }

    .lb__fig img {
      max-height: calc(100dvh - 12rem);
    }
  }
</style>
