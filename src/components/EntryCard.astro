---
/**
 * 索引条目（文章 / 随笔列表项）。
 *
 * R44 起视觉全部在 global.css 的 `.brief` 那一段 —— 首页头版、栏目列表页用的是
 * 同一套条目，样式抄三份的下一步就是其中一份的间距悄悄漂走。这里只剩结构。
 *
 * 刻意只有标题与日期：列表负责「有什么」，摘要留给详情页；整个版面里唯一带摘要的
 * 是首页那条头条（见 home.astro 的 .lead）。
 */
import FormattedDate from './FormattedDate.astro';

interface Props {
  href: string;
  title: string;
  pubDate: Date;
}

const { href, title, pubDate } = Astro.props;
---

<li class="brief">
  <a href={href}>
    <span class="brief__title">{title}</span>
    <span class="meta brief__date">
      <FormattedDate date={pubDate} />
    </span>
  </a>
</li>
