---
/* 文章 / 随笔列表项。日期在左、正文在右的编辑式条目。 */
import FormattedDate from './FormattedDate.astro';

interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  tags?: string[];
}

const { href, title, description, pubDate, tags = [] } = Astro.props;
---

<li class="entry">
  <a href={href} class="entry__link">
    <span class="meta entry__date">
      <FormattedDate date={pubDate} />
    </span>

    <span class="entry__body">
      <span class="entry__title">{title}</span>
      <span class="entry__desc">{description}</span>
      {tags.length > 0 && (
        <span class="entry__tags meta">
          {tags.slice(0, 3).map((t) => (
            <span class="entry__tag">{t}</span>
          ))}
        </span>
      )}
    </span>

    <span class="entry__arrow" aria-hidden="true">→</span>
  </a>
</li>

<style>
  .entry {
    border-bottom: 1px solid var(--rule);
  }

  .entry__link {
    display: grid;
    grid-template-columns: 6.5rem 1fr auto;
    align-items: baseline;
    gap: var(--sp-6);
    padding: var(--sp-6) var(--sp-2);
    text-decoration: none;
    transition: background-color 0.2s ease, padding-left 0.24s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .entry__link:hover {
    background: var(--seal-wash);
    padding-left: var(--sp-4);
  }

  .entry__date {
    padding-top: 0.35em;
  }

  .entry__body {
    display: block;
  }

  .entry__title {
    display: block;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    font-variation-settings: 'opsz' 18;
    line-height: var(--leading-tight);
    color: var(--ink);
    transition: color 0.18s ease;
  }

  .entry__link:hover .entry__title {
    color: var(--seal);
  }

  .entry__desc {
    display: block;
    margin-top: var(--sp-2);
    font-size: var(--text-sm);
    line-height: var(--leading-normal);
    color: var(--ink-soft);
    /* 描述最多两行，保持列表节奏整齐 */
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .entry__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }

  .entry__tag::before {
    content: '#';
    color: var(--rule-strong);
    margin-right: 0.15em;
  }

  .entry__arrow {
    color: var(--rule-strong);
    font-size: var(--text-sm);
    transition: color 0.18s ease, transform 0.24s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .entry__link:hover .entry__arrow {
    color: var(--seal);
    transform: translateX(0.25rem);
  }

  @media (max-width: 46rem) {
    .entry__link {
      grid-template-columns: 1fr auto;
      gap: var(--sp-3);
    }

    /* 窄屏把日期挪到标题上方 */
    .entry__date {
      grid-column: 1 / -1;
      padding-top: 0;
    }
  }
</style>
