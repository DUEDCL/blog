---
import { SITE_TITLE, SITE_URL } from '../consts';
import {
  alternates,
  localeOf,
  localePath,
  LOCALES,
  OG_LOCALE,
  t,
} from '../i18n';
import ThemeBoot from './ThemeBoot.astro';

interface Props {
  title?: string;
  description?: string;
  /** 文章封面等社交分享图，需为绝对或站内根路径 */
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
}

/* 语言从地址认，不从 props 传（同 FormattedDate 的理由）。
   这一处认出来的语言同时决定 description 的缺省、og:locale、hreflang 与 RSS 的地址。 */
const locale = localeOf(Astro.url.pathname);
const strings = t(locale);

const {
  title,
  description = strings.siteDescription,
  image,
  type = 'website',
  publishedAt,
} = Astro.props;

// 首页不重复站名，内页用「标题 · 站名」
const fullTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const canonical = new URL(Astro.url.pathname, SITE_URL);
const ogImage = image ? new URL(image, SITE_URL) : undefined;

/* 三种语言互指 + x-default。**同一组链接在 sitemap 里也要有**（astro.config.mjs
   的 sitemap i18n 段），Google 的文档要求两处一致，缺一边就当没声明。 */
const alts = alternates(Astro.url.pathname);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
{/* 免转码标记（R30）。国内几个 App 内置浏览器会把页面送去「转码/省流」再返回，
    排版会被彻底重排 —— 站主真机实测百度 App 里顶栏与正文叠在一起、正文变成一列一字。
    挡不挡得住不由站点说话，但不写一定被转。门那页不走 BaseHead，同一对自己写了一份。 */}
<meta http-equiv="Cache-Control" content="no-transform" />
<meta name="applicable-device" content="pc,mobile" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="sitemap" href="/sitemap-index.xml" />
{/* 订阅源按语言分开：英文读者订阅 /en/rss.xml 拿到的是译过的标题与摘要 */}
<link
  rel="alternate"
  type="application/rss+xml"
  title={SITE_TITLE}
  href={new URL(localePath(locale, '/rss.xml'), SITE_URL)}
/>

{/* 三种语言的同一页互指。x-default 指中文那份 —— 它是原文，
    也是唯一保证有正文的一份（译文是一篇篇填的，见 content.config.ts） */}
{alts.map((a) => (
  <link rel="alternate" hreflang={a.hreflang} href={new URL(a.path, SITE_URL)} />
))}

<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:locale" content={OG_LOCALE[locale]} />
{LOCALES.filter((l) => l !== locale).map((l) => (
  <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
))}
{ogImage && <meta property="og:image" content={ogImage} />}
{publishedAt && (
  <meta property="article:published_time" content={publishedAt.toISOString()} />
)}

<meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
{ogImage && <meta name="twitter:image" content={ogImage} />}

{/* 移动端浏览器地址栏跟随页面底色，不会露出一条白边。
    这两条是**首屏静态值**，写的是默认版次（夜刊）；R44 起读者可能选了别的版次，
    真正的同步在 ThemeBoot.astro —— 它从 CSS 变量 `--theme-color` 读当前版次的底色
    再写回这个 meta（值因此只有 themes.css 一个来源）。
    `color-scheme` 给两档：四套版次里晨版是浅色，只写 dark 会让表单控件与滚动条
    在那一档仍按深色渲染（CSS 里每套版次自己的 `color-scheme` 会接管，但这条 meta
    在样式表解析完之前就生效，首屏那一帧靠它）。 */}
<meta name="color-scheme" content="dark light" />
<meta name="theme-color" content="#0b0b0c" />

{/* `<html data-js data-theme>` 在样式加载前同步确定，避免闪烁 —— data-theme 是
    R44 加回来的（R31 那轮砍浅色时连它一起删了）。脚本本体在 ThemeBoot.astro：
    起始页不走 BaseLayout，得自己引同一个组件，而 SPA 导航按脚本 textContent
    逐字去重，两处必须一模一样才只跑一次。 */}
<ThemeBoot />
