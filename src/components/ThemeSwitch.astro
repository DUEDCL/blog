---
/**
 * 版次切换器（R44）—— 顶栏右端那枚键。
 *
 * 「版次」是报纸的词：同一份报纸的夜刊与晨版内容一样、纸与墨不一样。四套版次的
 * 色值在 `styles/themes.css`，这里只负责选。
 *
 * ---- 色卡里的颜色一个字都没抄 ----
 * 每个选项前面那枚方块是 `<span data-theme="paper">`，而 themes.css 的选择器写的是
 * `[data-theme='paper']` —— **没有限定 html**，所以它同样匹配这个 span：方块拿到的
 * `--paper` / `--press` 就是那套版次自己的值。色值因此只有一个来源，加一套版次
 * 只要在 themes.css 加一块、在 consts.ts 的 EDITIONS 加一个 id、在三份 `i18n/*.ts`
 * 的 `editions` 各加一条名字与参照物，这里不用动。
 *
 * ---- 当前项的勾选也不靠 JS ----
 * `html[data-theme='x'] [data-edition='x']` 一条 CSS 就能标出当前版次。JS 只补
 * `aria-checked`（无障碍需要真属性）—— 也就是说脚本挂了，视觉状态仍然是对的。
 *
 * ---- 事件用委托，全站只挂一次 ----
 * SPA 导航后顶栏是新节点。若在 `astro:page-load` 里给按钮挂监听，十次导航会累积
 * 十层（Header.astro 的 scroll 监听那段注释记过同一个坑）。这里全部走 document 上的
 * 委托，判断 `closest()`，所以不需要重绑，也不会累积。
 *
 * ---- 长相住在 global.css ----
 * `.topdrop` / `.topkey` / `.topmenu` / `.topopt` 那几个类与语言切换键共用
 * （R46 提取）。这里只剩版次特有的那枚色卡，以及「当前是哪一版」那四条选择器。
 */
import { EDITIONS } from '../consts';
import { localeOf, t } from '../i18n';

const strings = t(localeOf(Astro.url.pathname));
---

<div class="topdrop">
  <button
    type="button"
    class="topkey"
    id="ed-key"
    aria-expanded="false"
    aria-haspopup="true"
    aria-controls="ed-menu"
  >
    <span class="ed__chip" aria-hidden="true"></span>
    <span>{strings.common.editionKey}</span>
  </button>

  <div
    class="topmenu glass"
    id="ed-menu"
    role="radiogroup"
    aria-label={strings.common.editionMenu}
    hidden
  >
    {
      EDITIONS.map((e) => (
        <button
          type="button"
          class="topopt"
          role="radio"
          aria-checked="false"
          data-edition={e.id}
        >
          <span class="ed__chip" data-theme={e.id} aria-hidden="true"></span>
          <span class="topopt__text">
            <span class="topopt__name">{strings.editions[e.id].name}</span>
            <span class="topopt__note">{strings.editions[e.id].note}</span>
          </span>
        </button>
      ))
    }
  </div>
</div>

<style>
  /* 色卡：左下是纸，右上是签名色。45° 对角分割 —— 印刷厂的色标就是这么贴的，
     两半各占一半面积，比「一个圆点」更能同时说明纸与墨 */
  .ed__chip {
    width: 0.9rem;
    height: 0.9rem;
    flex-shrink: 0;
    background-image: linear-gradient(
      135deg,
      var(--paper) 0 48%,
      var(--press) 52% 100%
    );
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }

  /* 当前版次：纯 CSS 判定（见组件顶部注释）。`.topopt` 的公共样式在 global.css，
     这四条只补「哪一项是当前」——scoped 之后特异性比全局那条高，所以会赢 */
  :global(html[data-theme='night']) .topopt[data-edition='night'],
  :global(html[data-theme='paper']) .topopt[data-edition='paper'],
  :global(html[data-theme='film']) .topopt[data-edition='film'],
  :global(html[data-theme='neon']) .topopt[data-edition='neon'] {
    background: var(--glass-bg);
    box-shadow: inset 2px 0 0 var(--press);
  }

  /* 窄屏不改定位：顶栏折行后这两枚键跟品牌同一行、贴在右端，菜单朝左展开
     （账算在 global.css 的 `.topmenu` 那一段）。 */
</style>

<script>
  const KEY = 'theme';

  /** 切到某一版次：写 DOM、存偏好、同步地址栏底色与 aria */
  function apply(id: string) {
    const el = document.documentElement;
    el.dataset.theme = id;
    try {
      localStorage.setItem(KEY, id);
    } catch {
      /* 隐私模式下写不进去 —— 这一次切换仍然生效，只是不记得 */
    }
    /* 值从 CSS 变量读，themes.css 是唯一来源（ThemeBoot 里那份也是这么做的） */
    const c = getComputedStyle(el).getPropertyValue('--theme-color').trim();
    const m = document.querySelector('meta[name="theme-color"]');
    if (c && m) m.setAttribute('content', c);
    syncChecked();
  }

  /** 静态产物里 aria-checked 全是 false —— 构建时不知道读者选了哪一版，运行期补 */
  function syncChecked() {
    const now = document.documentElement.dataset.theme ?? 'night';
    document.querySelectorAll<HTMLElement>('[data-edition]').forEach((b) => {
      b.setAttribute('aria-checked', String(b.dataset.edition === now));
    });
  }

  function close() {
    const key = document.getElementById('ed-key');
    const menu = document.getElementById('ed-menu') as HTMLElement | null;
    if (!key || !menu) return;
    key.setAttribute('aria-expanded', 'false');
    menu.hidden = true;
  }

  /**
   * 换版次的过渡：整页快照做一次 cross-fade。
   *
   * 为什么不用 CSS transition：一次换版次要改的是纸、墨、四档线、玻璃膜、阴影、
   * 光晕 —— 分散在几十条规则上。给它们各自加 transition 等于在切换那一帧让
   * 浏览器同时插值几百个属性（实测会掉帧），而且总有几个属性没加上，
   * 结果是「一部分渐变、一部分瞬变」。快照过渡只合成两张位图，代价固定。
   *
   * `.is-turning` 那个类是必需的：`::view-transition-old/new(root)` 已经被跨页
   * 导航用了（带位移的进出场，见 global.css），换版次不该有位移 ——
   * 加类之后 global.css 里那条覆盖规则把它压成纯 cross-fade。
   *
   * 减少动态偏好下直接跳过 —— global.css 那条 `*` 规则匹配不到
   * `::view-transition-*`（它们在独立的伪元素树里），够不着，只能在这儿判断。
   */
  function turn(id: string) {
    const el = document.documentElement;
    const vt = (document as unknown as {
      startViewTransition?: (cb: () => void) => { finished: Promise<void> };
    }).startViewTransition;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (typeof vt !== 'function' || reduce) {
      apply(id);
      return;
    }

    el.classList.add('is-turning');
    vt.call(document, () => apply(id)).finished.finally(() => {
      el.classList.remove('is-turning');
    });
  }

  /* 一律走事件委托：顶栏每次 SPA 导航都是新节点，挂在按钮上会累积监听 */
  document.addEventListener('click', (ev) => {
    const t = ev.target as Element | null;
    if (!t) return;

    const opt = t.closest<HTMLElement>('[data-edition]');
    if (opt?.dataset.edition) {
      turn(opt.dataset.edition);
      close();
      return;
    }

    const key = t.closest('#ed-key');
    if (key) {
      const menu = document.getElementById('ed-menu') as HTMLElement | null;
      if (!menu) return;
      const opening = menu.hidden;
      menu.hidden = !opening;
      key.setAttribute('aria-expanded', String(opening));
      return;
    }

    if (!t.closest('#ed-menu')) close();
  });

  document.addEventListener('keydown', (ev) => {
    if (ev.key !== 'Escape') return;
    const menu = document.getElementById('ed-menu') as HTMLElement | null;
    if (!menu || menu.hidden) return;
    close();
    document.getElementById('ed-key')?.focus();
  });

  document.addEventListener('astro:page-load', syncChecked);
  syncChecked();
</script>
