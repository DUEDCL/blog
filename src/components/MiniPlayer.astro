---
/**
 * 悬浮窗 —— 全站那条实时状态栏，也是全站唯一那个 `<audio>` 的出生地。
 *
 * 为什么 `<audio>` 写在这里而不是 /music 页：R14 要「在网站其他地方正在播放的音乐
 * 不会停止」。这个根节点带 `transition:persist="jk"`，SPA 换页时 Astro 把这棵子树
 * **原样搬进新文档**（是同一个节点对象，不是重建），视图的事件与状态一并保住。
 * 换页存进度再续播那条路不行 —— 声音会有可听见的裂口。
 *
 * 但 `<audio>` 光靠 persist 保不住：Astro 7.2.x 的 `reifyMediaElements` 会在换页
 * 最后一步把新 body 里的 audio 全换成克隆，连刚搬过来的那个也换。所以下面那段脚本
 * 一上来就把它挪去 `<html>` 底下，彻底站到那个扫描范围之外（详情见脚本里的长注释）。
 * 这一页的模板里它仍然写在这儿，只是**运行期第一件事就是搬家**。
 *
 * 两条约束因此固定下来：
 * ① 根节点**必须始终存在**（persist 靠名字配对，目标页面没有同名节点就不搬、
 *    老节点连着旧 body 一起丢），所以「不显示」只能用 `hidden`，也所以起始页
 *    这种不走 BaseLayout 的页面同样得渲染它。
 * ② 下面那段脚本是 bundled module，**全站只执行一次**；而它要操作的节点又是被
 *    persist 保住的同一批。两件事对齐，所以事件只在模块顶层绑一次，
 *    不需要 `astro:page-load`（放进去反而会每导航一次累积一层监听）。
 *
 * 状态一律不存这里：队列、当前曲、播放方式、歌词全在 scripts/jukebox.ts 的
 * 单例闭包里。这个组件只是它的一个视图，负责把状态画成 DOM。
 *
 * 样式**由这个组件自己 import**（R22 从 BaseLayout 搬来的一行）：起始页不走 BaseLayout，
 * 而 R22④ 要它也显示状态栏 —— 让样式跟着唯一的必需视图走，凡渲染状态栏的页面就一定有它，
 * 顺带消灭「某一页忘了 import」这个故障模式。`/music` 舞台的样式也在这份文件里，
 * 而舞台走 BaseLayout → 一定渲染状态栏 → 一定拿到样式。
 */
import '../styles/player.css';
---

<div class="jk-mini" data-mini hidden transition:persist="jk">
  {/* preload="none"：这东西每一页都挂着，不该为一个可能没人点开的播放器去抓
      metadata；时长本来也来自 data/music.ts 的配置值，不指望 metadata 给。
      没有 controls —— 控制键是下面那几个 */}
  <audio data-au preload="none"></audio>

  {/* 没有 `glass` / `meta` 这两个全局类：它们住在 global.css 里，而门不引 global.css。
      两处需要的声明已经就地写进 player.css 的 .jk-mini__card / .jk-mini__time */}
  <div class="jk-mini__card">
    <div class="jk-mini__head">
      {/* 转盘兼收起键。播放时它在转（复用唱盘台那条 jk-spin）；
          有封面时那张图铺满转盘，跟着一起转 */}
      <button
        class="jk-mini__fold"
        type="button"
        data-fold
        aria-expanded="true"
        aria-label="收起播放器"
      >
        <span class="jk-mini__disc" aria-hidden="true">
          <img class="jk-mini__cover" data-cover alt="" hidden />
        </span>
      </button>

      {/* 曲名与「歌手 · 专辑」。收起态只留曲名 —— 状态栏的本分是「一直告诉你在放什么」。
          曲名套了两层：外层是固定宽的窗口，内层承载文字 —— 长歌名装不下时由脚本量出溢出量
          写进 `--jk-over`，内层就地做跑马灯（R27：不许它把上一首/下一首两个键挤掉） */}
      <p class="jk-mini__now">
        <span class="jk-mini__t"><span class="jk-mini__t-i" data-title></span></span>
        <span class="jk-mini__s" data-sub></span>
      </p>

      <a class="jk-key jk-key--sm" data-open href="/music" aria-label="打开唱片机">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M5 5h6v2H7v10h10v-4h2v6H5z"></path><path
            d="M13 4h7v7h-2V7.41l-7.3 7.3-1.41-1.41L18.59 6H13z"></path></svg
        >
      </a>

      {/* 全展开 ↔ 药丸的切换键（R28 加的：站主要「前两种状态添加一个按钮实现切换」）。
          两个箭头叠在一个键里，露哪个由 `.is-fold` 决定 —— 与播放/暂停那对图标同一套做法。
          封面点一下也切（那是 R25 就有的入口），这里只是把它变成一个看得见的按钮 */}
      <button class="jk-key jk-key--sm jk-key--size" type="button" data-toggle>
        <svg class="jk-key__i jk-key__i--up" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M12 8.6l6 6-1.4 1.4L12 11.4l-4.6 4.6L6 14.6z"></path></svg
        >
        <svg class="jk-key__i jk-key__i--down" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M12 15.4l-6-6L7.4 8l4.6 4.6L16.6 8 18 9.4z"></path></svg
        >
      </button>
    </div>
    {/* 正在唱的那一行。套两层：外层是固定宽的窗口（截断／滚动都由它管），内层才是
        WordRun 的宿主 —— `jk-line` 必须挂在**内层**，player.css 里那套逐字渐变的选择器
        是 `.jk-line.is-on .jk-w`，而 WordRun 往宿主上加的正是 `is-on`。
        长歌词装不下时由脚本量出溢出量，内层就地滚动（R29） */}
    <p class="jk-mini__line"><span class="jk-mini__line-i jk-line" data-line></span></p>

    <div class="jk-mini__seek">
      <span class="jk-mini__time" data-cur>0:00</span>
      <input
        class="jk-rng jk-rng--mini"
        type="range"
        data-seek
        min="0"
        max="0"
        step="0.05"
        value="0"
        aria-label="播放进度"
      />
      <span class="jk-mini__time" data-dur>0:00</span>
    </div>

    <div class="jk-mini__keys">
      <button class="jk-key jk-key--sm" type="button" data-prev aria-label="上一首">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M7 6h2.1v12H7zM19 6.6v10.8L10.6 12z"></path></svg
        >
      </button>

      <button
        class="jk-key jk-key--sm jk-key--play"
        type="button"
        data-play
        aria-label="播放"
        aria-pressed="false"
      >
        <svg class="jk-key__i jk-key__i--play" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M8.4 5.4v13.2L19 12z"></path></svg
        >
        <svg class="jk-key__i jk-key__i--pause" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M8 5.6h3v12.8H8zM13 5.6h3v12.8h-3z"></path></svg
        >
      </button>

      <button class="jk-key jk-key--sm" type="button" data-next aria-label="下一首">
        <svg viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M14.9 6h2.1v12h-2.1zM5 6.6v10.8L13.4 12z"></path></svg
        >
      </button>
      {/* 播放方式。四个图标叠在这一个键里，露哪个由脚本写的 data-m 决定 ——
          和唱盘台那个键是同一套图标、同一套 CSS，两处显示的必然是同一档 */}
      <button class="jk-key jk-key--sm jk-key--mode" type="button" data-mode>
        <svg class="jk-key__i jk-key__i--m0" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M3.5 11h9.6v2H3.5zM12.4 7.4L17.2 12l-4.8 4.6zM18.6 5.8h2v12.4h-2z"
          ></path></svg
        >
        <svg class="jk-key__i jk-key__i--m1" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M7.6 7.2H16V9l3.6-2.8L16 3.4v1.8H5.6v6.4h2z"></path><path
            d="M16.4 16.8H8V15l-3.6 2.8L8 20.6v-1.8h10.4v-6.4h-2z"></path></svg
        >
        <svg class="jk-key__i jk-key__i--m2" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M7.6 7.2H16V9l3.6-2.8L16 3.4v1.8H5.6v6.4h2z"></path><path
            d="M16.4 16.8H8V15l-3.6 2.8L8 20.6v-1.8h10.4v-6.4h-2z"></path><path
            d="M11 10.6l2.2-1.2v5.2h-1.6v-3.2z"></path></svg
        >
        <svg class="jk-key__i jk-key__i--m3" viewBox="0 0 24 24" aria-hidden="true"
          ><path d="M3.84 7.25L5.16 5.75l12.5 11-1.32 1.5z"></path><path
            d="M3.84 16.75l1.32 1.5 12.5-11-1.32-1.5z"></path><path
            d="M14.8 4.4h4.8v4.8z"></path><path d="M14.8 19.6h4.8v-4.8z"></path></svg
        >
      </button>
    </div>

    {/* 音量（R28 加的：站主要「全展开模式，包含歌词、歌名、音量控制、上下首播放」）。
        与 /music 唱盘台是同一个 `data-vol` 契约、同一个 setVol —— 两处调的是同一份状态，
        所以在哪儿调都立刻互相看得见。只在全展开态出现，药丸与吸附态都藏掉 */}
    <div class="jk-mini__vol">
      <span class="jk-mini__time">音量</span>
      <input
        class="jk-rng jk-rng--mini"
        type="range"
        data-vol
        min="0"
        max="1"
        step="0.01"
        value="0.8"
        aria-label="音量"
      />
    </div>
  </div>
</div>

<script>
  import { formatTime } from '../data/music';
  import {
    MODES,
    WordRun,
    attach,
    coverOf,
    cycleMode,
    dur,
    everPlayed,
    getMode,
    getVol,
    init,
    lineAt,
    next,
    now,
    playing,
    prev,
    seekTo,
    setVol,
    time,
    toggle,
    type View,
  } from '../scripts/jukebox';

  const root = document.querySelector<HTMLElement>('[data-mini]');
  const au = root?.querySelector<HTMLAudioElement>('[data-au]');

  if (root && au) {
    /* 非空断言在这里是安全的：这些节点就在上面那段模板里，
       而模板与这段脚本同属一个组件，不存在「页面没放它们」的情形 */
    const pick = <T extends HTMLElement>(sel: string) => root.querySelector<T>(sel)!;
    const title = pick('[data-title]');
    const titleBox = pick('.jk-mini__t');
    const sub = pick('[data-sub]');
    const line = pick('[data-line]');
    const lineBox = pick('.jk-mini__line');
    const cur = pick('[data-cur]');
    const durEl = pick('[data-dur]');
    const seek = pick<HTMLInputElement>('[data-seek]');
    const vol = pick<HTMLInputElement>('[data-vol]');
    const play = pick('[data-play]');
    const modeKey = pick('[data-mode]');
    const fold = pick('[data-fold]');
    const sizeKey = pick('[data-toggle]');
    const cover = pick<HTMLImageElement>('[data-cover]');
    const card = pick('.jk-mini__card');

    /* ⚠ 把 `<audio>` 搬出 `<body>`，挂到 `<html>` 上直接当子节点。
       这不是洁癖，是绕开 Astro 自己的一个 bug —— 少了这一行，「跨页不间断播放」
       整套机制在换页那一刻就废掉。

       实测的因果（读的是本仓库装着的 astro 7.2.2，
       `node_modules/astro/dist/transitions/swap-functions.js`）：
       `swapBodyElement()` 的最后一步是 `reifyMediaElements(newElement)`，而它
       **无条件**把新 body 里所有 `video, audio` 换成一个新造的克隆
       （`document.createElement` + 抄属性 + `media.replaceWith(fresh)`）。
       这一步排在「把 persist 节点搬回新 body」**之后**，且没有任何 persist 豁免 ——
       于是刚被原样搬过来的、**正在播的**那个 `<audio>` 正好落在扫描范围里，被换掉。
       老节点一脱离 document，按 HTML 规范就要跑 internal pause steps：
       音乐停、`currentTime` 归零、jukebox 手里的 `au` 指向一个已经离场的节点、
       所有控制键跟着失灵。这正是「点到别的页面歌就断」的机制。

       上游已经修了，但**没发布**：GitHub main 的 `swap-functions.ts` 改成先
       `const liveMedia = new Set(oldElement.querySelectorAll('video, audio'))`，
       再在 reify 里 `if (liveMedia.has(media)) continue;`（按节点身份豁免，
       不是按选择器）。而 `npm pack astro@7.2.4` 解包 grep 过，7.2.4 仍是单参数的
       `reifyMediaElements(newElement)` —— 升级躲不过去，只能自己躲。

       躲法就是站到它的扫描范围之外：reify 只扫新 body，`<html>` 的直接子节点它
       永远看不见。而这么搬没有代价 ——
       ① 元素仍然 connected，播放不受影响（搬的这一刻还没有 src，更不会有事）；
       ② `audio:not([controls])` 在各家 UA 样式表里都是 `display: none`，
          它本来就没有盒子，挪去哪都不影响布局；
       ③ Astro 自己就往 `documentElement` 上寄存 persist 节点（见上面那个函数里的
          `moveBefore(docEl, el, null)` / `docEl.appendChild(el)`），这条路它自己在走。

       于是 `.jk-mini` 只剩「状态栏视图」这一个身份：它照旧靠 persist 跨页保命
       （事件、折叠态、WordRun 的宿主都在它身上），但音频不再依赖它。
       新页面模板里那个空的 `<audio data-au>` 会连同新的 `.jk-mini` 一起被 persist
       逻辑整棵丢掉（`newTarget.replaceWith(el)`），不会留下第二个音频源。 */
    document.documentElement.appendChild(au);

    init(au);

    const run = new WordRun();
    /** 拖进度条时别让 tick 把滑块拽回去 */
    let drag = false;

    /**
     * 页脚的滚动余量。悬浮窗浮在最上层、**不占布局流** —— 代价是滚到页面最底时，
     * 它正好压在页脚那一行链接上（375×812 实测：五个链接全被盖住）。
     *
     * 补法不是把它塞回布局流，而是量出它实际占多高（展开还是收起、窄屏折行都算在内），
     * 写成 `<html>` 上的 `--jk-room`，由 player.css 补给 `body` 的 padding-bottom：
     * 不挪任何元素的位置，只把可滚区域往下拉长一截，滚到底时页脚就从它下面出来了。
     *
     * **R25 起判据从「显不显示」改成「是不是真的压着底部」** —— 药丸现在能被长按拖到
     * 任何一条边，拖到顶上之后再给页脚让位就是白留一段空白。同一条判据顺带管住了门：
     * 门上药丸默认在顶部，于是 `--jk-room` 不写，player.css 里那条把进站键抬起来的
     * `margin-bottom` 自动退回 0（那条 CSS 一个字都不用改）。
     *
     * 标志与变量都落在 `<html>` 上，而 swap 会把根上的属性清光（`swapRootAttributes`）——
     * 不要紧：reflow() 每次 `astro:after-swap` 都跑，会重新写上。
     */
    const room = () => {
      const he = document.documentElement;
      const r = root.getBoundingClientRect();
      // 藏起来时 rect 全是 0，bottom 不可能大于 innerHeight - 24，所以这一支同时管住了 hidden
      const atBottom = !root.hidden && r.bottom > innerHeight - 24;
      if (!atBottom) {
        delete he.dataset.jk;
        he.style.removeProperty('--jk-room');
        return;
      }
      // 门那页 `html, body` 都是 overflow: hidden，没有可滚的内容也没有页脚，
      // 那段 padding-bottom 毫无意义 —— 所以旗不写，但 --jk-room 照写（进站键要靠它让位）
      if (document.querySelector('[data-portal]')) delete he.dataset.jk;
      else he.dataset.jk = '1';
      he.style.setProperty('--jk-room', r.height + 'px');
    };

    /* ---------- 补起播（R25） --------------------------------------------- */

    /**
     * 「在有些浏览器打开不会及时播放默认歌曲」这句报上来的其实是两层原因：
     *
     * ① 有的浏览器（iOS Safari 一类）只承认 `click`/`touchend` 为有效手势，
     *    而门上原先只在 `pointerdown` 里试 —— 门那边已经补上另两个（见 index.astro）。
     * ② 门上那次 `play()` 被拒之后人已经进站，而门的 `kick()` 有 `stage` 守卫、
     *    正站永不再试；状态栏又因为 `everPlayed()` 仍是 false 而藏着 ——
     *    于是这一趟访问再也没有音乐，连手动点播放的入口都没有。**第二层是真正的洞。**
     *
     * 补法：门上尝试起播时写下 `sessionStorage['music:want']`（「这一趟是想听音乐的」），
     * 这里认那面旗 —— 还没播成之前，落在状态栏与唱盘台之外的任何一次手势都补试一次。
     * 播成了就清旗、摘监听。没有旗（比如直接打开某篇文章）就一次都不试，
     * 「没听过歌的人不该被塞一个播放器」那条规矩对他们照旧成立。
     *
     * 监听是无条件挂的（不是 `if (wants())` 才挂）：这段脚本在门之前就跑完了，
     * 而那面旗要等门上第一个手势才写下 —— 当时判一次的话永远判到 false。
     */
    const WANT = 'music:want';
    const wants = () => {
      try {
        return sessionStorage.getItem(WANT) === '1';
      } catch {
        return false;
      }
    };
    const GESTURES = ['pointerdown', 'click', 'touchend', 'keydown'] as const;
    const retry = (e: Event) => {
      // playing() 那道守卫不能省：唱盘台的播放键自己会 toggle，而 `play` 事件要等下一个
      // 任务才派发，只看 everPlayed() 的话这里会把刚起播的歌又按停
      if (!wants() || everPlayed() || playing()) return;
      // 门上让位给门自己的 kick（那边每个手势都试），不然同一下手势会试两次
      if (document.querySelector('[data-portal]')) return;
      if (e.target instanceof Element && e.target.closest('[data-mini], [data-deck]')) return;
      toggle();
    };
    GESTURES.forEach((n) => addEventListener(n, retry, { passive: true }));
    au.addEventListener('play', () => {
      try {
        sessionStorage.removeItem(WANT);
      } catch {
        /* 隐私模式下不可写：下一次手势会再判一次 wants()，也只是白跑一次 */
      }
      GESTURES.forEach((n) => removeEventListener(n, retry));
    });

    /**
     * 露不露脸。三种页面各不相同：
     *   - `[data-deck]`（/music）—— 那儿有全尺寸的唱盘台，两个一起出现是重复，永远让位；
     *   - `[data-portal]`（起始页那道门）—— R22④ 逐字要求「在起始页面就……显示播放状态栏」，
     *     所以门上**不设「播过一次」的门槛**，一进来就露脸，第一眼是暂停态的《特别的人》。
     *     （这一条与 R17「那一页不出现任何别的词」相抵，是本轮站主的决定。门不引
     *     global.css，token 由 player.css 末尾那个 `[data-portal]` 块就地补上。）
     *   - 其余页面 —— 照旧「播过一次才出现」，**但 R25 多了一个口子**：从门进来过、
     *     浏览器却一直拒着（`music:want` 还在）时也露脸，好让人自己点那个播放键。
     *
     * 判据用 DOM 里有没有这两面旗，不用 pathname：既不必操心 trailingSlash，
     * 又能在 swap 一落地时就判出来 —— 若改成等舞台挂上来再让位，
     * 导航到 /music 的头一两帧里悬浮窗会闪一下。
     */
    let wasHidden = true;
    const show = () => {
      const portal = !!document.querySelector('[data-portal]');
      root.hidden =
        !!document.querySelector('[data-deck]') ||
        (!portal && !everPlayed() && !wants());
      /* 藏着时量不出尺寸，位置与跑马灯都算不准 —— 所以在「藏↔露」翻转的那一刻补算一次。
         只在翻转时做：show() 由 sync 频繁调用，每次都重算是白费。 */
      if (wasHidden !== root.hidden) {
        wasHidden = root.hidden;
        applyPos();
        marquee();
      }
      room();
    };
    /**
     * 贴封面（R22①）。空 URL 就退回原来那个纯 CSS 转盘 —— 点歌进来的曲目在
     * `/api/music/pic` 回来之前、以及压根取不到封面的曲目，走的都是这条路。
     *
     * 这里不需要 `has-cover` 那种类：图 `position:absolute; inset:0` 铺满转盘、
     * 把沟槽渐变整个盖住，而它又是转盘的子节点，所以跟着 `jk-spin` 一起转。
     * （舞台那边不同 —— 那儿标签里还有一行烫金文字要藏，见 music.astro）
     *
     * 加载失败时记住那个 URL 再重画一次：网络挂了不该在转盘中间留一个碎图标。
     */
    let badCover = '';
    const paintCover = () => {
      const url = coverOf();
      const on = !!url && url !== badCover;
      // 同一个 URL 不重设 src —— 重设会重新发一次请求，转盘还会闪一下
      if (on && cover.getAttribute('src') !== url) cover.setAttribute('src', url);
      cover.hidden = !on;
    };
    cover.addEventListener('error', () => {
      badCover = cover.getAttribute('src') || '';
      paintCover();
    });

    /**
     * 跑马灯（R27 只管歌名，R29 加上歌词、并把速度改成恒定的）。只有真的装不下才滚 ——
     * 短歌名一动不动，不然状态栏会永远在晃。
     *
     * **速度恒定是这一版的重点**：从前时长写死 9s，路程越长越慢，长歌名慢得像没动
     * （站主的原话是「滚动太慢了」）。现在时长 = 路程 ÷ 48px/s，再除 0.8 是因为
     * keyframes 两头各留了一成的停顿（见 player.css 的 jk-marquee）。下限 1.4s：
     * 只溢出十几个像素时别抖一下就完事。
     *
     * 量的是内层那个 inline-block 的实际宽度（不受外层 `overflow: hidden` 截断），
     * 减的是外层的**内容宽** —— `clientWidth` 含 padding，而药丸态的歌词框有一段
     * 让开封面的 padding-left，不减掉就会少算 48px、该滚的不滚。
     *
     * 同一段文字重复调用不重挂类：那会让动画每次 sync 都从头开始，看着像卡住。
     */
    const SPEED = 48;
    const flow = (box: HTMLElement, inner: HTMLElement) => {
      const cs = getComputedStyle(box);
      const room =
        box.clientWidth - (parseFloat(cs.paddingLeft) || 0) - (parseFloat(cs.paddingRight) || 0);
      const over = Math.round(inner.getBoundingClientRect().width - room);
      const next = Math.max(0, over) + 'px';
      const same = box.style.getPropertyValue('--jk-over') === next;
      if (over <= 2) {
        box.classList.remove('is-marquee');
        box.style.setProperty('--jk-over', '0px');
        return;
      }
      if (same && box.classList.contains('is-marquee')) return;
      box.style.setProperty('--jk-over', next);
      box.style.setProperty('--jk-dur', Math.max(1.4, over / SPEED / 0.8).toFixed(2) + 's');
      // 换了内容就从头滚：摘类、强制回流、再挂回去
      box.classList.remove('is-marquee');
      void box.offsetWidth;
      box.classList.add('is-marquee');
    };
    const marquee = () => flow(titleBox, title);
    const marqueeLine = () => flow(lineBox, line);

    const view: View = {
      sync() {
        const t = now();
        const on = playing();
        title.textContent = t.title;
        sub.textContent = t.subtitle;
        paintCover();
        marquee();
        // is-playing 挂在根上，player.css 里 `.is-playing .jk-key__i--pause` 那对
        // 图标规则与转盘的 animation-play-state 就都吃到了
        root.classList.toggle('is-playing', on);
        play.setAttribute('aria-pressed', String(on));
        play.setAttribute('aria-label', on ? '暂停' : '播放');
        const d = dur();
        seek.max = String(d || 0);
        durEl.textContent = formatTime(d);
        /* 音量条：值与填充比例都从单例读（R28）。/music 那边调音量也会广播 sync，
           所以两处的滑块永远是同一个位置 */
        vol.value = String(getVol());
        vol.style.setProperty('--p', String(getVol()));
        modeKey.dataset.m = String(getMode());
        modeKey.setAttribute('aria-label', '播放方式：' + MODES[getMode()]);
        show();
      },

      tick() {
        const t = time();
        cur.textContent = formatTime(t);
        if (!drag) seek.value = String(t);
      },

      /** 只画当前这一行。换行才动 DOM，其余每帧只改 color 与 background-image */
      lyric(k, p, changed) {
        if (changed) {
          const text = k >= 0 ? lineAt(k) : '';
          if (text) run.mount(line, text);
          else {
            run.unmount();
            // 前奏与间奏给个音符占位；这首压根没歌词就留空（高度由 CSS 撑住，不跳）
            line.textContent = now().lines.length ? '♪' : '';
          }
          // 换了一行就重量一次：这一行装不下就从头滚（R29）
          marqueeLine();
        }
        // 没挂在任何行上时 paint 是空操作，所以不必再判一次
        run.paint(p);
      },
    };
    /* 控制键。节点是被 persist 保住的同一批，所以只绑这一次 */
    pick('[data-prev]').addEventListener('click', prev);
    pick('[data-next]').addEventListener('click', next);
    play.addEventListener('click', toggle);
    modeKey.addEventListener('click', cycleMode);

    seek.addEventListener('pointerdown', () => {
      drag = true;
    });
    seek.addEventListener('input', () => seekTo(Number(seek.value)));
    seek.addEventListener('change', () => {
      drag = false;
      seekTo(Number(seek.value));
    });
    // 音量条不用自己回填：setVol 会广播一次 sync，value 与填充比例都在那儿写
    vol.addEventListener('input', () => setVol(Number(vol.value)));

    /* ---------- 折叠态与位置：门与正站各记一份（R25） ---------------------- */

    /** 门是满屏画面，合适的位置与正站本来就不同，所以两把键分开存 */
    const isPortal = () => !!document.querySelector('[data-portal]');
    const foldKey = () => (isPortal() ? 'music:mini:portal' : 'music:mini');
    const posKey = () => (isPortal() ? 'music:pos:portal' : 'music:pos');

    const read = (k: string) => {
      try {
        return localStorage.getItem(k);
      } catch {
        return null;
      }
    };
    const write = (k: string, v: string) => {
      try {
        localStorage.setItem(k, v);
      } catch {
        /* 隐私模式下不可写：记不住位置与折叠态而已，功能不受影响 */
      }
    };

    /** 贴边的边距，与 player.css 里默认位置用的 `--sp-4` 是同一个 16px。
        吸附态例外，它要**贴死**屏幕边缘（R29：站主说「竖边吸附确实没有很贴」） */
    const GAP = 16;
    const dockNow = () => root.classList.contains('is-dock');
    const gapNow = () => (dockNow() ? 0 : GAP);
    type Edge = 'top' | 'right' | 'bottom' | 'left';
    const EDGES: Edge[] = ['top', 'right', 'bottom', 'left'];

    /**
     * 存下来的位置是「贴哪条边 + 沿那条边的比例」，**不是绝对像素** ——
     * 转屏、改窗口大小、地址栏收起都不会把它甩到屏幕外面去。
     */
    const readPos = () => {
      const raw = read(posKey());
      if (!raw) return null;
      try {
        const p = JSON.parse(raw) as { edge?: unknown; t?: unknown };
        if (!EDGES.includes(p.edge as Edge) || !Number.isFinite(Number(p.t))) return null;
        return { edge: p.edge as Edge, t: Math.min(1, Math.max(0, Number(p.t))) };
      } catch {
        return null;
      }
    };

    /** 把存下来的那对值还原成左上角坐标写进 `--jk-x/--jk-y`；没存过就交还给 CSS 的默认位置 */
    const applyPos = () => {
      const p = readPos();
      if (!p) {
        root.classList.remove('is-placed');
        root.style.removeProperty('--jk-x');
        root.style.removeProperty('--jk-y');
        return;
      }
      /* 藏着的时候量不出尺寸（`offsetWidth` 是 0），照那个值算出来的坐标会把它顶到屏幕外面去
         （实测：首屏 hidden 时按右边算，left 会得到 359 而不是 39）。show() 在它显形那一刻
         会再调一次，所以这里先按兵不动。 */
      if (root.hidden) return;
      /* **先挂 `is-placed` 再量**：那条规则自己带宽度（窄屏通栏 343 → 20rem 档 320），
         量早了就会拿旧宽度算 maxX，右边那一档会算到左边去（实测 left 16 而不是 39）。
         挂类与写变量在同一个任务里完成，中间不会 paint，所以看不出跳动。 */
      root.classList.add('is-placed');
      const w = root.offsetWidth;
      if (!w) return;
      const maxX = Math.max(0, innerWidth - w);
      const maxY = Math.max(0, innerHeight - root.offsetHeight);
      const clamp = (v: number, hi: number) => Math.min(hi, Math.max(0, v));
      const gap = gapNow();
      /* 沿边那个方向也留出 gap：不留的话 t=1 会把它顶到屏幕最边上、贴死没有余白。
         吸附态 gap 是 0 —— 那个形态就是要贴死 */
      const along = (max: number) => clamp(gap + p.t * Math.max(0, max - gap * 2), max);
      const side = p.edge === 'left' || p.edge === 'right';
      const x = side ? (p.edge === 'left' ? gap : maxX - gap) : along(maxX);
      const y = side ? along(maxY) : p.edge === 'top' ? gap : maxY - gap;
      root.style.setProperty('--jk-x', clamp(x, maxX) + 'px');
      root.style.setProperty('--jk-y', clamp(y, maxY) + 'px');
      root.classList.add('is-placed');
    };

    /** 松手：吸到最近的一条边，把「边 + 比例」记下来 */
    const snap = () => {
      const r = root.getBoundingClientRect();
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const d = { top: cy, right: innerWidth - cx, bottom: innerHeight - cy, left: cx };
      const edge = EDGES.reduce((a, b) => (d[b] < d[a] ? b : a));
      const side = edge === 'left' || edge === 'right';

      /* 竖边就是吸附态（R28）。**先挂 is-dock 再算比例**，两个理由：
         ① 吸附态贴边距离是 0 而不是 16px，gapNow() 要能读到那个类；
         ② 药丸 81.5px 收成 50px 的圆，沿边方向的可移动范围跟着变 —— 拿收之前的高度算，
            还原出来会偏上／偏下三十来像素。所以下面一律用**松手时的中心** cx/cy
            配**收完之后**的尺寸来反推比例，圆心就停在手指松开的地方。 */
      setDock(side);
      const gap = gapNow();
      const w2 = root.offsetWidth;
      const h2 = root.offsetHeight;
      const span = side ? innerHeight - h2 - gap * 2 : innerWidth - w2 - gap * 2;
      /* 沿边方向的落点：
         - 吸附态用**最后那个指针位置**当圆心 —— 卡片从 208px 收成 50px 的圆，拿卡片中心
           当锚点会让圆停在离手指几十像素的地方（实测偏 63px）；用手指才跟手。
         - 其余形态尺寸不变，保持它拖动结束时的位置，只往最近那条边贴过去。 */
      const head = dockNow()
        ? (side ? ly - h2 / 2 : lx - w2 / 2) - gap
        : (side ? r.top : r.left) - gap;
      const t = head / Math.max(1, span);
      write(posKey(), JSON.stringify({ edge, t: Math.min(1, Math.max(0, t)) }));
      applyPos();
    };

    /**
     * 折叠态的默认值。用户自己点过就以他的为准（存在 localStorage 里）；没点过：     *   - 门上默认收叠 —— 站主原话「在启动页默认为收叠药丸状态」；
     *   - 窄屏正站也默认收叠 —— 展开态在 375 屏上占 22%，「占屏比太高」说的就是它；
     *   - 宽屏正站照旧展开（那儿右下角这块地本来就是空的）。
     */
    const prefFold = () => {
      const saved = read(foldKey());
      if (saved !== null) return saved === '1';
      return isPortal() || matchMedia('(max-width: 40rem)').matches;
    };

    /* ---------- 三个形态：全展开 / 药丸 / 吸附（R28） ----------------------
       无类 = 全展开（歌词·歌名·音量·上下首都在）；`is-fold` = 药丸（默认）；
       `is-dock` = 吸附成一枚封面圆。前两态由那枚 ⌃/⌄ 键与封面互切并记进 localStorage，
       第三态只能由「拖到左右竖边」进入，且**不记住**（reflow 每次落地都撤掉它）。 */

    /**
     * 两个键的无障碍标签跟着三态走（R28）。吸附态下封面是整枚圆里唯一能点的东西，
     * 它的意思只能是「展开」；展开态下它与那枚 ⌃ 一样是「收起」。
     */
    const paintLabels = () => {
      const pill = root.classList.contains('is-fold');
      const dock = root.classList.contains('is-dock');
      sizeKey.setAttribute('aria-expanded', String(!pill));
      sizeKey.setAttribute('aria-label', pill ? '展开播放器' : '收起播放器');
      fold.setAttribute('aria-expanded', String(!pill && !dock));
      fold.setAttribute('aria-label', pill || dock ? '展开播放器' : '收起播放器');
    };

    /** 前两态：全展开（歌词/歌名/音量/上下首）↔ 药丸（歌词/歌名/上下首/播放） */
    const setFold = (on: boolean) => {
      root.classList.toggle('is-fold', on);
      paintLabels();
      // 尺寸变了：贴边的位置要跟着重算，两个跑马灯的框宽都变了要重判，页脚那段余量也要重量
      applyPos();
      marquee();
      marqueeLine();
      room();
    };

    /**
     * 第三态：吸附成一枚封面圆（R28）。只由「长按拖到左右竖边松手」进入 ——
     * **不落盘**，刷新或换页时 reflow() 会撤掉它，回到药丸（站主定的「不记住」）。
     */
    const setDock = (on: boolean) => {
      root.classList.toggle('is-dock', on);
      paintLabels();
      applyPos();
      room();
    };

    /** 那枚切换键与封面共用的动作：吸附态先退出吸附，其余情况在前两态之间翻 */
    const flip = () => {
      if (root.classList.contains('is-dock')) {
        setDock(false);
        return;
      }
      const on = !root.classList.contains('is-fold');
      setFold(on);
      write(foldKey(), on ? '1' : '0');
    };

    fold.addEventListener('click', flip);
    sizeKey.addEventListener('click', flip);

    /* ---------- 长按拖动（R25，时长在 R29 调过） --------------------------- */

    /**
     * 站主原话先是「将其做成可长按随意拖动」，后来又说「把长按拖拽的时间限制改得再短一点，
     * 现在的不是很跟手」—— 所以门限从 450ms 降到 **200ms**：比一次普通点击（多在 80–150ms）
     * 长，又短到手指刚停住就能开始拖。期间指针移动超过 8px 就取消计时 ——
     * 那是滑动或滚动，不是长按。
     *
     * 门限降下来之后必须配一条**原地松手视为点击**（见 endDrag 里的 MOVED）：200ms 很容易被
     * 一次「按得稍久的点击」跨过，那一下要是也算拖动，点封面就再也切不了形态了。
     *
     * 进度条排除在外：它自己有一套 pointerdown 拖动逻辑，两套会打架。
     * 其余位置（含封面与三个键）都能拖，「随意」就是这个意思 —— 真拖过的那一下 click
     * 会被下面那个捕获阶段的监听吞掉，所以拖完不会顺带切形态或按下播放。
     *
     * `setPointerCapture` 刻意等到长按成立才调：一上来就捕获会把随后的 click 重定向到
     * 卡片上，那些按钮就点不动了。
     */
    const HOLD = 200;
    /** 位移不到这个数就算「原地」—— 手指按着不动也会有一两像素的抖 */
    const MOVED = 6;
    let hold: number | undefined;
    let dragging = false;
    let dragged = false;
    let wasPlaced = false;
    let pid = -1;
    let sx = 0;
    let sy = 0;
    let lx = 0;
    let ly = 0;
    let ox = 0;
    let oy = 0;

    const stopHold = () => {
      if (hold !== undefined) clearTimeout(hold);
      hold = undefined;
    };

    const moveTo = (px: number, py: number) => {
      const x = Math.min(Math.max(0, px - ox), Math.max(0, innerWidth - root.offsetWidth));
      const y = Math.min(Math.max(0, py - oy), Math.max(0, innerHeight - root.offsetHeight));
      root.style.setProperty('--jk-x', x + 'px');
      root.style.setProperty('--jk-y', y + 'px');
    };

    const beginDrag = () => {
      hold = undefined;
      dragging = true;
      dragged = true;
      const r = root.getBoundingClientRect();
      ox = sx - r.left;
      oy = sy - r.top;
      // 记一下拖之前是不是已经被摆过：原地松手要能原样退回去（见 endDrag）
      wasPlaced = root.classList.contains('is-placed');
      root.classList.add('is-placed', 'is-drag');
      try {
        card.setPointerCapture(pid);
      } catch {
        /* 指针已经抬起：那就退化成「没拖动过」，下面的 pointerup 会收尾 */
      }
      moveTo(sx, sy);
    };

    const endDrag = () => {
      stopHold();
      if (!dragging) return;
      dragging = false;
      root.classList.remove('is-drag');

      /* **原地松手当点击**（R29）。门限降到 200ms 之后，「按得稍久的一次点击」很容易
         跨过它 —— 那一下要是也算拖动，就会顺手吸边、还把 click 吞掉，点封面再也切不了形态。
         所以位移不到 MOVED 就整件事作废：位置退回拖之前（这次是第一次被摆的话连
         `is-placed` 一起撤掉，好让它继续跟着 CSS 的默认位置走），`dragged` 不举旗，
         那一下 click 照常派给按钮。 */
      if (Math.hypot(lx - sx, ly - sy) < MOVED) {
        dragged = false;
        if (!wasPlaced) {
          root.classList.remove('is-placed');
          root.style.removeProperty('--jk-x');
          root.style.removeProperty('--jk-y');
        } else {
          applyPos();
        }
        room();
        return;
      }

      snap();
      room();
      /* `dragged` 只为吞掉紧跟着这次拖动的那一下 click。浏览器**不一定**会派那一下
         （pointercancel 收尾、在屏幕外松手都不会），所以给它一个自动复位 ——
         不然那面旗会一直举着，把用户下一次真正的点击也吞掉。400ms 远大于
         pointerup → click 的实际间隔（通常 < 50ms），又不至于误伤下一次点击。 */
      setTimeout(() => {
        dragged = false;
      }, 400);
    };

    card.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      if (e.target instanceof Element && e.target.closest('[data-seek]')) return;
      pid = e.pointerId;
      sx = e.clientX;
      sy = e.clientY;
      lx = sx;
      ly = sy;
      dragged = false;
      stopHold();
      hold = window.setTimeout(beginDrag, HOLD);
    });

    card.addEventListener(
      'pointermove',
      (e) => {
        lx = e.clientX;
        ly = e.clientY;
        if (dragging) {
          e.preventDefault();
          moveTo(e.clientX, e.clientY);
          return;
        }
        if (hold !== undefined && Math.hypot(e.clientX - sx, e.clientY - sy) > 8) stopHold();
      },
      { passive: false }
    );

    card.addEventListener('pointerup', endDrag);
    card.addEventListener('pointercancel', endDrag);
    card.addEventListener('lostpointercapture', endDrag);
    /* 兜底：`pointerup` 不一定来（切标签、系统手势插进来、指针捕获被静默收走都会漏）。
       漏了的话 `is-drag` 会一直挂着 —— 卡片放大着、`touch-action` 锁着，看起来就是卡死。
       这两条把它收干净，代价为零（没在拖时 endDrag 直接返回）。 */
    addEventListener('blur', endDrag);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) endDrag();
    });
    // 长按拖完那一下浏览器还会派一个 click，吞掉它
    card.addEventListener(
      'click',
      (e) => {
        if (!dragged) return;
        dragged = false;
        e.preventDefault();
        e.stopPropagation();
      },
      true
    );
    // 桌面端鼠标长按封面会触发原生的图片拖拽，那不是我们要的拖
    card.addEventListener('dragstart', (e) => e.preventDefault());
    // 移动端长按默认要弹上下文菜单／选中文字，拖动期间一律拦掉
    card.addEventListener('contextmenu', (e) => {
      if (dragging) e.preventDefault();
    });

    attach(view);

    /**
     * 这一页是门还是正站、有没有唱盘台，swap 之后都可能变了 —— 折叠默认值、位置、
     * 让位余量三样都要按新页面重判，且要在 paint 之前。
     * 监听留在模块顶层，全站只加一次（放进 astro:page-load 会每导航累积一层）。
     */
    const reflow = () => {
      show();
      // 吸附态不跨页也不跨刷新（R28 站主定的「不记住」）
      setDock(false);
      setFold(prefFold());
    };
    reflow();
    document.addEventListener('astro:after-swap', reflow);
    // 转屏／改窗口大小：贴边的位置按存下来的比例重算，两个跑马灯与余量也重判一次
    addEventListener('resize', () => {
      applyPos();
      marquee();
      marqueeLine();
      room();
    });
  }
</script>
