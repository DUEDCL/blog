---
import { SITE_TITLE, SOCIAL } from '../consts';

const year = new Date().getFullYear();

// 归档与标签不进顶栏（顶栏只放栏目），入口在首页与这里
const indexLinks = [
  { label: '归档', href: '/archive' },
  { label: '标签', href: '/tags' },
];

// 只渲染填了值的社交链接
const links = [
  { key: 'github', label: 'GitHub', href: SOCIAL.github },
  { key: 'email', label: '邮箱', href: SOCIAL.email ? `mailto:${SOCIAL.email}` : '' },
  { key: 'x', label: 'X', href: SOCIAL.x },
  { key: 'weibo', label: '微博', href: SOCIAL.weibo },
  { key: 'zhihu', label: '知乎', href: SOCIAL.zhihu },
  { key: 'rss', label: 'RSS', href: SOCIAL.rss },
].filter((l) => l.href);
---

<footer class="site-footer">
  <div class="wrap">
    <div class="foot glass">
      <p class="meta">© {year} {SITE_TITLE}</p>

      {/* 两组链接并排靠右：站内索引在前，站外社交在后。
          分成两个 ul 是语义上的分组，视觉上仍是一行胶囊文字 */}
      <div class="foot__groups">
        <ul class="links">
          {indexLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>

        <ul class="links">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  rel={l.key === 'rss' || l.key === 'email' ? undefined : 'me noopener'}
                  target={l.href.startsWith('http') ? '_blank' : undefined}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--sp-32);
    padding-block: var(--sp-8);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding: var(--sp-5) var(--sp-8);
    border-radius: var(--r-full);
  }

  /* 两组链接之间留一道比组内更宽的空隙，读起来是「站内 / 站外」两簇 */
  .foot__groups {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-8);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .links a:hover {
    color: var(--seal);
  }

  @media (max-width: 40rem) {
    .foot {
      /* 窄屏会换行成两行，胶囊形状会变得很怪，改回大圆角矩形 */
      padding: var(--sp-6);
      border-radius: var(--r-lg);
    }
  }
</style>
