---
import { SITE_TITLE, SOCIAL } from '../consts';
import { localeOf, localePath, t } from '../i18n';

interface Props {
  /**
   * 版权行右边那句随页面走的话。只有需要的页面才传 —— `/music` 的
   * 「听一点音乐吧，让时间慢下来。」原来是页面顶部的一张页头卡，
   * 但那一页的标题本来就是转盘自己，卡片只是把转盘往下推，于是这句话搬到了这儿。
   * R19 起文章／随笔／作品／摄影四页也各有一句，同样是从页头卡搬下来的
   * （四句写在 `i18n/*.ts` 的 sections.*.note 里，五句合起来是一组）。
   */
  note?: string;
}

const { note } = Astro.props;

const year = new Date().getFullYear();

const locale = localeOf(Astro.url.pathname);
const strings = t(locale);

// 归档与标签不进顶栏（顶栏放栏目 + 音乐），入口在首页与这里。
// 启动页也挂在这里 —— 页脚每页都有，是「进站后还能回去再看一眼」最直接的解法（R12）。
// R14 阶段⑥ 起它的地址是 '/'：那一页搬去了根路径，正站首页搬到了 /home。
// 三条都过 localePath：英文页的页脚点「Archive」不该掉回中文归档（R46）。
const indexLinks = [
  { label: strings.common.footArchive, href: localePath(locale, '/archive') },
  { label: strings.common.footTags, href: localePath(locale, '/tags') },
  { label: strings.common.footPortal, href: localePath(locale, '/') },
];

// 只渲染填了值的社交链接。这些都是站外地址（RSS 除外），不加语言前缀
const links = [
  { key: 'github', label: 'GitHub', href: SOCIAL.github },
  {
    key: 'email',
    label: strings.common.email,
    href: SOCIAL.email ? `mailto:${SOCIAL.email}` : '',
  },
  { key: 'x', label: 'X', href: SOCIAL.x },
  { key: 'weibo', label: strings.common.weibo, href: SOCIAL.weibo },
  { key: 'zhihu', label: strings.common.zhihu, href: SOCIAL.zhihu },
  /* 订阅源按语言分开：英文页的 RSS 指 /en/rss.xml，拿到的是译过的标题与摘要 */
  { key: 'rss', label: 'RSS', href: SOCIAL.rss ? localePath(locale, SOCIAL.rss) : '' },
].filter((l) => l.href);
---

<footer class="site-footer">
  <div class="wrap wrap--broad">
    {/* R44 起页脚是**报尾**：一道细线 + 两簇小字，不再是那枚跟顶栏几乎一样的
        圆角玻璃药丸（渲染实测：一页的头和尾长得一模一样，读不出「到底了」）。 */}
    <div class="hairline"></div>

    <div class="foot">
      {/* 左簇：版权 + 那句随页面走的话。包一层是为了让 space-between 仍然只分
          「左簇 / 右簇链接」两段 —— 直接把 note 作为第三个 flex 项会把链接挤到中间 */}
      <div class="foot__brand">
        <p class="meta">© {year} {SITE_TITLE}</p>
        {note && <p class="foot__note">{note}</p>}
      </div>

      {/* 两组链接并排靠右：站内索引在前，站外社交在后。
          分成两个 ul 是语义上的分组，视觉上仍是一行胶囊文字 */}
      <div class="foot__groups">
        <ul class="links">
          {indexLinks.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>

        <ul class="links">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  rel={l.key === 'rss' || l.key === 'email' ? undefined : 'me noopener'}
                  target={l.href.startsWith('http') ? '_blank' : undefined}
                >
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</footer>

<style>
  /* 上一版是 --sp-32（8rem）。纸面语汇下不需要那么大的一段空 —— 内容与报尾之间
     隔一道线就够，8rem 会让长页面结尾处露出一大片空白（渲染实测） */
  .site-footer {
    margin-top: var(--sp-16);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    padding-block: var(--sp-5);
  }

  .foot__brand {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-2) var(--sp-4);
    min-width: 0;
  }

  .foot__note {
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  /* 两组链接之间留一道比组内更宽的空隙，读起来是「站内 / 站外」两簇 */
  .foot__groups {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-8);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .links a:hover {
    color: var(--seal);
  }

  @media (max-width: 40rem) {
    .foot {
      /* 窄屏两簇各占一行，左对齐读起来才是「两段」而不是「两端」 */
      align-items: flex-start;
      flex-direction: column;
      gap: var(--sp-4);
    }
  }
</style>
