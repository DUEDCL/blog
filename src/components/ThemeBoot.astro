---
/**
 * 首屏定妆：在样式生效之前把 `<html>` 上那两个属性定下来。
 *   - data-js：有 JS 就打开渐进增强的那一半（/music 靠它决定露唱片机还是原生 <audio>）
 *   - data-theme：唯一配色「门」（portal）
 *
 * 版次切换器已移除，这里不再读写 localStorage；data-theme 仍然写上，
 * 因为 themes.css / global.css 的选择器按它取色。
 *
 * 刻意不看 `prefers-color-scheme`：门只有一套深色纸墨，没有明暗两档。
 *
 * 单独抽成组件、而不是在两个地方各写一份，是因为 Astro 的 SPA 导航按
 * **脚本 textContent 逐字去重**（`deselectScripts` → `detectScriptExecuted`）：
 * 只有两处一模一样，才会被认成同一段脚本、全站只跑一次、只挂一个监听。
 * 两份手抄的副本一旦有一个字符不同，就会各跑一次、各挂一个 `astro:after-swap`。
 * 抽成组件之后「一模一样」由构建保证，不靠人盯。
 *
 * 用它的有两处，都必须有：
 *   - BaseHead.astro —— 正站所有页面。
 *   - pages/index.astro（起始页）—— 它不走 BaseLayout。R14 阶段⑥ 之后它是根路径，
 *     也就是**最常见的首屏**；少了这一份，从门里进正站时属性要等新页脚本跑起来才补上。
 *     门自己不引 themes.css（那一页是一幅有视频的幕布，近黑是它的本体），所以
 *     data-theme 落在它的 <html> 上没有任何 CSS 规则会匹配 —— 写上是无害的，
 *     而且必须写：SPA 去重要求两处逐字相同。
 *
 * 为什么还要 `astro:after-swap` 那一半：换页时 Astro 用**新文档的 `<html>` 属性**
 * 覆盖当前的（`swapRootAttributes` 先把现有属性全删再套新的），而这两个属性是运行期
 * 写上去的、静态产物里没有，所以每次 swap 都会丢。after-swap 在换页后、paint 之前触发，
 * 在那儿重设不会闪。
 */
---

<script is:inline>
  (function () {
    /* 只剩「门」这一套配色，不再读写 localStorage，也不再有切换器。
       data-theme 仍然写上：themes.css / global.css 的选择器按它取色。 */
    function bar(el) {
      try {
        var c = getComputedStyle(el).getPropertyValue('--theme-color').trim();
        var m = document.querySelector('meta[name="theme-color"]');
        if (c && m) m.setAttribute('content', c);
      } catch (e) {}
    }

    function paint() {
      var el = document.documentElement;
      el.dataset.js = '1';
      el.dataset.theme = 'portal';
      bar(el);
      requestAnimationFrame(function () {
        bar(el);
      });
    }

    paint();
    document.addEventListener('astro:after-swap', paint);
  })();
</script>
