---
import { Image } from 'astro:assets';
import { SITE_TITLE, NAV } from '../consts';
import ThemeSwitch from './ThemeSwitch.astro';
import avatar from '../assets/avatar.jpg';

const path = Astro.url.pathname;

/** 栏目页匹配前缀。首页那项（R14 阶段⑥ 起是 '/home'）被下面的 nav 滤掉，走不到这里 */
function isCurrent(href: string) {
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header" id="site-header">
  {/* R44 起顶栏是**通栏的一条**，不再是浮在版心里的圆角药丸。
      三个理由，按重要程度排：
      ① 药丸的左边缘在 72rem 版心里，而首页刊名在 80rem 版心里 —— 渲染实测两者
         差 64px，顶栏看起来没跟内容对齐（那是「简陋」里最不容易指出来的一条）。
      ② 少一个大圆角。这一版全站只有浮层是圆角，顶栏虽然是浮层，但它是**页眉**，
         刊物的页眉是通栏的。
      ③ sticky 元素贴顶时药丸上下都有空隙，滚动内容会从缝里穿过去。
      玻璃底仍然要 —— 它得挡住从下面滚过来的内容。 */}
  <div class="bar glass">
    <div class="wrap wrap--broad bar__inner">
      {/* 品牌位是两个独立链接，不是一个：头像 → 名片页，站名 → 首页（R12）。
          R29 起「名片」在 NAV 里也有一项，所以头像不再是那一页唯一的入口；
          但站名必须自己承担回首页 —— 合成一个 <a> 就等于顶栏没有回首页的入口
          （下面那段 nav 把首页那项滤掉了）。
          R14 阶段⑥ 起首页是 /home（根路径让给了起始页），这里跟着改。 */}
      <div class="brand">
        <a class="brand__face" href="/about" aria-label={`${SITE_TITLE} 的名片`}>
          <Image
            src={avatar}
            alt=""
            width={72}
            height={72}
            loading="eager"
            class="brand__avatar"
          />
        </a>
        <a class="brand__home" href="/home" aria-label={`${SITE_TITLE} 首页`}>
          <span class="brand__name">{SITE_TITLE}</span>
        </a>
      </div>

      <nav class="nav" aria-label="主导航">
        {
          NAV.filter((item) => item.href !== '/home').map((item) => (
            <a
              href={item.href}
              class:list={['nav__link', { 'is-current': isCurrent(item.href) }]}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      {/* R44 把切换键加了回来（R31 砍掉浅色时连它一起删了）。位置在导航右侧 ——
          `.brand` 的 `margin-right: auto` 把导航推到右侧，这一枚跟在导航后面。 */}
      <ThemeSwitch />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* R44 去掉了 padding-block：通栏的页眉贴顶，上下不留缝。
       顶栏占位高度因此就是 .bar 的高度（3.5rem），global.css 的 --header-h
       与 --header-offset 依赖这个前提。 */
  }

  .bar {
    /* 通栏：只留底部一条线，左右上三条边去掉 —— 满宽元素画侧边框等于在视口边缘
       描一道竖线，那是「这里有个盒子」的信号，而页眉不是盒子 */
    border-radius: 0;
    border-inline: 0;
    border-top: 0;
    border-bottom: var(--rule-w) solid var(--rule-strong);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .bar__inner {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    height: 3.5rem;
  }

  /* 滚动后玻璃变实、底下垫一道投影。
     R44 删掉了 `transform: translateY(-8px)` 那个「贴顶收紧」—— 通栏页眉本来就
     贴着顶，没有可收紧的空隙，那段位移只会让整条抖一下（不携带信息，宪法第 4 条）。
     少了它，`.site-header` 的 border box 在两种状态下逐位相同，跨页过渡的
     `view-transition-name: site-header` 更不会插值出位移。 */
  .site-header.is-scrolled .bar {
    background-color: var(--glass-under);
    background-image: linear-gradient(var(--glass-bg-strong), var(--glass-bg-strong));
    box-shadow: 0 12px 32px -14px rgba(0, 0, 0, 0.5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    margin-right: auto;
    min-width: 0;
  }

  .brand a {
    text-decoration: none;
  }

  /* 头像那条链接自己是 flex，否则 <a> 的行内基线会在图下方留一道缝 */
  .brand__face {
    display: flex;
    flex-shrink: 0;
  }

  .brand__avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-full);
    object-fit: cover;
    flex-shrink: 0;
    /* 头像本身是纯黑底，加一圈受光描边才不像画面上的一个洞 */
    border: 1px solid var(--glass-border-lit);
    box-shadow: 0 2px 10px -2px rgba(0, 0, 0, 0.6);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1),
      box-shadow 0.3s ease;
  }

  .brand__face:hover .brand__avatar {
    transform: scale(1.06) rotate(-4deg);
    box-shadow: 0 4px 18px -4px var(--seal);
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    font-variation-settings: 'opsz' 14, 'SOFT' 0, 'WONK' 0;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .nav__link {
    position: relative;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    text-decoration: none;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--r-full);
    letter-spacing: 0.08em;
    white-space: nowrap;
    transition: color 0.18s ease, background-color 0.24s ease;
  }

  .nav__link:hover {
    color: var(--ink);
    background: var(--glass-bg);
  }

  /* 当前栏目：**去掉了玻璃药丸**（R44）。通栏页眉里那枚圆角药丸是整条唯一的
     圆角，渲染实测比导航本身更抢眼；报纸的做法是一道游标线。
     线用签名色、文字提到 --ink，两者一起说明「你在这一栏」。 */
  .nav__link.is-current {
    color: var(--ink);
  }

  /* 游标线用**签名色**而不是交互色：它回答的是「你在哪一栏」，不是「这里可以点」。
     全站黄铜=可点、朱红=刊物在标记，两者不混用。
     left/right 跟着 .nav__link 的内边距走，所以线与文字同宽 —— 固定宽度的短横线
     在「名片」（2 字）和「作品」（2 字）下等宽，但换成三字栏目就会偏短。 */
  .nav__link.is-current::after {
    content: '';
    position: absolute;
    left: var(--sp-3);
    right: var(--sp-3);
    bottom: 0.1rem;
    height: 2px;
    background: var(--press);
  }

  /* 窄屏：导航换到品牌下方，五项折成两行（3 + 2）。
     算过的账：320px 视口下 .nav 可用 238px（R10 真视口实测）／228px（本次同源 iframe 实测，
     少的 10px 是滚动条），而五项一行实测要 276px —— 两种量法都塞不下，四项时才刚好。
     所以 R12 加「图库」时必须折行。不走「一行 + 横向滚动」：没有蒙版提示的横滑等于隐藏交互，
     而蒙版本身已被 R10 删掉（纯 CSS 判断不了溢出，它会无条件啃掉首末项）。折行让五项全部可见。
     导航因此多占 44px，global.css 的窄屏 --header-offset 已同步重测为 12.25rem。 */
  @media (max-width: 46rem) {
    .bar__inner {
      height: auto;
      flex-wrap: wrap;
      padding-block: var(--sp-3);
      row-gap: var(--sp-2);
      gap: var(--sp-3);
    }

    .nav {
      order: 3;
      width: 100%;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-1);
    }

    .nav__link {
      text-align: center;
    }
  }
</style>

<script>
  /* 滚动后玻璃变实、玻璃条上移。rAF 节流，避免 scroll 里做布局读写。
     两个阈值形成回差：超过 ON 才加类，低于 OFF 才去类，中间地带保持原状。
     单阈值会自激 —— 类名切换本身会微调滚动位置，在阈值上来回穿越（踩过）。

     R14 阶段⑤ 起全站走 SPA 导航，这段拆成两半：
     - **scroll 监听留在模块顶层**，全站只加一次。放进 `astro:page-load` 会
       每导航累积一层，十次导航后一帧要跑十遍 sync。
     - 顶栏本身每次 swap 都是新节点，所以 `header` 引用要在
       `astro:page-load` 里重取；回差状态也按新页的滚动位置重新定档，
       否则可能带着上一页的 `scrolled = true` 落在中间地带，
       新顶栏没有类名却以为已经加过，直到再次越过 ON 才修正。 */
  const ON = 12;
  const OFF = 4;
  let header: HTMLElement | null = null;
  let scrolled = false;
  let ticking = false;

  const sync = () => {
    ticking = false;
    if (!header) return;
    const y = window.scrollY;
    if (!scrolled && y > ON) scrolled = true;
    else if (scrolled && y < OFF) scrolled = false;
    // force 与现状相同时 toggle 不改 DOM，所以每帧调也不产生写入
    header.classList.toggle('is-scrolled', scrolled);
  };

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(sync);
      }
    },
    { passive: true }
  );

  document.addEventListener('astro:page-load', () => {
    header = document.getElementById('site-header');
    scrolled = window.scrollY > ON;
    sync();
  });
</script>
