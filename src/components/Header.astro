---
import { Image } from 'astro:assets';
import { SITE_TITLE, NAV } from '../consts';
import LangSwitch from './LangSwitch.astro';
import { localeOf, localePath, t } from '../i18n';
import avatar from '../assets/avatar.jpg';

const path = Astro.url.pathname;
const locale = localeOf(path);
const strings = t(locale);

/* 六项：地址加上当前语言的前缀，标签取当前语言那一份。首页那项（R14 阶段⑥ 起是
   '/home'）在这里就滤掉了 —— 站名自己承担回首页。 */
const items = NAV.filter((item) => item.key !== 'home').map((item) => ({
  href: localePath(locale, item.href),
  label: strings.nav[item.key],
}));

const homeHref = localePath(locale, '/home');
const aboutHref = localePath(locale, '/about');

/** 栏目页匹配前缀。比较的是**带语言前缀**的地址，所以英文页不会把中文那栏点亮 */
function isCurrent(href: string) {
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header" id="site-header">
  {/* R44 起顶栏是**通栏的一条**，不再是浮在版心里的圆角药丸。
      三个理由，按重要程度排：
      ① 药丸的左边缘在 72rem 版心里，而首页刊名在 80rem 版心里 —— 渲染实测两者
         差 64px，顶栏看起来没跟内容对齐（那是「简陋」里最不容易指出来的一条）。
      ② 少一个大圆角。这一版全站只有浮层是圆角，顶栏虽然是浮层，但它是**页眉**，
         刊物的页眉是通栏的。
      ③ sticky 元素贴顶时药丸上下都有空隙，滚动内容会从缝里穿过去。
      玻璃底仍然要 —— 它得挡住从下面滚过来的内容。 */}
  <div class="bar glass">
    <div class="wrap wrap--broad bar__inner">
      {/* 品牌位是两个独立链接，不是一个：头像 → 名片页，站名 → 首页（R12）。
          R29 起「名片」在 NAV 里也有一项，所以头像不再是那一页唯一的入口；
          但站名必须自己承担回首页 —— 合成一个 <a> 就等于顶栏没有回首页的入口
          （下面那段 nav 把首页那项滤掉了）。
          R14 阶段⑥ 起首页是 /home（根路径让给了起始页），这里跟着改。 */}
      <div class="brand">
        <a class="brand__face" href={aboutHref} aria-label={strings.common.brandCard(SITE_TITLE)}>
          <Image
            src={avatar}
            alt=""
            width={72}
            height={72}
            loading="eager"
            class="brand__avatar"
          />
        </a>
        <a class="brand__home" href={homeHref} aria-label={strings.common.brandHome(SITE_TITLE)}>
          <span class="brand__name">{SITE_TITLE}</span>
        </a>
      </div>

      <nav class="nav" aria-label={strings.common.mainNav}>
        {
          items.map((item) => (
            <a
              href={item.href}
              class:list={['nav__link', { 'is-current': isCurrent(item.href) }]}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      {/* 导航右侧只剩账号与语言两枚键。版次键已移除：全站只有「门」这一套配色，
          不再需要切换器。窄屏时它们与品牌同一行（导航折到下面整行）。 */}
      {/* 账号位（R: 站点登录式）。未登录显示「登录」，已登录显示昵称/账号。
          放这里而不是塞进 nav：nav 是页面导航，账号不是页面。
          样式复用 global.css 的 `.topkey`，与语言键同一套长相。 */}
      <a class="topkey acct" href="/login" data-acct title="账号">
        <span class="acct__dot" aria-hidden="true"></span>
        <span class="acct__text">登录</span>
      </a>
      <LangSwitch />
    </div>
  </div>
</header>

<script>
  /**
   * 顶栏账号位的状态。
   *
   * 站点是静态渲染的，服务端不知道登录态（会话在 cookie 里、由 Worker 判），
   * 所以这一格先渲染成「登录」，再由浏览器问一次 `/api/site/me` 改文案。
   *
   * **必须挂 `astro:page-load`**：全站走 ClientRouter，这个模块脚本只在首次执行一次，
   * 换页后的新 Header 节点没被绑过 —— 表现是「只有第一页显示昵称，导航后就变回登录」。
   */
  const paintAccount = () => {
    const el = document.querySelector<HTMLAnchorElement>('[data-acct]');
    if (!el) return;
    const text = el.querySelector('.acct__text');
    fetch('/api/site/me', { credentials: 'same-origin' })
      .then((r) => r.json())
      .then((d) => {
        const u = d && d.user;
        if (u) {
          el.classList.add('is-in');
          el.title = '已登录：' + (u.nick || u.account);
          if (text) text.textContent = u.nick || u.account;
        } else {
          el.classList.remove('is-in');
          el.title = '未登录，点这里登录';
          if (text) text.textContent = '登录';
        }
      })
      .catch(() => {
        /* 接口挂了就当未登录，不要因此把顶栏弄坏 */
      });
  };

  document.addEventListener('astro:page-load', paintAccount);
  if (document.readyState !== 'loading') paintAccount();
  else document.addEventListener('DOMContentLoaded', paintAccount);
</script>

<style>
  /* 账号位：一枚小圆点表示登录态（灰=未登录，朱红=已登录）+ 一段可能很长的名字 */
  .acct {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    max-width: 10rem;
  }

  .acct__dot {
    width: 0.42rem;
    height: 0.42rem;
    border-radius: 50%;
    background: var(--ink-faint);
    flex-shrink: 0;
    transition: background-color 0.2s ease;
  }

  .acct.is-in .acct__dot {
    background: var(--seal);
  }

  .acct__text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  @media (max-width: 40rem) {
    /* 窄屏三枚键一起挤：名字截短，圆点保留 —— 圆点才是「登没登录」的那个信号 */
    .acct {
      max-width: 4.8rem;
    }
  }
</style>

<style>
  .site-header {
    position: sticky;
    top: var(--sp-4);
    z-index: 50;
    padding-inline: var(--sp-4);
  }

  /* 悬浮玻璃胶囊。通栏改为 max 80rem 居中，四边留出环境光。 */
  .bar {
    max-width: var(--measure-broad);
    margin-inline: auto;
    border-radius: var(--r-full);
    border: var(--rule-w) solid var(--glass-border);
    transition: background-color 0.3s ease, box-shadow 0.3s ease,
      border-color 0.3s ease;
  }

  .bar__inner {
    display: flex;
    align-items: center;
    gap: var(--sp-5);
    height: 4rem;
    padding-inline: var(--sp-5);
  }

  /* 滚动后玻璃变实、底下垫一道投影。
     R44 删掉了 `transform: translateY(-8px)` 那个「贴顶收紧」—— 通栏页眉本来就
     贴着顶，没有可收紧的空隙，那段位移只会让整条抖一下（不携带信息，宪法第 4 条）。
     少了它，`.site-header` 的 border box 在两种状态下逐位相同，跨页过渡的
     `view-transition-name: site-header` 更不会插值出位移。 */
  .site-header.is-scrolled .bar {
    background-color: var(--glass-under);
    background-image: linear-gradient(var(--glass-bg-strong), var(--glass-bg-strong));
    border-color: var(--glass-border-lit);
    box-shadow: var(--shadow-glass), 0 18px 40px -24px rgba(0, 0, 0, 0.9);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    margin-right: auto;
    min-width: 0;
  }

  .brand a {
    text-decoration: none;
  }

  /* 头像那条链接自己是 flex，否则 <a> 的行内基线会在图下方留一道缝 */
  .brand__face {
    display: flex;
    flex-shrink: 0;
  }

  .brand__avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-full);
    object-fit: cover;
    flex-shrink: 0;
    /* 头像本身是纯黑底，加一圈受光描边才不像画面上的一个洞 */
    border: 1px solid var(--glass-border-lit);
    box-shadow: 0 2px 10px -2px rgba(0, 0, 0, 0.6);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1),
      box-shadow 0.3s ease;
  }

  .brand__face:hover .brand__avatar {
    transform: scale(1.06) rotate(-4deg);
    box-shadow: 0 4px 18px -4px var(--seal);
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .nav__link {
    position: relative;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--ink-soft);
    text-decoration: none;
    padding: 0.5rem 0.8rem;
    border: 1px solid transparent;
    border-radius: var(--r-full);
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: color 0.18s ease, background-color 0.24s ease,
      border-color 0.24s ease;
  }

  .nav__link:hover {
    color: var(--ink);
    background: var(--glass-bg);
    border-color: var(--glass-border);
  }

  /* 当前栏目：一枚玻璃药丸，与整条顶栏同一材质。 */
  .nav__link.is-current {
    color: var(--ink);
    background: var(--glass-bg-strong);
    border-color: var(--glass-border-lit);
  }

  /* 窄屏：导航换到品牌下方，访客七项折成两行（4 + 3）。
     算过的账（R12 那次是六项 3+3；加「工具」后改成 4 列）：
     320px 视口下 .nav 可用约 238px，中文两字项含内边距约 46px/格，4 列 = 184px，
     塞得下；英文 Tools/Work/Posts/Music 也都在一格里。日文「ギャラリー」偏长，
     但 4 列时第二行三项更松，不会比旧版 3 列的六项更挤。
     不走「一行 + 横向滚动」：没有蒙版提示的横滑等于隐藏交互。
     导航因此比两行 3+3 略矮一点，global.css 的窄屏 --header-offset 已按
     12.25rem 保留（误差一档 padding，锚点仍安全）。

     第一行的账（375px，可用 343px）：品牌 88 + 账号键 59 + 语言键 59 +
     两道 12px 间隙 = 230px；320px 那一档也还在 288px 以内。
     版次键已移除，这一行比上一版松。再往这一行加东西之前先重算这笔账。 */
  @media (max-width: 46rem) {
    .site-header {
      top: var(--sp-2);
      padding-inline: var(--sp-2);
    }

    .bar {
      border-radius: var(--r-lg);
    }

    .bar__inner {
      height: auto;
      flex-wrap: wrap;
      padding: var(--sp-3) var(--sp-4);
      row-gap: var(--sp-2);
      gap: var(--sp-3);
    }

    .nav {
      order: 3;
      width: 100%;
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--sp-1);
    }

    .nav__link {
      text-align: center;
    }
  }
</style>

<script>
  /* 滚动后玻璃变实、玻璃条上移。rAF 节流，避免 scroll 里做布局读写。
     两个阈值形成回差：超过 ON 才加类，低于 OFF 才去类，中间地带保持原状。
     单阈值会自激 —— 类名切换本身会微调滚动位置，在阈值上来回穿越（踩过）。

     R14 阶段⑤ 起全站走 SPA 导航，这段拆成两半：
     - **scroll 监听留在模块顶层**，全站只加一次。放进 `astro:page-load` 会
       每导航累积一层，十次导航后一帧要跑十遍 sync。
     - 顶栏本身每次 swap 都是新节点，所以 `header` 引用要在
       `astro:page-load` 里重取；回差状态也按新页的滚动位置重新定档，
       否则可能带着上一页的 `scrolled = true` 落在中间地带，
       新顶栏没有类名却以为已经加过，直到再次越过 ON 才修正。 */
  const ON = 12;
  const OFF = 4;
  let header: HTMLElement | null = null;
  let scrolled = false;
  let ticking = false;

  const sync = () => {
    ticking = false;
    if (!header) return;
    const y = window.scrollY;
    if (!scrolled && y > ON) scrolled = true;
    else if (scrolled && y < OFF) scrolled = false;
    // force 与现状相同时 toggle 不改 DOM，所以每帧调也不产生写入
    header.classList.toggle('is-scrolled', scrolled);
  };

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(sync);
      }
    },
    { passive: true }
  );

  document.addEventListener('astro:page-load', () => {
    header = document.getElementById('site-header');
    scrolled = window.scrollY > ON;
    sync();
  });
</script>
