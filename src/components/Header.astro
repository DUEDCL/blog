---
import { Image } from 'astro:assets';
import { SITE_TITLE, NAV } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import avatar from '../assets/avatar.jpg';

const path = Astro.url.pathname;

/** 首页只在完全相等时高亮，栏目页匹配前缀 */
function isCurrent(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header" id="site-header">
  <div class="wrap">
    <div class="bar glass">
      <a href="/" class="brand" aria-label={`${SITE_TITLE} 首页`}>
        <Image
          src={avatar}
          alt=""
          width={72}
          height={72}
          loading="eager"
          class="brand__avatar"
        />
        <span class="brand__name">{SITE_TITLE}</span>
      </a>

      <nav class="nav" aria-label="主导航">
        {
          NAV.filter((item) => item.href !== '/').map((item) => (
            <a
              href={item.href}
              class:list={['nav__link', { 'is-current': isCurrent(item.href) }]}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-block: var(--sp-4);
    /* 玻璃条上方留一点空隙，让它真的是「浮」着的 */
    transition: padding-block 0.3s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  .site-header.is-scrolled {
    padding-block: var(--sp-2);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    height: 3.5rem;
    padding-inline: var(--sp-4);
    border-radius: var(--r-full);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .site-header.is-scrolled .bar {
    background: var(--glass-bg-strong);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 12px 32px -10px rgba(0, 0, 0, 0.5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
    margin-right: auto;
    min-width: 0;
  }

  .brand__avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-full);
    object-fit: cover;
    flex-shrink: 0;
    /* 头像本身是纯黑底，加一圈受光描边才不像画面上的一个洞 */
    border: 1px solid var(--glass-border-lit);
    box-shadow: 0 2px 10px -2px rgba(0, 0, 0, 0.6);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1),
      box-shadow 0.3s ease;
  }

  .brand:hover .brand__avatar {
    transform: scale(1.06) rotate(-4deg);
    box-shadow: 0 4px 18px -4px var(--seal);
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    font-variation-settings: 'opsz' 14, 'SOFT' 0, 'WONK' 0;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .nav__link {
    position: relative;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    text-decoration: none;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--r-full);
    letter-spacing: 0.08em;
    white-space: nowrap;
    transition: color 0.18s ease, background-color 0.24s ease;
  }

  .nav__link:hover {
    color: var(--ink);
    background: var(--glass-bg);
  }

  /* 当前栏目：一枚更亮的玻璃药丸，比下划线更贴合整体语言 */
  .nav__link.is-current {
    color: var(--ink);
    background: var(--glass-bg-strong);
    box-shadow: inset 0 0 0 1px var(--glass-border-lit);
  }

  .nav__link.is-current::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.15rem;
    width: 0.75rem;
    height: 2px;
    border-radius: 2px;
    background: var(--seal);
    transform: translateX(-50%);
  }

  /* 窄屏：导航换到品牌下方，横向可滚动（六个栏目放得下，不做汉堡菜单） */
  @media (max-width: 46rem) {
    .bar {
      height: auto;
      flex-wrap: wrap;
      padding: var(--sp-3) var(--sp-4);
      border-radius: var(--r-lg);
      row-gap: var(--sp-2);
    }

    .nav {
      order: 3;
      width: 100%;
      gap: var(--sp-1);
      overflow-x: auto;
      scrollbar-width: none;
      /* 边缘淡出，暗示还能滑 */
      mask-image: linear-gradient(90deg, transparent, #000 1.5rem, #000 calc(100% - 1.5rem), transparent);
    }

    .nav::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<script>
  /* 滚动后玻璃变实、上下留白收紧。rAF 节流，避免 scroll 里做布局读写 */
  const header = document.getElementById('site-header');
  if (header) {
    let ticking = false;
    const sync = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(sync);
        }
      },
      { passive: true }
    );
    sync();
  }
</script>
