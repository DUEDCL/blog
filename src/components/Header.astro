---
import { Image } from 'astro:assets';
import { SITE_TITLE, NAV } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import avatar from '../assets/avatar.jpg';

const path = Astro.url.pathname;

/** 栏目页匹配前缀。首页那项（R14 阶段⑥ 起是 '/home'）被下面的 nav 滤掉，走不到这里 */
function isCurrent(href: string) {
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header" id="site-header">
  <div class="wrap">
    <div class="bar glass">
      {/* 品牌位是两个独立链接，不是一个：头像 → 关于，站名 → 首页（R12）。
          「关于」从 NAV 摘掉后，头像是它唯一的入口；而下面那段 nav 又把首页那项滤掉了，
          所以站名必须自己承担回首页 —— 合成一个 <a> 就等于顶栏没有回首页的入口。
          R14 阶段⑥ 起首页是 /home（根路径让给了起始页），这里跟着改。 */}
      <div class="brand">
        <a class="brand__face" href="/about" aria-label={`关于 ${SITE_TITLE}`}>
          <Image
            src={avatar}
            alt=""
            width={72}
            height={72}
            loading="eager"
            class="brand__avatar"
          />
        </a>
        <a class="brand__home" href="/home" aria-label={`${SITE_TITLE} 首页`}>
          <span class="brand__name">{SITE_TITLE}</span>
        </a>
      </div>

      <nav class="nav" aria-label="主导航">
        {
          NAV.filter((item) => item.href !== '/home').map((item) => (
            <a
              href={item.href}
              class:list={['nav__link', { 'is-current': isCurrent(item.href) }]}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* 玻璃条上方留一点空隙，让它真的是「浮」着的。
       这个值必须恒定 —— 它参与布局，动画它会让整页每帧重排、把下方内容上下推，
       在阈值附近表现为可见的抖动（踩过）。收紧观感改由 .bar 的 transform 实现。
       顶栏占位高度恒为 --header-h，global.css 的 --header-offset 依赖这个前提。 */
    padding-block: var(--sp-4);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    height: 3.5rem;
    padding-inline: var(--sp-4);
    border-radius: var(--r-full);
    transition: background-color 0.3s ease, box-shadow 0.3s ease,
      transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  /* 位移只走合成层，不触发重排，视觉上仍是「贴顶后收紧」 */
  .site-header.is-scrolled .bar {
    transform: translateY(calc(var(--sp-2) * -1));
    background: var(--glass-bg-strong);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 12px 32px -10px rgba(0, 0, 0, 0.5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    margin-right: auto;
    min-width: 0;
  }

  .brand a {
    text-decoration: none;
  }

  /* 头像那条链接自己是 flex，否则 <a> 的行内基线会在图下方留一道缝 */
  .brand__face {
    display: flex;
    flex-shrink: 0;
  }

  .brand__avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-full);
    object-fit: cover;
    flex-shrink: 0;
    /* 头像本身是纯黑底，加一圈受光描边才不像画面上的一个洞 */
    border: 1px solid var(--glass-border-lit);
    box-shadow: 0 2px 10px -2px rgba(0, 0, 0, 0.6);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1),
      box-shadow 0.3s ease;
  }

  .brand__face:hover .brand__avatar {
    transform: scale(1.06) rotate(-4deg);
    box-shadow: 0 4px 18px -4px var(--seal);
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    font-variation-settings: 'opsz' 14, 'SOFT' 0, 'WONK' 0;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .nav__link {
    position: relative;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    text-decoration: none;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--r-full);
    letter-spacing: 0.08em;
    white-space: nowrap;
    transition: color 0.18s ease, background-color 0.24s ease;
  }

  .nav__link:hover {
    color: var(--ink);
    background: var(--glass-bg);
  }

  /* 当前栏目：一枚更亮的玻璃药丸，比下划线更贴合整体语言 */
  .nav__link.is-current {
    color: var(--ink);
    background: var(--glass-bg-strong);
    box-shadow: inset 0 0 0 1px var(--glass-border-lit);
  }

  .nav__link.is-current::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.15rem;
    width: 0.75rem;
    height: 2px;
    border-radius: 2px;
    background: var(--seal);
    transform: translateX(-50%);
  }

  /* 窄屏：导航换到品牌下方，五项折成两行（3 + 2）。
     算过的账：320px 视口下 .nav 可用 238px（R10 真视口实测）／228px（本次同源 iframe 实测，
     少的 10px 是滚动条），而五项一行实测要 276px —— 两种量法都塞不下，四项时才刚好。
     所以 R12 加「图库」时必须折行。不走「一行 + 横向滚动」：没有蒙版提示的横滑等于隐藏交互，
     而蒙版本身已被 R10 删掉（纯 CSS 判断不了溢出，它会无条件啃掉首末项）。折行让五项全部可见。
     导航因此多占 44px，global.css 的窄屏 --header-offset 已同步重测为 12.25rem。 */
  @media (max-width: 46rem) {
    .bar {
      height: auto;
      flex-wrap: wrap;
      padding: var(--sp-3) var(--sp-4);
      border-radius: var(--r-lg);
      row-gap: var(--sp-2);
    }

    .nav {
      order: 3;
      width: 100%;
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--sp-1);
    }

    .nav__link {
      text-align: center;
    }
  }
</style>

<script>
  /* 滚动后玻璃变实、玻璃条上移。rAF 节流，避免 scroll 里做布局读写。
     两个阈值形成回差：超过 ON 才加类，低于 OFF 才去类，中间地带保持原状。
     单阈值会自激 —— 类名切换本身会微调滚动位置，在阈值上来回穿越（踩过）。

     R14 阶段⑤ 起全站走 SPA 导航，这段拆成两半：
     - **scroll 监听留在模块顶层**，全站只加一次。放进 `astro:page-load` 会
       每导航累积一层，十次导航后一帧要跑十遍 sync。
     - 顶栏本身每次 swap 都是新节点，所以 `header` 引用要在
       `astro:page-load` 里重取；回差状态也按新页的滚动位置重新定档，
       否则可能带着上一页的 `scrolled = true` 落在中间地带，
       新顶栏没有类名却以为已经加过，直到再次越过 ON 才修正。 */
  const ON = 12;
  const OFF = 4;
  let header: HTMLElement | null = null;
  let scrolled = false;
  let ticking = false;

  const sync = () => {
    ticking = false;
    if (!header) return;
    const y = window.scrollY;
    if (!scrolled && y > ON) scrolled = true;
    else if (scrolled && y < OFF) scrolled = false;
    // force 与现状相同时 toggle 不改 DOM，所以每帧调也不产生写入
    header.classList.toggle('is-scrolled', scrolled);
  };

  window.addEventListener(
    'scroll',
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(sync);
      }
    },
    { passive: true }
  );

  document.addEventListener('astro:page-load', () => {
    header = document.getElementById('site-header');
    scrolled = window.scrollY > ON;
    sync();
  });
</script>
