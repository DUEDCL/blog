---
import { Image } from 'astro:assets';
import { SITE_TITLE, NAV } from '../consts';
import ThemeToggle from './ThemeToggle.astro';
import avatar from '../assets/avatar.jpg';

const path = Astro.url.pathname;

/** 首页只在完全相等时高亮，栏目页匹配前缀 */
function isCurrent(href: string) {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(`${href}/`);
}
---

<header class="site-header" id="site-header">
  <div class="wrap">
    <div class="bar glass">
      <a href="/" class="brand" aria-label={`${SITE_TITLE} 首页`}>
        <Image
          src={avatar}
          alt=""
          width={72}
          height={72}
          loading="eager"
          class="brand__avatar"
        />
        <span class="brand__name">{SITE_TITLE}</span>
      </a>

      <nav class="nav" aria-label="主导航">
        {
          NAV.filter((item) => item.href !== '/').map((item) => (
            <a
              href={item.href}
              class:list={['nav__link', { 'is-current': isCurrent(item.href) }]}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>

      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    /* 玻璃条上方留一点空隙，让它真的是「浮」着的。
       这个值必须恒定 —— 它参与布局，动画它会让整页每帧重排、把下方内容上下推，
       在阈值附近表现为可见的抖动（踩过）。收紧观感改由 .bar 的 transform 实现。
       顶栏占位高度恒为 --header-h，global.css 的 --header-offset 依赖这个前提。 */
    padding-block: var(--sp-4);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    height: 3.5rem;
    padding-inline: var(--sp-4);
    border-radius: var(--r-full);
    transition: background-color 0.3s ease, box-shadow 0.3s ease,
      transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1);
  }

  /* 位移只走合成层，不触发重排，视觉上仍是「贴顶后收紧」 */
  .site-header.is-scrolled .bar {
    transform: translateY(calc(var(--sp-2) * -1));
    background: var(--glass-bg-strong);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.08),
      0 12px 32px -10px rgba(0, 0, 0, 0.5);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-3);
    text-decoration: none;
    margin-right: auto;
    min-width: 0;
  }

  .brand__avatar {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: var(--r-full);
    object-fit: cover;
    flex-shrink: 0;
    /* 头像本身是纯黑底，加一圈受光描边才不像画面上的一个洞 */
    border: 1px solid var(--glass-border-lit);
    box-shadow: 0 2px 10px -2px rgba(0, 0, 0, 0.6);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.3, 1),
      box-shadow 0.3s ease;
  }

  .brand:hover .brand__avatar {
    transform: scale(1.06) rotate(-4deg);
    box-shadow: 0 4px 18px -4px var(--seal);
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 600;
    font-variation-settings: 'opsz' 14, 'SOFT' 0, 'WONK' 0;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--sp-1);
  }

  .nav__link {
    position: relative;
    font-size: var(--text-sm);
    color: var(--ink-soft);
    text-decoration: none;
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--r-full);
    letter-spacing: 0.08em;
    white-space: nowrap;
    transition: color 0.18s ease, background-color 0.24s ease;
  }

  .nav__link:hover {
    color: var(--ink);
    background: var(--glass-bg);
  }

  /* 当前栏目：一枚更亮的玻璃药丸，比下划线更贴合整体语言 */
  .nav__link.is-current {
    color: var(--ink);
    background: var(--glass-bg-strong);
    box-shadow: inset 0 0 0 1px var(--glass-border-lit);
  }

  .nav__link.is-current::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0.15rem;
    width: 0.75rem;
    height: 2px;
    border-radius: 2px;
    background: var(--seal);
    transform: translateX(-50%);
  }

  /* 窄屏：导航换到品牌下方（四个栏目 320px 都放得下，不做汉堡菜单）。
     overflow-x 只是导航将来变长的兜底，不溢出时它什么也不做。 */
  @media (max-width: 46rem) {
    .bar {
      height: auto;
      flex-wrap: wrap;
      padding: var(--sp-3) var(--sp-4);
      border-radius: var(--r-lg);
      row-gap: var(--sp-2);
    }

    .nav {
      order: 3;
      width: 100%;
      gap: var(--sp-1);
      overflow-x: auto;
      scrollbar-width: none;
      /* 这里曾有一层边缘淡出蒙版（linear-gradient 左右各 1.5rem 透明）用来暗示还能滑。
         删掉了：栏目从六项收到四项后，320px 下 scrollWidth 也等于 clientWidth，
         永远不溢出，蒙版却照旧啃掉首项左边与末项右边各 24px —— 表现为「左边被吞」。
         真要做淡出，前提是先判断溢出，不值得为四项导航上这套机器。 */
    }

    .nav::-webkit-scrollbar {
      display: none;
    }
  }
</style>

<script>
  /* 滚动后玻璃变实、玻璃条上移。rAF 节流，避免 scroll 里做布局读写。
     两个阈值形成回差：超过 ON 才加类，低于 OFF 才去类，中间地带保持原状。
     单阈值会自激 —— 类名切换本身会微调滚动位置，在阈值上来回穿越（踩过）。 */
  const header = document.getElementById('site-header');
  if (header) {
    const ON = 12;
    const OFF = 4;
    let scrolled = false;
    let ticking = false;

    const sync = () => {
      const y = window.scrollY;
      if (!scrolled && y > ON) {
        scrolled = true;
        header.classList.add('is-scrolled');
      } else if (scrolled && y < OFF) {
        scrolled = false;
        header.classList.remove('is-scrolled');
      }
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(sync);
        }
      },
      { passive: true }
    );
    sync();
  }
</script>
