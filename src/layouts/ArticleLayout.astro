---
/**
 * 文章 / 随笔的详情页布局：窄栏长阅读。
 *
 * R44 去掉了页头那张圆角玻璃卡。理由与列表页同一条：一张卡把标题、摘要、日期、
 * 标签全装进去，读起来是「一个信息盒子」，而报纸的文章头是**排版**——
 * 栏目标识、标题、副题、署名行，靠字号与一道线分层，不靠边框围起来。
 * 标签也从玻璃药丸退成等宽小字：它们是关键词，不是按钮。
 */
import 'katex/dist/katex.min.css'; /* 自托管，不走 CDN */
import { Image } from 'astro:assets';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { tagHref, tagName } from '../utils/content';
import { localeOf, t } from '../i18n';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags?: string[];
  cover?: ImageMetadata;
  coverAlt?: string;
  /** 面包屑用：所属栏目。`href` 要带语言前缀 */
  section: { href: string; label: string };
  /**
   * 正文是中文原文、当前页面却是别的语言时传 true（R46）。
   * 那时署名行下面多一条提示 —— **不假装有译文**，也不因为没译就让这一页 404。
   */
  onlyOriginal?: boolean;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags = [],
  cover,
  coverAlt,
  section,
  onlyOriginal = false,
} = Astro.props;

const locale = localeOf(Astro.url.pathname);
const strings = t(locale);

/**
 * 「更新于 X」这一句**不能拼**：中文是「更新于 2026.08.16」，日文是
 * 「2026.08.16 更新」—— 前缀与后缀的位置随语言变。所以先把日期格式化成字符串，
 * 整句交给词条去拼（`i18n` 的 `article.updated`），这里只负责给它一个日期。
 * 也因此这一处不走 `FormattedDate` 组件：那个组件输出的是 `<time>` 节点，
 * 拼不进一句话里。
 */
const upd = updatedDate
  ? strings.date.short(
      updatedDate.getFullYear(),
      updatedDate.getMonth() + 1,
      updatedDate.getDate()
    )
  : '';
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  publishedAt={pubDate}
  image={cover?.src}
  width="prose"
>
  <article>
    <header class="head rise rise-1">
      <p class="meta crumbs">
        <a href={section.href}>{section.label}</a>
      </p>

      <h1 class="title">{title}</h1>

      <p class="dek">{description}</p>

      {/* 署名行：日期 + 关键词。一道细线把它与正文分开 —— 报纸里这条线的作用是
          「上面是关于这篇文章的，下面是文章本身」 */}
      <div class="byline">
        <div class="stamps meta">
          <FormattedDate date={pubDate} />
          {updatedDate && (
            <>
              <span class="sep" aria-hidden="true">/</span>
              <time datetime={updatedDate.toISOString()}>
                {strings.article.updated(upd)}
              </time>
            </>
          )}
        </div>

        {tags.length > 0 && (
          <ul class="tags">
            {tags.map((tag) => (
              <li>
                <a class="tag" href={tagHref(tag, locale)}>{tagName(tag, locale)}</a>
              </li>
            ))}
          </ul>
        )}
      </div>

      <div class="hairline"></div>

      {/* 正文没译时的实话（R46）。位置在细线**下面**、正文上面 ——
          它说明的是「下面这段是什么语言」，属于正文而不属于署名行 */}
      {onlyOriginal && <p class="original meta">{strings.article.onlyInChinese}</p>}
    </header>

    {cover && (
      <figure class="cover rise rise-2">
        <Image src={cover} alt={coverAlt ?? ''} widths={[480, 800, 1200]} loading="eager" />
      </figure>
    )}

    <div class="prose rise rise-3">
      <slot />
    </div>
  </article>

  <nav class="back">
    <a href={section.href}>{strings.article.backTo(section.label)}</a>
  </nav>
</BaseLayout>

<style>
  .head {
    padding-top: var(--sp-8);
  }

  .crumbs a {
    text-decoration: none;
    color: var(--ink-faint);
  }

  .crumbs a:hover {
    color: var(--seal);
  }

  /* 文章标题与首页头条同一档字号 —— 同一篇文章在两个地方出现，重量应该一样，
     否则点进来会觉得「怎么变小了」 */
  .title {
    margin-top: var(--sp-4);
    font-size: var(--text-headline);
    font-variation-settings: 'opsz' 48, 'SOFT' 0, 'WONK' 0;
    letter-spacing: -0.015em;
    line-height: 1.16;
  }

  .dek {
    margin-top: var(--sp-5);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    line-height: var(--leading-normal);
    color: var(--ink-soft);
  }

  .byline {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-3) var(--sp-6);
    margin-top: var(--sp-6);
  }

  .stamps {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
  }

  .sep {
    color: var(--rule-strong);
  }

  .hairline {
    margin-top: var(--sp-4);
  }

  /* 关键词退成等宽小字（上一版是玻璃药丸 + hover 换底色）。判据是它们**是什么**：
     关键词是索引入口，不是操作按钮，药丸给了它们不该有的重量。
     前面那个 `#` 是印刷品里标记关键词的做法，也让它们在一行里读得出边界 */
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.06em;
    color: var(--ink-faint);
    text-decoration: none;
    transition: color 0.18s ease;
  }

  .tag::before {
    content: '#';
    opacity: 0.55;
    margin-right: 0.15em;
  }

  .tag:hover {
    color: var(--seal);
  }

  .cover {
    margin: var(--sp-8) 0 0;
  }

  /* 图片也是直角了。全站只有浮层有圆角 —— 印刷品里的图是切成方的 */
  .cover :global(img) {
    border: var(--rule-w) solid var(--rule);
  }

  .prose {
    margin-top: var(--sp-8);
  }

  .back {
    margin-top: var(--sp-16);
    padding-top: var(--sp-6);
    border-top: var(--rule-w) solid var(--rule-strong);
  }

  .back a {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
    color: var(--ink-faint);
    transition: color 0.18s ease;
  }

  .back a:hover {
    color: var(--seal);
  }
</style>
