---
/* 全站基础布局：字体、全局样式、页头页脚都在这里注入一次。 */
import '@fontsource-variable/fraunces/standard.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  /** 版心宽度：常规 / 文章窄栏 / 摄影宽幅 */
  width?: 'page' | 'prose' | 'wide';
}

const { width = 'page', ...head } = Astro.props;

const wrapClass =
  width === 'prose' ? 'wrap wrap--prose' : width === 'wide' ? 'wrap wrap--wide' : 'wrap';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead {...head} />
  </head>
  <body>
    <a href="#main" class="skip-link">跳到主内容</a>
    <Header />
    <main id="main" class={wrapClass}>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style>
  main {
    padding-top: var(--sp-8);
  }

  .skip-link {
    position: absolute;
    left: var(--sp-4);
    top: var(--sp-4);
    z-index: 100;
    padding: var(--sp-2) var(--sp-4);
    background: var(--seal);
    color: var(--paper);
    font-size: var(--text-sm);
    text-decoration: none;
    border-radius: var(--r-full);
    transform: translateY(-200%);
    transition: transform 0.2s ease;
  }

  .skip-link:focus {
    transform: none;
  }

  @media (max-width: 40rem) {
    main {
      padding-top: var(--sp-4);
    }
  }
</style>
