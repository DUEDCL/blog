---
/* 全站基础布局：字体、全局样式、页头页脚都在这里注入一次。 */
import '@fontsource-variable/fraunces/standard.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
/* 版次色板要排在 global.css 前面 —— 顺序对 CSS 变量的解析没有影响
   （变量在使用处按计算值替换），但读代码的人应该先看到「有四套色板」这件事。
   themes.css 里的「版次例外」段依赖它自己内部的书写顺序，与这里无关。 */
import '../styles/themes.css';
import '../styles/global.css';
/* player.css 不在这里 —— 它由 MiniPlayer.astro 自己 import。
   起始页（门）不走这个布局，而 R22④ 要它也显示状态栏，样式于是跟着视图走。 */

import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MiniPlayer from '../components/MiniPlayer.astro';
import ChatDock from '../components/ChatDock.astro';
import { HTML_LANG, localeOf, t } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  /** 版心宽度：常规 / 文章窄栏 / 对开大版 / 摄影宽幅 */
  width?: 'page' | 'prose' | 'broad' | 'wide';
  /**
   * 透传给页脚版权行右边那句话。R19 起五个页面都传：/music 与四个栏目页
   * （栏目页那句原来是页头卡里的大字介绍，按需求搬到了这儿 —— 见 consts.ts 的 SECTIONS 注释）。
   */
  footerNote?: string;
  /**
   * 要不要全站顶栏（R43）。只有 `/admin` 传 false ——
   * 他要「把后台的顶栏直接替换为后台的功能栏」：那一页顶上那条本来是站点导航
   * （文章／随笔／作品／音乐／图库／名片），对着后台干活时那六项一个都用不上，
   * 而后台自己的五个分区反倒挤在它下面一层。换掉之后顶上那条就是功能栏，
   * **回站的入口由功能栏左边的品牌位承担**（不然后台成了个出不去的房间）。
   */
  siteHeader?: boolean;
}

const { width = 'page', footerNote, siteHeader = true, ...head } = Astro.props;

/* 语言从地址认（同 BaseHead）。这一处只用它写 `<html lang>` 与那条跳转链接的字，
   页头、页脚、播放器、对话框各自再认一遍 —— 它们都是独立组件，不从这里透传。 */
const locale = localeOf(Astro.url.pathname);
const strings = t(locale);

const wrapClass =
  width === 'prose'
    ? 'wrap wrap--prose'
    : width === 'broad'
      ? 'wrap wrap--broad'
      : width === 'wide'
        ? 'wrap wrap--wide'
        : 'wrap';
---

<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <BaseHead {...head} />
    {/* 全站 SPA 导航。它在这里的唯一理由是让音乐跨页面不断 ——
        ClientRouter **是按页注入的**，哪一页没有它，从那一页点出去就是整页刷新，
        音频跟着被杀掉。起始页不走这个布局，所以它自己那份 head 里也手工加了一个。 */}
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">{strings.common.skipToMain}</a>
    {siteHeader && <Header />}
    <main id="main" class={wrapClass}>
      <slot />
    </main>
    <Footer note={footerNote} />
    {/* 悬浮窗 + 全站唯一那个 <audio>。persist 的名字写在组件自己的根节点上
        （`transition:persist="jk"`）—— 同名才配对，跨不同布局也能接上 */}
    <MiniPlayer />
    {/* 「AI 版沉麟」的浮动入口（R6 阶段②）。同样 persist，所以换页时对话不断。
        起始页（门）不走这个布局，所以门上没有它 —— 那是刻意的，见组件顶部注释。 */}
    <ChatDock />
  </body>
</html>

<style>
  main {
    padding-top: var(--sp-8);
    /**
     * 页脚贴底的另一半（R41①）。body 是 flex 列（见 global.css 里 body 那段注释），
     * 剩余高度全部给 main —— 内容不满一屏时页脚被推到视口底边，满了就照旧往下走。
     *
     * `flex-basis: auto` 不能省：flex 项的默认 `flex-basis` 是 0%，只写 `flex-grow: 1`
     * 会让 main 的高度从零开始算，长内容页的 `min-height` 计算跟着变形。
     * `flex-shrink: 0` 是不让长内容被压缩（flex 项默认可收缩）。
     */
    flex: 1 0 auto;
  }

  .skip-link {
    position: absolute;
    left: var(--sp-4);
    top: var(--sp-4);
    z-index: 100;
    padding: var(--sp-2) var(--sp-4);
    background: var(--seal);
    color: var(--paper);
    font-size: var(--text-sm);
    text-decoration: none;
    border-radius: var(--r-full);
    transform: translateY(-200%);
    transition: transform 0.2s ease;
  }

  .skip-link:focus {
    transform: none;
  }

  @media (max-width: 40rem) {
    main {
      padding-top: var(--sp-4);
    }
  }
</style>
