---
/* 全站基础布局：字体、全局样式、页头页脚都在这里注入一次。 */
import '@fontsource-variable/fraunces/standard.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
/* player.css 不在这里 —— 它由 MiniPlayer.astro 自己 import。
   起始页（门）不走这个布局，而 R22④ 要它也显示状态栏，样式于是跟着视图走。 */

import { ClientRouter } from 'astro:transitions';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MiniPlayer from '../components/MiniPlayer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedAt?: Date;
  /** 版心宽度：常规 / 文章窄栏 / 摄影宽幅 */
  width?: 'page' | 'prose' | 'wide';
  /**
   * 透传给页脚版权行右边那句话。R19 起五个页面都传：/music 与四个栏目页
   * （栏目页那句原来是页头卡里的大字介绍，按需求搬到了这儿 —— 见 consts.ts 的 SECTIONS 注释）。
   */
  footerNote?: string;
}

const { width = 'page', footerNote, ...head } = Astro.props;

const wrapClass =
  width === 'prose' ? 'wrap wrap--prose' : width === 'wide' ? 'wrap wrap--wide' : 'wrap';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <BaseHead {...head} />
    {/* 全站 SPA 导航。它在这里的唯一理由是让音乐跨页面不断 ——
        ClientRouter **是按页注入的**，哪一页没有它，从那一页点出去就是整页刷新，
        音频跟着被杀掉。起始页不走这个布局，所以它自己那份 head 里也手工加了一个。 */}
    <ClientRouter />
  </head>
  <body>
    <a href="#main" class="skip-link">跳到主内容</a>
    <Header />
    <main id="main" class={wrapClass}>
      <slot />
    </main>
    <Footer note={footerNote} />
    {/* 悬浮窗 + 全站唯一那个 <audio>。persist 的名字写在组件自己的根节点上
        （`transition:persist="jk"`）—— 同名才配对，跨不同布局也能接上 */}
    <MiniPlayer />
  </body>
</html>

<style>
  main {
    padding-top: var(--sp-8);
  }

  .skip-link {
    position: absolute;
    left: var(--sp-4);
    top: var(--sp-4);
    z-index: 100;
    padding: var(--sp-2) var(--sp-4);
    background: var(--seal);
    color: var(--paper);
    font-size: var(--text-sm);
    text-decoration: none;
    border-radius: var(--r-full);
    transform: translateY(-200%);
    transition: transform 0.2s ease;
  }

  .skip-link:focus {
    transform: none;
  }

  @media (max-width: 40rem) {
    main {
      padding-top: var(--sp-4);
    }
  }
</style>
