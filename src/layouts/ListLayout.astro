---
/* 文章 / 随笔列表页的共用布局。 */
import BaseLayout from './BaseLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  title: string;
  description: string;
  empty: string;
  /** 路由前缀，如 /posts */
  base: string;
  items: CollectionEntry<'posts' | 'notes'>[];
}

const { title, description, empty, base, items } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <header class="head glass rise rise-1">
    <h1 class="head__title">{title}</h1>
    <p class="head__desc">{description}</p>
    <p class="head__count meta">共 {items.length} 篇</p>
  </header>

  {items.length > 0 ? (
    <ul class="entries glass rise rise-3">
      {items.map((item) => (
        <EntryCard
          href={`${base}/${item.id}`}
          title={item.data.title}
          pubDate={item.data.pubDate}
        />
      ))}
    </ul>
  ) : (
    <p class="empty glass">{empty}</p>
  )}
</BaseLayout>

<style>
  .head {
    padding: var(--sp-12);
    border-radius: var(--r-xl);
  }

  .head__title {
    font-size: var(--text-3xl);
    font-variation-settings: 'opsz' 40, 'SOFT' 0, 'WONK' 0;
    letter-spacing: -0.02em;
  }

  .head__desc {
    margin-top: var(--sp-4);
    max-width: 34rem;
    color: var(--ink-soft);
    font-size: var(--text-lg);
  }

  .head__count {
    margin-top: var(--sp-6);
  }

  .entries {
    list-style: none;
    margin: var(--sp-8) 0 0;
    padding: 0;
    overflow: hidden;
  }

  .empty {
    margin-top: var(--sp-8);
    padding: var(--sp-8);
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  @media (max-width: 52rem) {
    .head {
      padding: var(--sp-8);
    }

    .head__title {
      font-size: var(--text-2xl);
    }
  }
</style>
