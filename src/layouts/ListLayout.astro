---
/* 文章 / 随笔列表页的共用布局。 */
import BaseLayout from './BaseLayout.astro';
import EntryCard from '../components/EntryCard.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  title: string;
  description: string;
  /** 页脚版权行右边那句小字（见 consts.ts 的 SECTIONS 注释） */
  note: string;
  empty: string;
  /** 路由前缀，如 /posts */
  base: string;
  items: CollectionEntry<'posts' | 'notes'>[];
}

const { title, description, note, empty, base, items } = Astro.props;
---

<BaseLayout title={title} description={description} footerNote={note}>
  {/* R19 起页头卡只剩标题与计数：那段大字介绍（`.head__desc`）按需求整块删了，
      同一句话的位置移到页脚 —— 栏目页一进来先看到条目，不再先读一段自我说明。
      description 仍在 <BaseLayout> 上，那是 <meta>，不显示在页面上。 */}
  <header class="head glass rise rise-1">
    <h1 class="head__title">{title}</h1>
    <p class="head__count meta">共 {items.length} 篇</p>
  </header>

  {items.length > 0 ? (
    <ul class="entries glass rise rise-3">
      {items.map((item) => (
        <EntryCard
          href={`${base}/${item.id}`}
          title={item.data.title}
          pubDate={item.data.pubDate}
        />
      ))}
    </ul>
  ) : (
    <p class="empty glass">{empty}</p>
  )}
</BaseLayout>

<style>
  /* 只剩标题与计数两行了，竖向 padding 收一档 —— sp-12 是给三行内容留的高度，
     内容少了不收就是一张空荡荡的大卡片 */
  .head {
    padding: var(--sp-8) var(--sp-12);
    border-radius: var(--r-xl);
  }

  .head__title {
    font-size: var(--text-3xl);
    font-variation-settings: 'opsz' 40, 'SOFT' 0, 'WONK' 0;
    letter-spacing: -0.02em;
  }

  /* 原来隔着一段介绍，所以是 sp-6；现在紧跟标题，那么大的空隙会像漏了东西 */
  .head__count {
    margin-top: var(--sp-3);
  }

  .entries {
    list-style: none;
    margin: var(--sp-8) 0 0;
    padding: 0;
    overflow: hidden;
  }

  .empty {
    margin-top: var(--sp-8);
    padding: var(--sp-8);
    color: var(--ink-faint);
    font-size: var(--text-sm);
  }

  @media (max-width: 52rem) {
    .head {
      padding: var(--sp-8);
    }

    .head__title {
      font-size: var(--text-2xl);
    }
  }
</style>
